      all: flat.length,
      todo: flat.filter(x => !Store.getPoint(x.point.id).done).length,
      done: flat.filter(x => Store.getPoint(x.point.id).done).length,
      fav: flat.filter(x => Store.getPoint(x.point.id).fav).length,
