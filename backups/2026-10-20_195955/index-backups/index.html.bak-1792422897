  .sidebar{position:fixed;top:0;left:0;bottom:0;z-index:1000}
  .menu-toggle{display:flex}
  .main-tab span { display:none; }
  .main-tab { padding:6px 10px; }
  .study-secondary{padding:8px 12px;gap:8px;overflow-x:auto}
  .stats-bar{padding:8px 14px;gap:12px}
  .stat .v{font-size:15px}
  .point-row{padding:10px 12px}
  .point-title{font-size:15px}
  .point-desc{font-size:12.5px}
  .content{padding:14px}
  .plan-view{padding:20px 14px 50px}
  .plan-hero h1{font-size:24px;letter-spacing:3px}
  .daily-grid{grid-template-columns:repeat(2, 1fr)}
  .phase-header{flex-wrap:wrap;gap:10px}
