/* ═══════════════════════════════════════════════════════════════
   MODULE: DEEP DIVE
   ═══════════════════════════════════════════════════════════════ */
const DeepDive = {
  open(pointId) {
    if (!pointId) return;
    const p = getPoint(pointId);
    if (!p) return;
    if (!p.deepExplanation) {
      Utils.toast('Няма deep-dive за тази точка', 'alert-circle');
      return;
    }
    document.getElementById('ddId').textContent = 'POINT ' + pointId;
    document.getElementById('ddTitle').textContent = p.title;
    document.getElementById('ddMeta').innerHTML =
      `<span class="tag">${p.source}</span>` +
      (p.page ? `<span class="tag">стр. ${p.page}</span>` : '');
    document.getElementById('ddBody').innerHTML = this.md2html(p.deepExplanation);
    document.getElementById('deepdiveOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
    const body = document.getElementById('ddBody');
    body.scrollTop = 0;
    body.addEventListener('scroll', this._onScroll);
    // Reset mathDone маркер, за да може да се рендерира при повторно отваряне
    body.dataset.mathDone = '';
    // Директен KaTeX call (заобикаля MathRender.apply и неговите selector проблеми)
    setTimeout(() => {
      if (window.renderMathInElement) {
        try {
          window.renderMathInElement(body, {
            delimiters: [
              {left:'$$',right:'$$',display:true},
              {left:'$',right:'$',display:false},
              {left:'\\(',right:'\\)',display:false},
              {left:'\\[',right:'\\]',display:true},
            ],
            throwOnError: false,
            strict: false,
            ignoredClasses: ['katex'],
          });
        } catch(e) { console.error('[DeepDive KaTeX]', e); }
      }
    }, 50);
    Utils.refreshIcons();
  },

  close() {
    document.getElementById('deepdiveOverlay').classList.remove('open');
    // Възстанови overflow само ако и point modal-ът е затворен
    const modalOpen = document.getElementById('pointModal').classList.contains('open');
    document.body.style.overflow = modalOpen ? 'hidden' : '';
    document.getElementById('ddBody').removeEventListener('scroll', this._onScroll);
  },

  _onScroll() {
    const el = document.getElementById('ddBody');
    const pct = el.scrollTop / Math.max(1, el.scrollHeight - el.clientHeight) * 100;
    document.getElementById('ddProgress').style.width = (pct || 0) + '%';
  },

  md2html(md) {
    if (!md) return '';
    let html = String(md);
    // Escape HTML
    html = html.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    // Headers
    html = html.replace(/^### (.+)$/gm, '<h3>$1</h3>');
    html = html.replace(/^## (.+)$/gm, '<h2>$1</h2>');
    html = html.replace(/^# (.+)$/gm, '<h2>$1</h2>');
    // Bold / italic
    html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    html = html.replace(/(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)/g, '<em>$1</em>');
    // Inline code
    html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
    // Blockquote
    html = html.replace(/^&gt; (.+)$/gm, '<blockquote>$1</blockquote>');
    // Lists
    html = html.replace(/^- (.+)$/gm, '<li>$1</li>');
    // Групирай последователни <li> в един <ul>
    html = html.replace(/(?:<li>[\s\S]*?<\/li>\s*)+/g, (match) => '<ul>' + match + '</ul>');
    // Paragraphs
    const lines = html.split('\n');
    const out = [];
    let buf = [];
    const flush = () => {
      if (!buf.length) return;
      const text = buf.join(' ').trim();
      if (text) out.push('<p>' + text + '</p>');
      buf = [];
    };
    for (const line of lines) {
      if (/^\s*<(h[1-6]|ul|ol|li|blockquote|pre|hr|table)/.test(line) ||
          /^\s*<\/(ul|ol|blockquote|pre|table)/.test(line)) {
        flush();
        out.push(line);
      } else if (line.trim() === '') {
        flush();
      } else {
        buf.push(line);
      }
    }
    flush();
    return out.join('\n');
  },

  print() {
    const p = State.currentModalId ? getPoint(State.currentModalId) : null;
    if (!p || !p.deepExplanation) return;
    const w = window.open('', '_blank');
    w.document.write(`
      <!DOCTYPE html><html><head><meta charset="utf-8"><title>${Utils.escapeHtml(p.title)}</title>
      <style>body{font-family:Georgia,serif;max-width:800px;margin:40px auto;padding:0 20px;line-height:1.7;color:#111}
      h1{color:#006;border-bottom:2px solid #006;padding-bottom:8px}
      h2{color:#006;margin-top:32px;border-bottom:1px solid #ccc}
      code{background:#f4f4f4;padding:2px 5px;border-radius:3px}
      blockquote{border-left:3px solid #999;padding-left:12px;color:#555}</style>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
      </head><body>
      <h1>${Utils.escapeHtml(p.title)}</h1>
      ${this.md2html(p.deepExplanation)}
      <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"><\/script>
      <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"><\/script>
      <script>renderMathInElement(document.body,{delimiters:[{left:'$$',right:'$$',display:true},{left:'$',right:'$',display:false}]});<\/script>
      </body></html>
    `);
    w.document.close();
  },

  copy() {
    const p = State.currentModalId ? getPoint(State.currentModalId) : null;
    if (!p || !p.deepExplanation) return;
    navigator.clipboard.writeText(p.deepExplanation);
    Utils.toast('Копирано', 'copy');
  },
};

