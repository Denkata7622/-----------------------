        </div>
        <div>
          <div class="pm-label" style="margin-bottom:8px;">▸ Source problems (${solvedProblems}/${totalProblems})</div>
          <div style="display:flex;flex-direction:column;gap:4px;">
            ${task.source_problems.map(p => {
              const key = `T${task.num}:${p.id}`;
