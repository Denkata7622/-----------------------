.rep-list{margin-top:12px}
.rep-item{display:flex;gap:10px;align-items:center;padding:10px 12px;background:var(--surface-2);border:1px solid var(--border-2);border-radius:4px;margin-bottom:6px;cursor:pointer;font-size:13px;transition:all .15s}
