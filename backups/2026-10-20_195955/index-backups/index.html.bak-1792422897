/* ══════════════════════════════════════════════════════════════
   v6.1 — INTUITIVE UX
   ══════════════════════════════════════════════════════════════ */

/* 1. Кликваеми карти */
.point-row { cursor: pointer; transition: background .15s, transform .1s; position: relative; }
.point-row::after {
  content: "→"; position: absolute; right: 12px; top: 50%;
  transform: translateY(-50%) translateX(4px);
  color: var(--accent); opacity: 0; font-size: 14px;
  transition: all .2s; pointer-events: none;
}
.point-row:hover { background: linear-gradient(90deg, transparent, rgba(0,255,68,.04)); }
.point-row:hover::after { opacity: 0.7; transform: translateY(-50%) translateX(0); }
.point-row:hover .point-title { color: var(--accent); text-shadow: 0 0 6px var(--accent-glow); }
.point-row:active { transform: scale(0.995); }
.point:hover .point-actions .mini-btn { border-color: var(--border); }
.point:hover .point-actions .mini-btn:hover { border-color: var(--accent); color: var(--accent); box-shadow: 0 0 8px var(--accent-glow); }

/* 2. Today Hero */
.today-hero {
  display: flex; align-items: center; gap: 16px; padding: 12px 20px;
  background: linear-gradient(135deg, var(--surface), var(--surface-2));
  border-bottom: 1px solid var(--border);
  position: sticky; top: var(--topbar-h); z-index: 100; flex-wrap: wrap;
}
.today-hero.hidden { display: none; }
.hero-block { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.hero-block .hero-icon {
  width: 36px; height: 36px; border-radius: 50%;
  background: var(--surface-3); border: 1px solid var(--border-2);
  display: flex; align-items: center; justify-content: center; color: var(--accent);
}
.hero-block .hero-icon svg { width: 18px; height: 18px; }
.hero-block .hero-icon.fire { color: #ff8a00; filter: drop-shadow(0 0 8px rgba(255,138,0,.6)); }
.hero-block .hero-info { display: flex; flex-direction: column; line-height: 1.1; }
.hero-block .hero-val { color: var(--accent); font-size: 20px; text-shadow: 0 0 8px var(--accent-glow); letter-spacing: 1px; }
.hero-block .hero-val.live { animation: pulse-live 2s ease-in-out infinite; }
@keyframes pulse-live { 0%, 100% { opacity: 1; } 50% { opacity: 0.65; } }
.hero-block .hero-lbl { color: var(--text-3); font-size: 10px; letter-spacing: 2px; margin-top: 2px; }

.hero-goal { flex: 1; min-width: 200px; max-width: 500px; }
.hero-goal-info { display: flex; justify-content: space-between; font-size: 11px; color: var(--text-3); margin-bottom: 5px; letter-spacing: 1px; }
.hero-goal-info .pct { color: var(--accent); font-weight: bold; }
.hero-goal-track { height: 10px; background: var(--surface-4); border-radius: 5px; overflow: hidden; position: relative; box-shadow: inset 0 1px 3px rgba(0,0,0,.4); }
.hero-goal-fill {
  height: 100%; background: linear-gradient(90deg, var(--accent-2), var(--accent));
  transition: width .5s cubic-bezier(.4,0,.2,1);
  box-shadow: 0 0 12px var(--accent-glow); border-radius: 5px; position: relative;
}
.hero-goal-fill::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.2), transparent);
  opacity: 0;
}
.hero-goal-fill.done { background: linear-gradient(90deg, #4dff4d, #00ff44); box-shadow: 0 0 20px var(--accent-glow); }

.hero-quick { display: flex; gap: 4px; margin-left: auto; flex-shrink: 0; }
.hero-quick .q-btn {
  width: 36px; height: 36px; background: var(--surface-3);
  border: 1px solid var(--border-2); color: var(--text-2);
  cursor: pointer; border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
  transition: all .15s; position: relative;
}
.hero-quick .q-btn:hover { background: var(--accent); color: #000; border-color: var(--accent); box-shadow: 0 0 12px var(--accent-glow); transform: translateY(-2px); }
.hero-quick .q-btn svg { width: 16px; height: 16px; }
.hero-quick .q-btn .tooltip {
  position: absolute; bottom: calc(100% + 6px); left: 50%; transform: translateX(-50%);
  background: var(--surface); border: 1px solid var(--accent-2); color: var(--accent);
  padding: 4px 8px; border-radius: 3px; font-size: 11px; letter-spacing: 1px;
  white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity .15s;
}
.hero-quick .q-btn:hover .tooltip { opacity: 1; }

/* 3. Filter chips с броячи */
.chip { display: inline-flex; align-items: center; gap: 6px; }
.chip .chip-count {
  background: var(--surface-3); color: var(--text-3);
  padding: 1px 6px; border-radius: 8px; font-size: 10px;
  letter-spacing: 0; min-width: 18px; text-align: center; transition: all .15s;
}
.chip.active .chip-count { background: rgba(0,0,0,.25); color: #000; }
.chip:hover .chip-count { background: var(--surface-4); }

/* 4. First hint */
.first-hint {
  position: fixed; bottom: 24px; left: 50%;
  transform: translateX(-50%) translateY(80px);
  background: linear-gradient(135deg, var(--surface-2), var(--surface));
  border: 1px solid var(--accent); color: var(--text);
  padding: 14px 22px; border-radius: 8px; font-size: 13px; letter-spacing: 1px;
  box-shadow: 0 0 30px var(--accent-glow), 0 8px 20px rgba(0,0,0,.5);
  z-index: 4000; display: flex; align-items: center; gap: 12px;
  opacity: 0; transition: all .4s cubic-bezier(.4,0,.2,1);
  pointer-events: none; max-width: 90%;
}
.first-hint.show { transform: translateX(-50%) translateY(0); opacity: 1; pointer-events: auto; }
.first-hint svg { width: 18px; height: 18px; color: var(--accent); flex-shrink: 0; }
.first-hint .close-hint {
  background: transparent; border: 1px solid var(--border-2); color: var(--text-3);
  cursor: pointer; padding: 3px 8px; border-radius: 3px;
  font-family: inherit; font-size: 11px;
}
.first-hint .close-hint:hover { color: var(--accent); border-color: var(--accent); }

/* 5. Toast прогрес */
.toast .toast-progress {
  position: absolute; bottom: 0; left: 0; height: 2px;
  background: var(--accent); animation: toast-progress 1.8s linear forwards;
}
@keyframes toast-progress { from { width: 100%; } to { width: 0%; } }
.toast { overflow: hidden; }

/* 6. Pomodoro running dot */
.pomodoro.running::before {
  content: ""; position: absolute; top: 8px; right: 8px;
  width: 8px; height: 8px; border-radius: 50%;
  background: #ff4444; box-shadow: 0 0 8px #ff4444;
  animation: pulse-live 1.5s ease-in-out infinite;
}
.pomodoro { position: fixed; }

/* 7. Step header hint */
.step-header { position: relative; }
.step-header::after {
  content: "↓ expand"; position: absolute; right: 60px; top: 50%;
  transform: translateY(-50%); color: var(--text-3);
  font-size: 10px; letter-spacing: 1px; opacity: 0; transition: opacity .15s;
}
.step-header:hover::after { opacity: 0.6; }
.step.collapsed .step-header::after { content: "→ expand"; }
@media (max-width: 900px) { .step-header::after { display: none; } }

/* 8. Pomodoro ring */
.pomodoro .pomo-ring {
  width: 40px; height: 40px; border-radius: 50%;
  background: conic-gradient(var(--accent) var(--pomo-pct, 0%), var(--surface-4) 0);
  display: flex; align-items: center; justify-content: center;
  position: relative; flex-shrink: 0;
}
.pomodoro .pomo-ring::before { content: ""; position: absolute; inset: 4px; border-radius: 50%; background: var(--surface); }

/* 9. Empty state */
.empty { display: flex; flex-direction: column; align-items: center; gap: 12px; }
.empty .empty-hint { background: var(--surface-2); border: 1px dashed var(--border-2); padding: 8px 14px; border-radius: 5px; font-size: 12px; color: var(--text-3); }

/* 10. Responsive hero */
@media (max-width: 900px) {
  .today-hero { padding: 10px 14px; gap: 10px; }
  .hero-goal { flex-basis: 100%; order: 3; }
  .hero-quick { order: 2; }
  .hero-block .hero-val { font-size: 17px; }
  .hero-block .hero-icon { width: 30px; height: 30px; }
}
@media (max-width: 600px) {
  .hero-block .hero-info .hero-lbl { display: none; }
  .hero-quick .q-btn { width: 32px; height: 32px; }
}

/* ═══════════════════════════════════════════════════════════════
   CLICKABLE SIDEBAR (v6.2)
   ═══════════════════════════════════════════════════════════════ */
.goal-widget.clickable,
.calendar-widget.clickable {
  cursor: pointer;
  position: relative;
  padding-right: 22px;
  border-radius: 5px;
  transition: background .15s, border-color .15s;
}

.goal-widget.clickable:hover,
.calendar-widget.clickable:hover {
  background: var(--surface-3);
  border-color: var(--accent);
}

.click-hint {
  position: absolute;
  right: 6px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-3);
  opacity: 0;
  transition: opacity .15s, color .15s;
  display: flex;
  align-items: center;
}
.click-hint svg { width: 14px; height: 14px; }
.goal-widget.clickable:hover .click-hint,
.calendar-widget.clickable:hover .click-hint {
  opacity: 1;
  color: var(--accent);
}

/* ═══════════════════════════════════════════════════════════════
   PROGRESS MODAL (v6.2)
   ═══════════════════════════════════════════════════════════════ */
.prog-overlay {
  position: fixed; inset: 0;
