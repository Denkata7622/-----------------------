/* ═══════════════════════════════════════════════════════════════
   21. EXAM SIMULATOR
   ═══════════════════════════════════════════════════════════════ */
.exam-overlay{position:fixed;inset:0;background:rgba(0,0,0,.95);backdrop-filter:blur(8px);z-index:5450;display:none;align-items:center;justify-content:center;padding:16px}
.exam-overlay.open{display:flex}
.exam-box{width:100%;max-width:900px;max-height:95vh;background:var(--surface);border:1px solid var(--accent-2);border-radius:8px;padding:24px;overflow-y:auto;box-shadow:0 0 50px var(--accent-glow)}
.exam-box h2{color:var(--accent);font-size:20px;letter-spacing:2px;margin-bottom:6px;display:flex;align-items:center;gap:10px}
.exam-box h2 svg{width:20px;height:20px}
.exam-sub{color:var(--text-3);font-size:12px;margin-bottom:20px;letter-spacing:1px}
.exam-picker{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px;margin-bottom:20px}
.exam-pick{padding:12px;background:var(--surface-2);border:1px solid var(--border-2);border-radius:5px;cursor:pointer;text-align:left;color:var(--text-2);font-family:inherit;font-size:13px;transition:all .15s}
.exam-pick:hover{border-color:var(--accent);color:var(--accent);background:var(--surface-3)}
.exam-pick.selected{border-color:var(--accent);background:var(--accent-dim);color:var(--accent)}
.exam-pick .year{color:var(--accent);font-size:16px;display:block;margin-bottom:2px}
.exam-pick .grade{color:var(--text-3);font-size:11px;letter-spacing:1px}
.exam-timer{font-size:64px;color:var(--accent);text-align:center;letter-spacing:4px;text-shadow:0 0 20px var(--accent-glow);margin:20px 0;font-family:'JetBrains Mono',monospace}
.exam-timer.warn{color:var(--warn);text-shadow:0 0 20px rgba(221,255,0,.4)}
.exam-timer.danger{color:var(--danger);text-shadow:0 0 20px rgba(255,68,68,.5);animation:pulse 1s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
.exam-problems{display:grid;grid-template-columns:1fr;gap:8px;margin:16px 0}
.exam-prob{display:flex;gap:10px;align-items:center;padding:12px;background:var(--surface-2);border:1px solid var(--border-2);border-radius:5px}
.exam-prob .num{color:var(--accent);font-size:20px;min-width:30px}
.exam-prob .info{flex:1}
.exam-prob .topic{color:var(--text);font-size:14px}
.exam-prob .sub{color:var(--text-3);font-size:11px;margin-top:2px}
.exam-prob select{background:var(--surface);border:1px solid var(--border-2);color:var(--text);font-family:inherit;font-size:13px;padding:4px 8px;border-radius:3px;outline:none;cursor:pointer}
.exam-prob select:focus{border-color:var(--accent)}
.exam-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-top:20px}
.exam-btn{padding:12px 24px;background:transparent;border:2px solid var(--accent);color:var(--accent);font-family:inherit;font-size:14px;letter-spacing:1.5px;border-radius:5px;cursor:pointer;transition:all .15s;display:flex;align-items:center;gap:8px;text-decoration:none}
.exam-btn:hover{background:var(--accent);color:#000}
.exam-btn.danger{border-color:var(--danger);color:var(--danger)}
.exam-btn.danger:hover{background:var(--danger);color:#fff}
.exam-btn.ghost{border-color:var(--border-2);color:var(--text-3)}
.exam-btn.ghost:hover{background:var(--surface-3);color:var(--text-2)}
.exam-result{text-align:center;padding:20px}
.exam-result .total{font-size:56px;color:var(--accent);text-shadow:0 0 20px var(--accent-glow)}
.exam-result .lbl{color:var(--text-3);font-size:12px;letter-spacing:2px;margin-bottom:16px}
.exam-result .breakdown{display:flex;justify-content:center;gap:20px;margin-top:16px;flex-wrap:wrap}
.exam-result .bd{background:var(--surface-2);border:1px solid var(--border-2);border-radius:6px;padding:12px 18px;text-align:center}
.exam-result .bd .v{color:var(--accent-2);font-size:24px}
.exam-result .bd .k{color:var(--text-3);font-size:10px;letter-spacing:1.5px}

/* ═══════════════════════════════════════════════════════════════
   22. SPACED REPETITION
   ═══════════════════════════════════════════════════════════════ */
.rep-overlay{position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:5350;display:none;align-items:center;justify-content:center;padding:24px}
.rep-overlay.open{display:flex}
.rep-box{width:100%;max-width:860px;max-height:90vh;background:var(--surface);border:1px solid var(--accent-2);border-radius:8px;padding:24px;overflow-y:auto;box-shadow:0 0 40px var(--accent-glow)}
