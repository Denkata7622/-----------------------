.rep-stat{padding:14px;background:var(--surface-2);border:1px solid var(--border-2);border-radius:6px;text-align:center}
.rep-stat .v{color:var(--accent);font-size:28px;display:block}
.rep-stat .k{color:var(--text-3);font-size:10px;letter-spacing:1.5px;margin-top:4px}
.rep-stat.warn .v{color:var(--warn)}
