/* ═══════════════════════════════════════════════════════════════
   MODULE: SEARCH HISTORY
   ═══════════════════════════════════════════════════════════════ */
const SearchHistory = {
  key: 'olympiad_search_history',
  max: 8,
  get() { try { return JSON.parse(localStorage.getItem(this.key) || '[]'); } catch(e){ return []; } },
  add(q) {
    q = (q || '').trim();
    if (!q || q.length < 2) return;
    let h = this.get().filter(x => x !== q);
    h.unshift(q);
    h = h.slice(0, this.max);
    localStorage.setItem(this.key, JSON.stringify(h));
  },
  render() {
    const panel = document.getElementById('searchHistory');
    if (!panel) return;
    const h = this.get();
    if (!h.length) {
      panel.innerHTML = '<div class="search-history-empty">Няма история</div>';
      return;
    }
    panel.innerHTML = h.map(q =>
      `<button class="search-history-item" onclick="SearchHistory.pick('${Utils.escapeHtml(q).replace(/'/g,"\\'")}')">
        <i data-lucide="history"></i>
        <span>${Utils.escapeHtml(q)}</span>
      </button>`
    ).join('') +
    `<button class="search-history-item" onclick="SearchHistory.clearAll()" style="color:var(--danger);justify-content:center;">
      <i data-lucide="trash-2"></i> <span>Clear history</span>
    </button>`;
    Utils.refreshIcons();
  },
  pick(q) {
    const inp = document.getElementById('searchInput');
    inp.value = q;
    State.searchQuery = q;
    Content.render();
    this.hide();
  },
  show() { const p = document.getElementById('searchHistory'); if (p) { this.render(); p.classList.add('open'); } },
  hide() { const p = document.getElementById('searchHistory'); if (p) p.classList.remove('open'); },
  clearAll() {
    localStorage.removeItem(this.key);
    this.render();
    Utils.toast('Историята изчистена', 'trash-2');
  },
};

/* ═══════════════════════════════════════════════════════════════
   MODULE: EXPORT NOTES
   ═══════════════════════════════════════════════════════════════ */
const ExportNotes = {
  run() {
    const lines = ['# Olympiad Prep — Лични бележки', '', '> Генерирани: ' + new Date().toLocaleString('bg-BG'), ''];
    let count = 0;
    STEPS.forEach(step => {
      const pts = step.points.filter(p => {
        const m = Store.getPoint(p.id);
        return (m.notes && m.notes.trim()) || m.done || m.fav;
      });
      if (!pts.length) return;
      lines.push(`## Стъпка ${step.id}. ${step.title}`, '');
      pts.forEach(p => {
        const m = Store.getPoint(p.id);
        const marks = [m.done && '✅', m.fav && '⭐', m.diff && `[${m.diff.toUpperCase()}]`].filter(Boolean).join(' ');
        lines.push(`### ${p.id}. ${p.title} ${marks}`, '');
        lines.push(`*${p.source}*${p.page ? ' · стр. ' + p.page : ''}`, '');
        if (m.notes && m.notes.trim()) {
          lines.push(m.notes.trim(), '');
          count++;
        }
      });
    });
    if (count === 0 && lines.length < 6) {
      Utils.toast('Няма бележки за експорт', 'alert-circle');
      return;
    }
    const blob = new Blob([lines.join('\n')], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'olympiad-notes-' + Utils.todayStr() + '.md';
    a.click();
    URL.revokeObjectURL(url);
    Utils.toast('Експортирани ' + count + ' бележки', 'file-down');
  },
};

/* ═══════════════════════════════════════════════════════════════
   MODULE: SCRATCHPAD (v3.1 — fixed tool property conflict)
   ═══════════════════════════════════════════════════════════════ */
const Scratchpad = {
  canvas: null, ctx: null, drawing: false, lastX: 0, lastY: 0,
  color: '#000000',
  currentTool: 'pen',      // ⬅️ ПРЕИМЕНУВАНО от `tool` (беше конфликт с method-а)
  size: 3, grid: true,
  history: [], historyIdx: -1, maxHistory: 30,
  _ro: null,
  // Line tool state
  startX: 0, startY: 0, previewEndX: null, previewEndY: null, savedImage: null,
  // Text tool
  fontSize: 22,
  // Global pointerup listener ref
  _boundGlobalUp: null,

  open() {
    document.getElementById('scratchOverlay').classList.add('open');
    if (!this.canvas) this.initCanvas();
    requestAnimationFrame(() => {
      this.resize(true);
      setTimeout(() => this.resize(true), 50);
      setTimeout(() => this.resize(true), 150);
      setTimeout(() => this.resize(true), 400);
    });
    Utils.refreshIcons();
  },

  close() {
    if (this.drawing) this.endStroke(null);
    document.getElementById('scratchOverlay').classList.remove('open');
  },

  initCanvas() {
    this.canvas = document.getElementById('scratchCanvas');
    this.ctx = this.canvas.getContext('2d', { willReadFrequently: true });
    const c = this.canvas;

    c.addEventListener('pointerdown', e => this.startStroke(e));
    c.addEventListener('pointermove', e => this.moveStroke(e));
    c.addEventListener('pointerup', e => this.endStroke(e));
    c.addEventListener('pointercancel', e => this.endStroke(e));
    c.style.touchAction = 'none';

    c.addEventListener('touchstart', e => e.preventDefault(), { passive: false });
    c.addEventListener('touchmove', e => e.preventDefault(), { passive: false });

    // Global pointerup fallback — catches releases outside canvas
    this._boundGlobalUp = (e) => {
      if (this.drawing) this.endStroke(e);
    };
    document.addEventListener('pointerup', this._boundGlobalUp);
    document.addEventListener('pointercancel', this._boundGlobalUp);

    this._syncGridVisual();   // ⬅️ NEW: прилага grid-а и на бутона, и на canvas-а

    window.addEventListener('resize', () => {
      if (document.getElementById('scratchOverlay').classList.contains('open')) {
        this.resize(true);
      }
    });

    if (window.ResizeObserver) {
      this._ro = new ResizeObserver(() => {
        if (this.drawing) return;
        if (document.getElementById('scratchOverlay').classList.contains('open')) {
          this.resize(true);
        }
      });
      this._ro.observe(this.canvas.parentElement);
    }

    this.applyStyle();
  },

  startStroke(e) {
    if (e.pointerType === 'mouse' && e.button !== 0) return;
    e.preventDefault();

    const { x, y } = this.pos(e);

    // ── TEXT TOOL ──
    if (this.currentTool === 'text') {
      this._placeText(x, y);
      return;
    }

    try { this.canvas.setPointerCapture(e.pointerId); } catch (err) {}

    this.drawing = true;
    this.lastX = x; this.lastY = y;
    this.startX = x; this.startY = y;

    // ── LINE TOOL ──
    if (this.currentTool === 'line') {
      try {
        this.savedImage = this.ctx.getImageData(0, 0, this.canvas.width, this.canvas.height);
      } catch (err) {
        this.savedImage = null;
      }
      this.previewEndX = x; this.previewEndY = y;
      return;
    }

    // ── PEN / ERASER ──
    this.ctx.beginPath();
    this.ctx.moveTo(x, y);
    this.ctx.lineTo(x + 0.01, y + 0.01);
    this.ctx.stroke();
  },

  moveStroke(e) {
    if (!this.drawing) return;
    e.preventDefault();
    const { x, y } = this.pos(e);

    // ── LINE TOOL preview ──
    if (this.currentTool === 'line') {
      if (this.savedImage) {
        this.ctx.save();
        this.ctx.setTransform(1, 0, 0, 1, 0, 0);
        this.ctx.putImageData(this.savedImage, 0, 0);
        this.ctx.restore();
      }
      this.previewEndX = x; this.previewEndY = y;
      this.applyStyle();
      this.ctx.save();
      this.ctx.setLineDash([6, 5]);
      this.ctx.beginPath();
      this.ctx.moveTo(this.startX, this.startY);
      this.ctx.lineTo(x, y);
      this.ctx.stroke();
      this.ctx.restore();
      return;
    }

    // ── PEN / ERASER ──
    const midX = (this.lastX + x) / 2;
    const midY = (this.lastY + y) / 2;
    this.ctx.quadraticCurveTo(this.lastX, this.lastY, midX, midY);
    this.ctx.stroke();
    this.ctx.beginPath();
    this.ctx.moveTo(midX, midY);
    this.lastX = x; this.lastY = y;
  },

  endStroke(e) {
    if (!this.drawing) return;
    this.drawing = false;

    if (e && e.pointerId != null) {
      try { this.canvas.releasePointerCapture(e.pointerId); } catch (err) {}
    }

    // ── LINE TOOL commit ──
    if (this.currentTool === 'line') {
      if (this.savedImage) {
        this.ctx.save();
        this.ctx.setTransform(1, 0, 0, 1, 0, 0);
        this.ctx.putImageData(this.savedImage, 0, 0);
        this.ctx.restore();
        this.savedImage = null;
      }
      if (this.previewEndX !== null && this.previewEndY !== null) {
        this.applyStyle();
        this.ctx.save();
        this.ctx.setLineDash([]);
        this.ctx.beginPath();
        this.ctx.moveTo(this.startX, this.startY);
        this.ctx.lineTo(this.previewEndX, this.previewEndY);
        this.ctx.stroke();
        this.ctx.restore();
        this.previewEndX = null;
        this.previewEndY = null;
      }
    }

    this.ctx.beginPath();
    this.pushHistory();
  },

  _placeText(x, y) {
    const text = window.prompt('Текст:', '');
    if (!text || !text.trim()) return;

    this.ctx.save();
    this.ctx.globalCompositeOperation = 'source-over';
    this.ctx.fillStyle = this.color;
    this.ctx.font = `${this.fontSize}px "JetBrains Mono", monospace`;
    this.ctx.textBaseline = 'top';
    this.ctx.fillText(text, x, y);
    this.ctx.restore();
    this.pushHistory();
    Utils.toast('Текст добавен', 'type');
  },

  pos(e) {
    const r = this.canvas.getBoundingClientRect();
    return {
      x: e.clientX - r.left,
      y: e.clientY - r.top
    };
  },

  resize(keepContent) {
    const c = this.canvas;
    if (!c) return;
    const wrap = c.parentElement;
    if (!wrap) return;

    const rw = wrap.clientWidth || wrap.offsetWidth;
    const rh = wrap.clientHeight || wrap.offsetHeight;
    if (rw <= 0 || rh <= 0) return;

    c.style.width = rw + 'px';
    c.style.height = rh + 'px';

    const dpr = window.devicePixelRatio || 1;
    const newW = Math.max(1, Math.round(rw * dpr));
    const newH = Math.max(1, Math.round(rh * dpr));
    if (c.width === newW && c.height === newH) return;

    const oldW = c.width, oldH = c.height;
    let img = null;
    if (keepContent && oldW > 0 && oldH > 0) {
      try { img = this.ctx.getImageData(0, 0, oldW, oldH); } catch (err) {}
    }

    c.width = newW;
    c.height = newH;
    this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    if (img) {
      try {
        const tmp = document.createElement('canvas');
        tmp.width = oldW;
        tmp.height = oldH;
        tmp.getContext('2d').putImageData(img, 0, 0);
        this.ctx.save();
        this.ctx.setTransform(1, 0, 0, 1, 0, 0);
        this.ctx.drawImage(tmp, 0, 0);
        this.ctx.restore();
      } catch (err) {}
    }
    this._syncGridVisual();   // ⬅️ NEW: reapply grid след resize
    this.applyStyle();
  },

  applyStyle() {
    this.ctx.lineCap = 'round';
    this.ctx.lineJoin = 'round';
    this.ctx.lineWidth = this.currentTool === 'eraser' ? this.size * 6 : this.size;
    if (this.currentTool === 'eraser') {
      this.ctx.globalCompositeOperation = 'destination-out';
      this.ctx.strokeStyle = 'rgba(0,0,0,1)';
    } else {
      this.ctx.globalCompositeOperation = 'source-over';
      this.ctx.strokeStyle = this.color;
    }
  },

  setColor(c) {
    this.color = c;
    if (this.currentTool === 'eraser') this.currentTool = 'pen';
    document.querySelectorAll('.scratch-btn[data-color]').forEach(b =>
      b.classList.toggle('active', b.dataset.color === c));
    document.querySelectorAll('.scratch-btn[data-tool]').forEach(b =>
      b.classList.toggle('active', b.dataset.tool === this.currentTool));
    this.applyStyle();
  },

  // ⬇️ METHOD — сега вече няма конфликт с property
  tool(t) {
    if (this.drawing) this.endStroke(null);
    this.currentTool = t;
    document.querySelectorAll('.scratch-btn[data-tool]').forEach(b =>
      b.classList.toggle('active', b.dataset.tool === t));
    document.querySelectorAll('.scratch-btn[data-color]').forEach(b =>
      b.classList.remove('active'));
    if (t === 'pen' || t === 'line' || t === 'text') {
      const cb = document.querySelector(`.scratch-btn[data-color="${this.color}"]`);
      if (cb) cb.classList.add('active');
    }
    this.applyStyle();
    if (this.canvas) {
      this.canvas.style.cursor = (t === 'text') ? 'text' : 'crosshair';
    }
  },

toggleGrid() {
  this.grid = !this.grid;
  this._syncGridVisual();
},

  // NEW: bulletproof grid apply — inline style wins over any CSS cascade
  _syncGridVisual() {
    if (!this.canvas) return;
    if (this.grid) {
      this.canvas.classList.add('grid');
      this.canvas.style.setProperty('background-image',
        'linear-gradient(rgba(0,0,0,.08) 1px, transparent 1px), ' +
        'linear-gradient(90deg, rgba(0,0,0,.08) 1px, transparent 1px)', 'important');
      this.canvas.style.setProperty('background-size', '20px 20px', 'important');
    } else {
      this.canvas.classList.remove('grid');
      this.canvas.style.removeProperty('background-image');
      this.canvas.style.removeProperty('background-size');
      this.canvas.style.backgroundImage = 'none';
    }
    const btn = document.getElementById('scratchGridBtn');
    if (btn) btn.classList.toggle('active', this.grid);
  },

  pushHistory() {
    try {
      const img = this.canvas.toDataURL('image/png');
      if (this.history[this.historyIdx] === img) return;
      this.history = this.history.slice(0, this.historyIdx + 1);
      this.history.push(img);
      if (this.history.length > this.maxHistory) this.history.shift();
      this.historyIdx = this.history.length - 1;
    } catch (err) {}
  },

  undo() {
    if (this.historyIdx <= 0) return;
    this.historyIdx--;
    this._loadImg(this.history[this.historyIdx]);
  },

  _loadImg(data) {
    if (!data) return;
    const img = new Image();
    img.onload = () => {
      this.ctx.save();
      this.ctx.setTransform(1, 0, 0, 1, 0, 0);
      this.ctx.globalCompositeOperation = 'source-over';
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      this.ctx.drawImage(img, 0, 0);
      this.ctx.restore();
      this.applyStyle();
    };
    img.src = data;
  },

  clear() {
    if (!confirm('Clear scratchpad?')) return;
    this.ctx.save();
    this.ctx.setTransform(1, 0, 0, 1, 0, 0);
    this.ctx.globalCompositeOperation = 'source-over';
    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    this.ctx.restore();
    this.applyStyle();
    this.pushHistory();
  },

  save() {
    const tmp = document.createElement('canvas');
    tmp.width = this.canvas.width;
    tmp.height = this.canvas.height;
    const tctx = tmp.getContext('2d');
    tctx.fillStyle = '#ffffff';
    tctx.fillRect(0, 0, tmp.width, tmp.height);
    tctx.drawImage(this.canvas, 0, 0);
    const url = tmp.toDataURL('image/png');
    const a = document.createElement('a');
    a.href = url;
    a.download = 'scratch-' + Utils.todayStr() + '-' + Date.now() + '.png';
    a.click();
    Utils.toast('Записано', 'download');
  },
};

