/* ═══════════════════════════════════════════════════════════════
   MODULE: MATH RENDER (KaTeX)
   ═══════════════════════════════════════════════════════════════ */
const MathRender = {
  ready: false,
  init() {
    if (window.renderMathInElement) { this.ready = true; return; }
    let n = 0;
    const t = setInterval(() => {
      if (window.renderMathInElement) { this.ready = true; clearInterval(t); }
      else if (++n > 40) clearInterval(t);
    }, 100);
  },
  _pendingHandle: null,
  _pendingRoot: null,

  // Public entry — batches multiple calls into one scheduled pass
  schedule(root) {
    if (root) this._pendingRoot = root;
    if (this._pendingHandle) return; // already scheduled

    const run = () => {
      this._pendingHandle = null;
      const r = this._pendingRoot;
      this._pendingRoot = null;
      this.apply(r);
    };

    this._pendingHandle = setTimeout(run, 0);
  },

  apply(root) {
    if (!window.renderMathInElement) return;

    // If root is currently hidden, skip entirely
    if (root && root.getClientRects && root.getClientRects().length === 0) return;

    // Guard against parallel chains
    if (this._applyRunning) {
      if (root) this._pendingRoots = (this._pendingRoots || []).concat(root);
      return;
    }

    const sel = '.point-desc, .explanation, .pm-desc, .pm-explanation, .sheet-formula, .quiz-question, .quiz-answer, .lib-card .desc, .rep-item .title, .deepdive-body';
    let nodes;
    if (root) {
      nodes = [];
      if (root.matches && root.matches(sel)) nodes.push(root);
      nodes.push(...root.querySelectorAll(sel));
    } else {
      nodes = [...document.querySelectorAll(sel)];
    }

    // Filter: only unrendered elements, skip hidden content
    const visibleMode = Store.state.ui.topicView || 'absolute';
    nodes = nodes.filter(el => {
      if (el.dataset.mathDone === '1') return false;
      if (el.querySelector('.katex')) return false;
      // Skip elements inside hidden mode caches
      const cache = el.closest('.mode-cache');
      if (cache && cache.dataset.mode !== visibleMode) return false;
      // Skip .explanation inside collapsed points — user doesn't see them
      if (el.classList.contains('explanation')) {
        const point = el.closest('.point');
        if (point && !point.classList.contains('expanded')) return false;
      }
      return true;
    });
    if (!nodes.length) return;

    this._applyRunning = true;
    // Watchdog — ако нещо забие, освобождава след 15s
    if (this._watchdog) clearTimeout(this._watchdog);
    this._watchdog = setTimeout(() => {
      if (this._applyRunning) {
        console.warn('[math] watchdog reset');
        this._applyRunning = false;
      }
    }, 15000);
    let i = 0;
    const t0 = performance.now();
    let chunkCount = 0;
    let skipped = 0;

    const processChunk = () => {
      chunkCount++;
      const start = performance.now();
      const BUDGET_MS = 8;
      const CHUNK_MAX = 2;
      let count = 0;

      while (i < nodes.length &&
             count < CHUNK_MAX &&
             performance.now() - start < BUDGET_MS) {
        const el = nodes[i++];
        count++;
        if (el.dataset.mathDone === '1') { skipped++; continue; }
        if (!el.isConnected) { skipped++; continue; }
        try {
          el.dataset.mathDone = '1';
          window.renderMathInElement(el, {
            delimiters: [
              {left:'$$',right:'$$',display:true},
              {left:'$',right:'$',display:false},
              {left:'\\(',right:'\\)',display:false},
              {left:'\\[',right:'\\]',display:true},
            ],
            throwOnError: false,
            strict: false,
            ignoredClasses: ['katex'],
          });
        } catch(e) { skipped++; }
      }

      if (i < nodes.length) {
        setTimeout(processChunk, 0);
      } else {
        console.log('[math] done:', (performance.now() - t0).toFixed(0) + 'ms,',
          'chunks:', chunkCount, 'total:', nodes.length, 'skipped:', skipped);
        if (this._watchdog) { clearTimeout(this._watchdog); this._watchdog = null; }
        this._applyRunning = false;
        if (this._pendingRoots && this._pendingRoots.length) {
          const queued = this._pendingRoots.shift();
          this.apply(queued);
        }
      }
    };

    setTimeout(processChunk, 0);
  },
};

