/* Exam countdown */
.exam-countdown {max-width: 1200px; margin: 20px auto 28px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px;}
@media (max-width: 700px) { .exam-countdown { grid-template-columns: 1fr; margin-bottom: 22px; } }
.countdown-card {position: relative; padding: 20px 24px; background: var(--surface); border: 1px solid var(--border-2); border-radius: 8px; overflow: hidden; transition: border-color .3s;}
.countdown-card.urgent  { border-color: var(--danger); }
.countdown-card.soon    { border-color: var(--warn); }
.countdown-card.ready   { border-color: var(--accent); }
.countdown-card::before {content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--accent);}
.countdown-card.urgent::before { background: var(--danger); }
.countdown-card.soon::before   { background: var(--warn); }
.cd-head {display: flex; align-items: center; gap: 10px; color: var(--text-3); font-size: 11px; letter-spacing: 2.5px; margin-bottom: 14px;}
.cd-head svg { width: 16px; height: 16px; color: var(--accent); }
.countdown-card.urgent .cd-head svg { color: var(--danger); }
.countdown-card.soon   .cd-head svg { color: var(--warn); }
.cd-body {display: flex; align-items: baseline; gap: 12px; margin-bottom: 12px;}
.cd-days {font-size: 48px; color: var(--accent); line-height: 1; text-shadow: 0 0 16px var(--accent-glow);}
.countdown-card.urgent .cd-days { color: var(--danger); text-shadow: 0 0 16px rgba(255,68,68,.5); }
.countdown-card.soon .cd-days   { color: var(--warn);  text-shadow: 0 0 16px rgba(221,255,0,.4); }
.cd-unit {color: var(--text-3); font-size: 14px; letter-spacing: 2px;}
.cd-date {color: var(--text-2); font-size: 12px; letter-spacing: 1px;}
.cd-progress {height: 4px; background: var(--surface-4); border-radius: 2px; overflow: hidden; margin-top: 4px;}
.cd-progress-fill {height: 100%; border-radius: 2px; background: linear-gradient(90deg, var(--accent-2), var(--accent)); transition: width .5s;}
.countdown-card.urgent .cd-progress-fill { background: linear-gradient(90deg, #8a1a1a, var(--danger)); }
.countdown-card.soon   .cd-progress-fill { background: linear-gradient(90deg, #8a8a00, var(--warn)); }
.cd-meta {display: flex; justify-content: space-between; color: var(--text-3); font-size: 11px; letter-spacing: 1px; margin-top: 6px;}
.phase-exam-marker {display: flex; align-items: center; gap: 8px; padding: 10px 16px; background: linear-gradient(90deg, rgba(255,68,68,.12), transparent); border-left: 3px solid var(--danger); color: var(--danger); font-size: 12px; letter-spacing: 2px; margin-top: 8px; border-radius: 4px;}
.phase-exam-marker svg { width: 16px; height: 16px; }

/* ──────────────────────────────────────────────────────────────
   16. LIBRARY VIEW
   ────────────────────────────────────────────────────────────── */
.library-view{flex:1;overflow-y:auto;padding:32px 24px 80px}

.library-hero{max-width:1200px;margin:0 auto 40px;text-align:center}
.library-hero .eyebrow{color:var(--accent-2);font-size:11px;letter-spacing:4px;margin-bottom:12px;opacity:.85}
.library-hero h1{color:var(--accent);font-size:34px;letter-spacing:4px;text-shadow:0 0 12px var(--accent-glow);margin-bottom:10px}
.library-hero p{color:var(--text-3);font-size:14px;letter-spacing:1px;max-width:680px;margin:0 auto;line-height:1.7}
.library-section{max-width:1200px;margin:0 auto 40px}
.library-section h2{color:var(--accent);font-size:18px;letter-spacing:2.5px;margin-bottom:16px;display:flex;align-items:center;gap:10px;padding-bottom:10px;border-bottom:1px dashed var(--border-2)}
.library-section h2 svg{width:20px;height:20px}
.library-section.tools h2 svg{color:#00b8ff}
.library-section.books h2 svg{color:#ffaa00}
.library-section.sites h2 svg{color:#b88aff}
.library-section.archives h2 svg{color:#ff6688}
.lib-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}
.lib-card{padding:14px 16px;background:var(--surface-2);border:1px solid var(--border-2);border-radius:6px;text-decoration:none;color:var(--text-2);display:flex;flex-direction:column;gap:6px;transition:all .2s;position:relative;overflow:hidden;}
.lib-card:hover{border-color:var(--accent);background:var(--surface-3);transform:translateY(-2px);box-shadow:0 4px 20px var(--accent-glow)}
.lib-card .lbl-row{display:flex;align-items:center;justify-content:space-between;gap:8px}
.lib-card .lbl{color:var(--text);font-size:15px;letter-spacing:.5px;line-height:1.3}
.lib-card .tag-pill{font-size:9px;letter-spacing:1.5px;padding:2px 6px;border-radius:3px;background:var(--surface-4);border:1px solid var(--border-2);color:var(--text-3);flex-shrink:0;}
.library-section.tools .tag-pill{color:#00b8ff;border-color:#00b8ff44}
.library-section.books .tag-pill{color:#ffaa00;border-color:#ffaa0044}
.library-section.sites .tag-pill{color:#b88aff;border-color:#b88aff44}
.library-section.archives .tag-pill{color:#ff6688;border-color:#ff668844}
.lib-card .desc{color:var(--text-3);font-size:11.5px;line-height:1.4}
.lib-card .url{color:var(--accent-2);font-size:10px;letter-spacing:.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.lib-card .ext{position:absolute;top:10px;right:10px;color:var(--text-3);opacity:.4;transition:all .15s}
.lib-card:hover .ext{color:var(--accent);opacity:1}
.lib-card .ext svg{width:14px;height:14px}

/* ──────────────────────────────────────────────────────────────
   17. QUICK TOOLS FAB
   ────────────────────────────────────────────────────────────── */
.tools-fab{position:fixed;bottom:20px;right:200px;width:44px;height:44px;border-radius:50%;background:var(--surface);border:1px solid var(--accent-2);color:var(--accent);cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 0 20px var(--accent-glow);z-index:495;transition:all .2s;}
.tools-fab:hover{transform:scale(1.08) rotate(15deg);background:var(--accent);color:#000}
