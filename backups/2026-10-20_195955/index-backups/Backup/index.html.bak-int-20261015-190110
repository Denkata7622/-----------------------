/* ═══════════════════════════════════════════════════════════════
   20. SCRATCHPAD
   ═══════════════════════════════════════════════════════════════ */
.scratch-overlay{position:fixed;inset:0;background:rgba(0,0,0,.94);backdrop-filter:blur(8px);z-index:5400;display:none;align-items:center;justify-content:center;padding:16px}
.scratch-overlay.open{display:flex}
.scratch-box{width:100%;max-width:1400px;height:100%;max-height:calc(100vh - 32px);background:var(--surface);border:1px solid var(--accent-2);border-radius:8px;display:flex;flex-direction:column;box-shadow:0 0 60px var(--accent-glow);overflow:hidden}
.scratch-header{padding:10px 14px;background:var(--surface-2);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.scratch-header h2{color:var(--accent);font-size:16px;letter-spacing:2px;display:flex;align-items:center;gap:8px}
.scratch-header h2 svg{width:16px;height:16px}
.scratch-tools{display:flex;gap:4px;flex-wrap:wrap;margin-left:auto}
