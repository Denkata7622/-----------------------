<!DOCTYPE html>
<html lang="bg">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OLYMPIAD PREP TERMINAL</title>
<link href="https://fonts.googleapis.com/css2?family=VT323&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>

<style>
/* ──────────────────────────────────────────────────────────────
   1. RESET & THEME VARIABLES
   ────────────────────────────────────────────────────────────── */
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%;overflow:hidden}
body{
  --bg:#000; --surface:#061006; --surface-2:#0a1a0a; --surface-3:#0f240f; --surface-4:#142e14;
  --border:#143014; --border-2:#1f4a1f;
  --accent:#00ff44; --accent-2:#00cc36; --accent-dim:#0b4a1a; --accent-glow:rgba(0,255,68,0.35);
  --text:#b8ffb8; --text-2:#7bea7b; --text-3:#4a8a4a;
  --warn:#ddff00; --danger:#ff4444; --star:#ffdd00;
  --sidebar-w:300px; --topbar-h:60px;
  background:var(--bg); color:var(--text);
  font-family:'VT323','JetBrains Mono',monospace; font-size:17px; letter-spacing:.5px;
  -webkit-font-smoothing:antialiased;
  transition:background .2s, color .2s;
}
body[data-theme="contrast"]{
  --surface:#0a0a0a; --surface-2:#101010; --surface-3:#181818; --surface-4:#202020;
  --border:#1a1a1a; --border-2:#2a2a2a;
  --text:#f5f5f5; --text-2:#d4d4d4; --text-3:#8a8a8a;
  --accent-glow:rgba(0,255,102,.4);
}
body[data-theme="high"]{
  --surface:#000; --surface-2:#0a0a0a; --surface-3:#141414; --surface-4:#1e1e1e;
  --border:#222; --border-2:#333;
  --text:#fff; --text-2:#e8e8e8; --text-3:#999;
  --accent:#00ff88; --accent-2:#00e070; --accent-glow:rgba(0,255,136,.5);
}
body[data-theme="light"]{
  --bg:#f0f0e8; --surface:#ffffff; --surface-2:#fafaf5; --surface-3:#f4f4ee; --surface-4:#e8e8e0;
  --border:#d0d0c8; --border-2:#b8b8b0;
  --accent:#00883a; --accent-2:#006e2f; --accent-dim:#d0ead8; --accent-glow:rgba(0,136,58,.2);
  --text:#1a1a1a; --text-2:#333; --text-3:#777;
  --warn:#996600; --danger:#cc2222; --star:#cc8800;
}
/* ─── Font size base ─── */
body[data-fontsize="small"]  { font-size: 15px; }
body[data-fontsize="normal"] { font-size: 17px; }
body[data-fontsize="large"]  { font-size: 19px; }
body[data-fontsize="xlarge"] { font-size: 22px; }

/* ─── Auto-scale на фиксираните размери ─── */
body[data-fontsize="small"]  .point-desc,
body[data-fontsize="small"]  .explanation,
body[data-fontsize="small"]  .pm-desc,
body[data-fontsize="small"]  .pm-explanation,
body[data-fontsize="small"]  .lib-card .desc,
body[data-fontsize="small"]  .deepdive-body { font-size: 12px; }
body[data-fontsize="small"]  .tag,
body[data-fontsize="small"]  .chip,
body[data-fontsize="small"]  .point-num { font-size: 10px; }
body[data-fontsize="small"]  .point-title { font-size: 14px; }
body[data-fontsize="small"]  .step-title { font-size: 16px; }

body[data-fontsize="large"]  .point-desc,
body[data-fontsize="large"]  .explanation,
body[data-fontsize="large"]  .pm-desc,
body[data-fontsize="large"]  .pm-explanation,
body[data-fontsize="large"]  .lib-card .desc,
body[data-fontsize="large"]  .deepdive-body { font-size: 15px; }
body[data-fontsize="large"]  .tag,
body[data-fontsize="large"]  .chip { font-size: 12.5px; }
body[data-fontsize="large"]  .point-title { font-size: 18px; }
body[data-fontsize="large"]  .step-title { font-size: 20px; }

body[data-fontsize="xlarge"] .point-desc,
body[data-fontsize="xlarge"] .explanation,
body[data-fontsize="xlarge"] .pm-desc,
body[data-fontsize="xlarge"] .pm-explanation,
body[data-fontsize="xlarge"] .lib-card .desc,
body[data-fontsize="xlarge"] .deepdive-body { font-size: 17px; }
body[data-fontsize="xlarge"] .tag,
body[data-fontsize="xlarge"] .chip { font-size: 14px; }
body[data-fontsize="xlarge"] .point-title { font-size: 20px; }
body[data-fontsize="xlarge"] .step-title { font-size: 22px; }
body.scanlines::after{
  content:""; position:fixed; inset:0; pointer-events:none; z-index:9000;
  background:repeating-linear-gradient(to bottom,rgba(0,255,68,0) 0,rgba(0,255,68,.02) 2px,rgba(0,255,68,.035) 3px);
}
svg.lucide { stroke-width: 2; }

/* ──────────────────────────────────────────────────────────────
   2. APP LAYOUT
   ────────────────────────────────────────────────────────────── */
.app{display:flex;height:100vh;width:100vw;overflow:hidden}
.app.plan-mode .sidebar{display:none}
.app.plan-mode .study-secondary{display:none}

/* ──────────────────────────────────────────────────────────────
   3. SIDEBAR
   ────────────────────────────────────────────────────────────── */
.sidebar{
  width:var(--sidebar-w); background:var(--surface); border-right:1px solid var(--border);
  display:flex; flex-direction:column; flex-shrink:0; transition:margin-left .25s ease;
}
.sidebar.collapsed{margin-left:calc(-1 * var(--sidebar-w))}
.sidebar-header{
  padding:12px 14px; border-bottom:1px solid var(--border);
  display:flex; align-items:center; gap:10px;
}
.sidebar-header .lbl{font-size:11px; color:var(--text-3); letter-spacing:2.5px; flex:1;}
.sidebar-header .collapse-btn{
  background:transparent; border:1px solid var(--border-2); color:var(--text-2);
  padding:3px 6px; cursor:pointer; border-radius:3px;
  display:flex; align-items:center; justify-content:center;
}
.sidebar-header .collapse-btn:hover{color:var(--accent);border-color:var(--accent)}
.sidebar-header .collapse-btn svg{width:14px;height:14px}

.sidebar-stats{padding:12px 16px;border-bottom:1px solid var(--border);background:var(--surface-2)}
.streak-row{display:flex;align-items:center;gap:8px;font-size:13px}
.streak-row .fire{color:#ff8a00;filter:drop-shadow(0 0 6px rgba(255,138,0,.6));display:flex}
.streak-row .fire svg{width:20px;height:20px}
.streak-row .streak-num{color:var(--accent);font-size:20px;text-shadow:0 0 6px var(--accent-glow)}
.streak-row .streak-label{color:var(--text-3);font-size:11px;letter-spacing:1.5px}
.sidebar-nav{flex:1;overflow-y:auto;padding:8px}

.nav-step{
  display:flex; align-items:center; gap:10px; padding:8px 10px;
  border-radius:4px; cursor:pointer; margin-bottom:2px;
  border:1px solid transparent; transition:all .15s;
  background:none; font-family:inherit; width:100%; text-align:left;
}
.nav-step:hover{background:var(--surface-2);border-color:var(--border-2)}
.nav-step.active{background:var(--surface-3);border-color:var(--accent-2)}
.nav-step .num{color:var(--accent);font-size:15px;min-width:24px;text-shadow:0 0 4px var(--accent-glow)}
.nav-step .label{
  flex:1; color:var(--text-2); font-size:13px; letter-spacing:.5px;
  overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
}
.nav-step .ring{
  width:26px; height:26px; border-radius:50%; flex-shrink:0;
  display:flex; align-items:center; justify-content:center;
  position:relative; font-size:9px;
  background:conic-gradient(var(--accent) var(--pct,0%),var(--surface-4) 0);
}
.nav-step .ring::before{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--surface)}
.nav-step .ring span{position:relative;z-index:1;font-size:9px;color:var(--text-2)}

/* ──────────────────────────────────────────────────────────────
   4. MAIN AREA
   ────────────────────────────────────────────────────────────── */
.main{flex:1;display:flex;flex-direction:column;min-width:0;overflow:hidden}

/* ──────────────────────────────────────────────────────────────
   5. TOPBAR v2
   ────────────────────────────────────────────────────────────── */
.topbar{
  min-height:var(--topbar-h);
  display:flex; align-items:center; gap:12px; padding:0 16px;
  background:var(--surface); border-bottom:1px solid var(--border);
  flex-wrap:nowrap;
}
.menu-toggle{
  display:none; background:transparent; border:1px solid var(--border-2);
  color:var(--text-2); padding:6px 8px; cursor:pointer; border-radius:3px;
}
.menu-toggle:hover{color:var(--accent);border-color:var(--accent)}
.menu-toggle svg{width:16px;height:16px;display:block}
.brand{
  display:flex; align-items:center; gap:8px;
  color:var(--accent); font-size:13px; letter-spacing:2.5px;
  padding-right:14px; border-right:1px solid var(--border);
  text-shadow:0 0 6px var(--accent-glow);
  flex-shrink:0;
}
.brand svg{width:18px;height:18px}
.brand span{white-space:nowrap}
.main-tabs{
  display:flex; gap:2px;
  background:var(--surface-2);
  border:1px solid var(--border-2);
  padding:3px; border-radius:6px;
  flex-shrink:0;
}
.main-tab{
  display:flex; align-items:center; gap:6px;
  padding:6px 14px;
  background:transparent; border:none;
  color:var(--text-3);
  font-family:inherit; font-size:12px; letter-spacing:1.8px;
  cursor:pointer; border-radius:4px;
  transition:all .15s;
}
.main-tab svg{width:14px;height:14px}
.main-tab:hover{color:var(--text-2);background:var(--surface-3)}
.main-tab.active{color:#000; background:var(--accent); box-shadow:0 0 10px var(--accent-glow);}
.search-wrap{
  flex:1; max-width:520px; position:relative;
  display:flex; align-items:center;
  background:var(--surface-2); border:1px solid var(--border-2);
  border-radius:4px; padding:0 10px; height:36px;
  transition:border-color .15s;
}
.search-wrap:focus-within{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-glow)}
.search-wrap .icon{color:var(--accent);display:flex;margin-right:6px}
.search-wrap .icon svg{width:15px;height:15px}
.search-wrap input{
  flex:1; background:transparent; border:none; color:var(--text);
  font-family:inherit; font-size:15px; outline:none; letter-spacing:.5px;
}
.search-wrap input::placeholder{color:var(--text-3)}
.kbd-hint{font-size:11px; color:var(--text-3); border:1px solid var(--border-2); padding:1px 5px; border-radius:3px;}
.kbd-hint.hidden{display:none}
.topbar-actions{display:flex;align-items:center;gap:6px;margin-left:auto;flex-shrink:0}
.icon-group{
  display:flex; gap:2px;
  background:var(--surface-2);
  border:1px solid var(--border-2);
  padding:3px; border-radius:6px;
}
.icon-btn{
  width:32px; height:32px;
  background:transparent; border:1px solid transparent;
  color:var(--text-2); cursor:pointer; border-radius:4px;
  display:flex; align-items:center; justify-content:center;
  transition:all .15s;
}
.icon-btn svg{width:16px;height:16px}
.icon-btn:hover{color:var(--accent);background:var(--surface-3);border-color:var(--border-2)}
.icon-btn.active{background:var(--accent);color:#000;border-color:var(--accent)}
.dropdown{position:relative}
.dropdown > .icon-btn{background:var(--surface-2); border:1px solid var(--border-2);}
.dropdown > .icon-btn:hover{background:var(--surface-3);border-color:var(--accent)}
.study-secondary{
  padding:8px 20px;
  background:var(--surface-2); border-bottom:1px solid var(--border);
  display:flex; align-items:center; gap:16px;
}
.filter-chips{display:flex;gap:3px;flex-shrink:0}
.chip{
  background:var(--surface); border:1px solid var(--border-2);
  color:var(--text-2); padding:5px 12px; font-family:inherit;
  font-size:12px; cursor:pointer; border-radius:3px;
  letter-spacing:1px; transition:all .15s; white-space:nowrap;
}
.chip:hover{color:var(--accent);border-color:var(--accent)}
.chip.active{background:var(--accent);color:#000;border-color:var(--accent);box-shadow:0 0 8px var(--accent-glow)}

/* ──────────────────────────────────────────────────────────────
   6. STATS BAR
   ────────────────────────────────────────────────────────────── */
.stats-bar{
  padding:10px 20px; background:var(--surface-2); border-bottom:1px solid var(--border);
  display:flex; align-items:center; gap:20px; flex-wrap:wrap; font-size:14px;
}
.stat{display:flex;align-items:baseline;gap:6px}
.stat .v{color:var(--accent);font-size:18px;text-shadow:0 0 5px var(--accent-glow)}
.stat .l{color:var(--text-3);font-size:11px;letter-spacing:1.5px}
.progress-wrap{flex:1; min-width:150px; height:6px; background:var(--surface-4); border-radius:3px; overflow:hidden;}
.progress-fill{height:100%; border-radius:3px; background:linear-gradient(90deg,var(--accent-2),var(--accent)); transition:width .5s; box-shadow:0 0 8px var(--accent-glow);}

/* ──────────────────────────────────────────────────────────────
   7. CONTENT VIEWS
   ────────────────────────────────────────────────────────────── */
.content-view{display:flex; flex-direction:column; flex:1; min-height:0; overflow:hidden;}
.content-view.hidden{display:none}
.content{flex:1;overflow-y:auto;padding:20px;scroll-behavior:smooth}

.empty{padding:60px 20px;text-align:center;color:var(--text-3);letter-spacing:2px}
.empty .big{color:var(--accent-2);margin-bottom:12px;opacity:.5;display:flex;justify-content:center}
.empty .big svg{width:48px;height:48px}

/* ──────────────────────────────────────────────────────────────
   8. STEP + POINT CARDS
   ────────────────────────────────────────────────────────────── */
.step{background:var(--surface); border:1px solid var(--border); border-radius:6px; margin-bottom:16px; overflow:hidden; scroll-margin-top:16px;}
.step-header{padding:14px 18px; display:flex; align-items:center; gap:12px; cursor:pointer; user-select:none; background:var(--surface-2); border-bottom:1px solid var(--border); transition:background .15s;}
.step-header:hover{background:var(--surface-3)}
.step-toggle{color:var(--accent);transition:transform .2s;display:flex}
.step-toggle svg{width:14px;height:14px}
.step.collapsed .step-toggle{transform:rotate(-90deg)}
.step.collapsed .step-body{display:none}
.step-num{color:var(--accent);font-size:22px;min-width:40px;letter-spacing:1px;text-shadow:0 0 6px var(--accent-glow)}
.step-title{flex:1;font-size:18px;letter-spacing:1.5px;color:var(--accent);text-shadow:0 0 4px var(--accent-glow)}
.step-badge{font-size:12px; color:var(--text-2); border:1px solid var(--border-2); padding:2px 9px; border-radius:3px; letter-spacing:1px; background:var(--surface-4); white-space:nowrap;}
.step-badge.done{background:var(--accent);color:#000;border-color:var(--accent);box-shadow:0 0 6px var(--accent-glow)}
.step-reset{background:transparent; border:1px solid transparent; color:var(--text-3); cursor:pointer; padding:4px; border-radius:3px; display:flex; align-items:center;}
.step-reset svg{width:14px;height:14px}
.step-reset:hover{color:var(--danger);border-color:var(--danger)}
.step-body{padding:12px}
.point{background:var(--surface-2); border:1px solid var(--border-2); border-radius:5px; margin-bottom:8px; transition:all .15s; position:relative; overflow:hidden;}
.point:hover{border-color:var(--accent-2)}
.point.done{opacity:.55}
.point.done .point-title{text-decoration:line-through;color:var(--text-3)}
.point.fav{border-color:var(--star)}
.point.fav::before{content:"";position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--star)}
.point.highlight{animation:highlight 1.2s ease}
@keyframes highlight{0%,100%{background:var(--surface-2)} 50%{background:var(--surface-4);box-shadow:0 0 15px var(--accent-glow)}}
.point-row{padding:11px 14px;display:flex;gap:12px;align-items:flex-start}
.point-check{flex-shrink:0; width:22px; height:22px; border:2px solid var(--accent-2); border-radius:3px; background:var(--surface); color:var(--text-3); cursor:pointer; display:flex; align-items:center; justify-content:center; margin-top:2px; transition:all .15s;}
.point-check:hover{border-color:var(--accent);color:var(--accent)}
.point-check.checked{background:var(--accent);border-color:var(--accent);color:#000;box-shadow:0 0 8px var(--accent-glow)}
.point-check svg{width:14px;height:14px}
.point-main{flex:1;min-width:0}
.point-num{font-size:11px;color:var(--text-3);letter-spacing:2px;margin-bottom:2px;display:flex;align-items:center;gap:4px}
.point-title{font-size:16px;color:var(--text);margin-bottom:4px;letter-spacing:.5px}
.point-desc{font-size:13px;color:var(--text-2);line-height:1.5;margin-bottom:8px}
.point-tags{display:flex;flex-wrap:wrap;gap:5px;align-items:center}
.tag{font-size:11px; padding:2px 7px; background:var(--surface-3); border:1px solid var(--border-2); border-radius:3px; color:var(--text-2); letter-spacing:.5px;}
.tag.src{color:var(--text-3)}
.tag.page{color:var(--accent-2);border-color:var(--accent-dim);background:var(--accent-dim)}
.pdf-btn{font-size:11px; padding:3px 9px; background:var(--accent-dim); border:1px solid var(--accent-2); border-radius:3px; color:var(--accent); text-decoration:none; letter-spacing:1px; transition:all .15s; display:inline-flex; align-items:center; gap:4px;}
.pdf-btn svg{width:12px;height:12px}
.pdf-btn:hover{background:var(--accent);color:#000;box-shadow:0 0 8px var(--accent-glow)}
.pdf-btn.bonus{background:#1a0a30;border-color:#6a30c0;color:#b88aff}
.pdf-btn.bonus:hover{background:#6a30c0;color:#fff}
.pdf-btn.video{background:#2a0a0a;border-color:#b040ff;color:#d0a0ff}
.pdf-btn.video:hover{background:#b040ff;color:#fff}
.point-actions{display:flex;gap:3px;flex-shrink:0;align-items:flex-start}
.mini-btn{width:26px; height:26px; background:transparent; border:1px solid var(--border-2); color:var(--text-3); cursor:pointer; border-radius:3px; display:flex; align-items:center; justify-content:center; transition:all .15s;}
.mini-btn svg{width:14px;height:14px}
.mini-btn:hover{color:var(--accent);border-color:var(--accent)}
.mini-btn.active{color:var(--star);border-color:var(--star)}
.diff-group{display:flex;gap:2px}
.diff-btn{font-size:10px; width:22px; height:26px; background:transparent; border:1px solid var(--border-2); color:var(--text-3); font-family:inherit; cursor:pointer; border-radius:3px; transition:all .15s; display:flex; align-items:center; justify-content:center;}
.diff-btn:hover{color:var(--accent);border-color:var(--accent)}
.diff-btn.active.easy{color:#7dff7d;border-color:#7dff7d;background:rgba(125,255,125,.1)}
.diff-btn.active.med{color:var(--warn);border-color:var(--warn);background:rgba(221,255,0,.1)}
.diff-btn.active.hard{color:var(--danger);border-color:var(--danger);background:rgba(255,68,68,.1)}
.point-expand{border-top:1px solid var(--border); background:var(--surface); padding:0; max-height:0; overflow:hidden; transition:max-height .35s ease;}
.point.expanded .point-expand{max-height:2000px}
.point-expand-inner{padding:14px}
.section-label{font-size:10px;color:var(--text-3);letter-spacing:2px;margin-bottom:6px;text-transform:uppercase}
.explanation{font-size:14px; color:var(--text); line-height:1.7; padding:10px 14px; background:var(--surface-2); border-left:2px solid var(--accent-dim); border-radius:3px; margin-bottom:12px; white-space:pre-wrap;}
.notes-area{width:100%; min-height:80px; background:var(--surface-2); border:1px solid var(--border-2); color:var(--text); font-family:inherit; font-size:14px; padding:8px 10px; border-radius:3px; resize:vertical; outline:none; line-height:1.5; transition:border-color .15s;}
.notes-area:focus{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-glow)}
.notes-area::placeholder{color:var(--text-3)}
.bonus-row{margin-top:10px; padding-top:10px; border-top:1px dashed var(--border-2); display:flex; flex-wrap:wrap; gap:5px;}
.notes-badge{color:var(--warn);display:inline-flex}
.notes-badge svg{width:12px;height:12px}

/* ──────────────────────────────────────────────────────────────
   9. PLAN VIEW
   ────────────────────────────────────────────────────────────── */
.plan-view{flex:1; overflow-y:auto; padding:32px 24px 60px;}

.plan-hero{max-width:1200px; margin:0 auto 32px; text-align:center;}
.plan-hero .eyebrow{color:var(--accent-2); font-size:11px; letter-spacing:4px; margin-bottom:12px; opacity:.85;}
.plan-hero h1{color:var(--accent); font-size:34px; letter-spacing:4px; text-shadow:0 0 12px var(--accent-glow); margin-bottom:10px;}
.plan-hero p{color:var(--text-3); font-size:14px; letter-spacing:1px; max-width:680px; margin:0 auto; line-height:1.7;}
.plan-hero .plan-stats{display:flex; justify-content:center; gap:32px; margin-top:20px; flex-wrap:wrap;}
.plan-stat .val{color:var(--accent); font-size:24px; text-shadow:0 0 8px var(--accent-glow)}
.plan-stat .lbl{color:var(--text-3); font-size:10px; letter-spacing:2px}
.phase-card{max-width:1200px; margin:0 auto 20px; background:var(--surface); border:1px solid var(--border); border-radius:8px; overflow:hidden;}
.phase-header{padding:16px 20px; background:var(--surface-2); border-bottom:1px solid var(--border); display:flex; align-items:center; gap:16px; cursor:pointer; user-select:none; transition:background .15s;}
.phase-header:hover{background:var(--surface-3)}
.phase-num{width:44px; height:44px; border-radius:50%; background:var(--surface-4); border:2px solid var(--accent); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:20px; text-shadow:0 0 6px var(--accent-glow); flex-shrink:0;}
.phase-meta{flex:1; min-width:0}
.phase-weeks{color:var(--text-3); font-size:10px; letter-spacing:2.5px; margin-bottom:4px;}
.phase-title{color:var(--accent); font-size:18px; letter-spacing:2.5px;}
.phase-goal{color:var(--text-3); font-size:12px; max-width:400px; text-align:right; line-height:1.5;}
.phase-progress{color:var(--accent-2); font-size:11px; letter-spacing:1.5px; text-align:right; margin-top:4px;}
.phase-body{padding:12px; display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:8px; max-height:2000px; transition:max-height .35s ease, padding .35s ease;}
.phase-card.collapsed .phase-body{max-height:0; padding-top:0; padding-bottom:0;}
.phase-card.collapsed .phase-header .phase-caret{transform:rotate(-90deg)}
.phase-caret{color:var(--accent); display:flex; transition:transform .2s;}
.phase-caret svg{width:16px;height:16px}
.week-item{background:var(--surface-2); border:1px solid var(--border-2); border-radius:5px; padding:11px 13px; cursor:pointer; transition:all .15s; position:relative;}
.week-item:hover{border-color:var(--accent-2); background:var(--surface-3); transform:translateY(-1px);}
.week-item.done{border-color:var(--accent); background:linear-gradient(135deg, var(--surface-2), rgba(0,255,68,.05));}
.week-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;}
.week-num{color:var(--accent); font-size:12px; letter-spacing:2.5px;}
.week-status{display:flex; color:var(--text-3);}
.week-status svg{width:14px;height:14px}
.week-item.done .week-status{color:var(--accent)}
.week-topics{font-size:12px; color:var(--text-2); line-height:1.6;}
.week-topics .topic-row{display:flex; gap:6px; margin-bottom:2px; align-items:flex-start;}
.week-topics .topic-badge{color:var(--accent-2); font-size:10px; letter-spacing:1.5px; min-width:32px; padding-top:2px; flex-shrink:0;}
.week-topics .topic-text{flex:1; color:var(--text-2)}
.week-topics .sec-topic .topic-badge{color:var(--text-3)}
.week-topics .sec-topic .topic-text{color:var(--text-3); font-size:11px}
.daily-grid{padding:12px; display:grid; grid-template-columns:repeat(7, 1fr); gap:8px;}
.day-card{background:var(--surface-2); border:1px solid var(--border-2); border-radius:6px; padding:14px 10px; text-align:center; transition:all .15s;}
.day-card:hover{border-color:var(--accent-2)}
.day-card.today{border-color:var(--accent); box-shadow:0 0 14px var(--accent-glow); background:linear-gradient(135deg, var(--surface-2), rgba(0,255,68,.06));}
.day-card.rest{background:var(--surface); opacity:.8;}
.day-name{color:var(--accent); font-size:12px; letter-spacing:2.5px; margin-bottom:10px;}
.day-icon{color:var(--accent-2); margin-bottom:8px; display:flex; justify-content:center;}
.day-card.today .day-icon{color:var(--accent)}
.day-icon svg{width:24px;height:24px}
.day-activity{color:var(--text-2); font-size:11px; line-height:1.4; margin-bottom:6px; min-height:28px;}
.day-duration{color:var(--text-3); font-size:10px; letter-spacing:1px;}
.plan-legend{max-width:1200px; margin:24px auto 0; display:flex; gap:16px; flex-wrap:wrap; justify-content:center; color:var(--text-3); font-size:11px; letter-spacing:1px;}
.plan-legend .lg{display:flex; align-items:center; gap:6px;}
.plan-legend .dot{width:8px; height:8px; border-radius:50%; background:var(--accent);}
.plan-legend .dot.pending{background:var(--text-3)}
.plan-legend .dot.today{background:var(--accent); box-shadow:0 0 6px var(--accent-glow)}

/* ──────────────────────────────────────────────────────────────
   10. POINT MODAL
   ────────────────────────────────────────────────────────────── */
.modal-overlay{position:fixed; inset:0; background:rgba(0,0,0,.92); backdrop-filter:blur(6px); z-index:5000; display:none; align-items:center; justify-content:center; padding:8px;}
.modal-overlay.open{display:flex}
.point-modal{width:100%; max-width:1500px; height:100%; max-height:calc(100vh - 16px); background:var(--surface); border:1px solid var(--accent-2); border-radius:8px; display:flex; flex-direction:column; box-shadow:0 0 60px var(--accent-glow); overflow:hidden;}
.pm-header{padding:12px 18px; border-bottom:1px solid var(--border); background:var(--surface-2); display:flex; align-items:center; gap:12px; flex-wrap:wrap;}
.pm-title-area{flex:1;min-width:200px}
.pm-id{font-size:11px;color:var(--text-3);letter-spacing:2px}
.pm-title{font-size:20px; color:var(--accent); letter-spacing:1px; text-shadow:0 0 6px var(--accent-glow); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
.pm-actions{display:flex;gap:4px;align-items:center;flex-wrap:wrap}
.pm-btn{background:var(--surface-3); border:1px solid var(--border-2); color:var(--text-2); font-family:inherit; font-size:13px; padding:6px 10px; border-radius:3px; cursor:pointer; transition:all .15s; display:inline-flex; align-items:center; gap:5px; white-space:nowrap;}
.pm-btn svg{width:14px;height:14px}
.pm-btn:hover{color:var(--accent);border-color:var(--accent)}
.pm-btn.active{background:var(--accent);color:#000;border-color:var(--accent)}
.pm-btn.fav.active{background:var(--star);color:#000;border-color:var(--star)}
.pm-btn.close{background:transparent;padding:4px 8px}
.pm-btn.close:hover{background:var(--danger);color:#fff;border-color:var(--danger)}
.pm-btn.diff-btn.easy.active{color:#7dff7d;border-color:#7dff7d;background:rgba(125,255,125,.15)}
.pm-btn.diff-btn.med.active{color:var(--warn);border-color:var(--warn);background:rgba(221,255,0,.15)}
.pm-btn.diff-btn.hard.active{color:var(--danger);border-color:var(--danger);background:rgba(255,68,68,.15)}
.pm-body{flex:1;display:flex;overflow:hidden}
.pm-left{width:420px;flex-shrink:0;border-right:1px solid var(--border);overflow-y:auto;padding:16px}

.pm-right{flex:1;display:flex;flex-direction:column;min-width:0}
.pm-section{margin-bottom:18px}
.pm-label{font-size:10px;color:var(--text-3);letter-spacing:2px;margin-bottom:6px;text-transform:uppercase}
.pm-desc{font-size:13px;color:var(--text-2);line-height:1.5}
.pm-explanation{font-size:13px; color:var(--text); line-height:1.7; padding:10px 12px; background:var(--surface-2); border-left:3px solid var(--accent-dim); border-radius:3px; white-space:pre-wrap; max-height:400px; overflow-y:auto;}
.pm-notes{width:100%; min-height:110px; background:var(--surface-2); border:1px solid var(--border-2); color:var(--text); font-family:inherit; font-size:13px; padding:8px 10px; border-radius:3px; resize:vertical; outline:none; line-height:1.5;}
.pm-notes:focus{border-color:var(--accent)}
.pm-meta-tags{display:flex;flex-wrap:wrap;gap:5px}
.pm-pdf-tabs{display:flex; gap:0; border-bottom:1px solid var(--border); background:var(--surface-2); padding:0 12px; overflow-x:auto;}
.pm-tab{padding:10px 14px; background:transparent; border:none; border-bottom:2px solid transparent; color:var(--text-3); font-family:inherit; font-size:13px; cursor:pointer; letter-spacing:1px; display:flex; align-items:center; gap:6px; transition:all .15s; white-space:nowrap;}
.pm-tab svg{width:14px;height:14px}
.pm-tab:hover{color:var(--accent)}
.pm-tab.active{color:var(--accent);border-bottom-color:var(--accent);background:var(--surface)}
.pm-tab .badge{font-size:10px;color:var(--text-3);background:var(--surface-4);padding:1px 6px;border-radius:2px}
.pm-tab.external{margin-left:auto}
.pm-pdf-container{flex:1;position:relative;background:#111;min-height:500px}
.pm-pdf-frame{width:100%;height:100%;border:none;background:#111}
.pm-footer{padding:8px 16px; border-top:1px solid var(--border); background:var(--surface-2); display:flex; align-items:center; gap:8px; font-size:11px; flex-wrap:wrap;}
.pm-pomo-inline{display:flex;align-items:center;gap:10px;margin-left:auto}
.pm-pomo-time{font-size:18px; color:var(--accent); text-shadow:0 0 6px var(--accent-glow); letter-spacing:1px; min-width:50px; text-align:center;}
.pm-task-item{display:flex; align-items:center; gap:8px; padding:7px 10px; background:var(--surface-2); border:1px solid var(--border-2); border-radius:3px; font-size:12px; cursor:pointer; transition:all .15s; margin-bottom:4px;}
.pm-task-item:hover{border-color:var(--accent);background:var(--surface-3)}
.pm-task-item .label{flex:1;color:var(--text-2);display:flex;gap:6px;align-items:center}
.pm-task-item .label svg{width:12px;height:12px}
.pm-task-item .pg{color:var(--accent-2);font-size:11px}
.pm-task-item .go{color:var(--accent);display:flex}
.pm-task-item .go svg{width:14px;height:14px}

/* ──────────────────────────────────────────────────────────────
   11. POMODORO
   ────────────────────────────────────────────────────────────── */
.pomodoro{position:fixed; bottom:20px; right:20px; background:var(--surface); border:1px solid var(--accent-2); border-radius:6px; padding:10px 14px; display:flex; align-items:center; gap:12px; box-shadow:0 0 20px var(--accent-glow); z-index:500; font-size:14px;}
.pomodoro .time{font-size:24px; color:var(--accent); text-shadow:0 0 8px var(--accent-glow); min-width:72px; text-align:center; letter-spacing:2px;}
.pomodoro .time.break{color:var(--warn);text-shadow:0 0 8px rgba(221,255,0,.5)}
.pomodoro .mode{font-size:10px;color:var(--text-3);letter-spacing:2px;text-align:center}
.pomo-btn{width:30px; height:30px; background:var(--surface-2); border:1px solid var(--border-2); color:var(--text-2); cursor:pointer; border-radius:3px; display:flex; align-items:center; justify-content:center; transition:all .15s;}
.pomo-btn svg{width:14px;height:14px}
.pomo-btn:hover{color:var(--accent);border-color:var(--accent)}
.pomo-btn.play{background:var(--accent);color:#000;border-color:var(--accent)}
.pomo-count{font-size:11px; color:var(--text-3); letter-spacing:1px; border-left:1px solid var(--border); padding-left:12px; text-align:center;}

/* ──────────────────────────────────────────────────────────────
   12. COMMAND PALETTE
   ────────────────────────────────────────────────────────────── */
.palette-overlay{position:fixed; inset:0; background:rgba(0,0,0,.75); backdrop-filter:blur(4px); z-index:2000; display:none; align-items:flex-start; justify-content:center; padding-top:15vh;}
.palette-overlay.open{display:flex}
.palette{width:90%; max-width:560px; background:var(--surface); border:1px solid var(--accent-2); border-radius:6px; box-shadow:0 0 40px var(--accent-glow); overflow:hidden;}
.palette-input{width:100%; background:var(--surface-2); border:none; border-bottom:1px solid var(--border); color:var(--accent); font-family:inherit; font-size:18px; padding:14px 18px; outline:none; letter-spacing:1px;}
.palette-input::placeholder{color:var(--text-3)}
.palette-results{max-height:50vh;overflow-y:auto}

.palette-item{padding:10px 18px; cursor:pointer; display:flex; gap:12px; align-items:center; border-bottom:1px solid var(--border); transition:background .1s;}
.palette-item:hover,.palette-item.selected{background:var(--surface-3); border-left:3px solid var(--accent); padding-left:15px;}
.palette-item .pnum{font-size:12px;color:var(--text-3);min-width:40px;letter-spacing:1px}
.palette-item .ptitle{flex:1;font-size:14px;color:var(--text);display:flex;gap:6px;align-items:center}
.palette-item .ptitle svg{width:14px;height:14px;color:var(--accent)}
.palette-item .pstep{font-size:11px;color:var(--accent-2);letter-spacing:1px}
.palette-empty{padding:30px;text-align:center;color:var(--text-3);font-size:14px;letter-spacing:2px}

/* ──────────────────────────────────────────────────────────────
   13. DROPDOWN, HELP, TOAST
   ────────────────────────────────────────────────────────────── */
.dropdown{position:relative}
.dropdown-menu{position:absolute; top:calc(100% + 6px); right:0; background:var(--surface); border:1px solid var(--accent-2); border-radius:5px; padding:6px; min-width:230px; box-shadow:0 4px 20px rgba(0,0,0,.6), 0 0 15px var(--accent-glow); z-index:300; display:none;}
.dropdown-menu.open{display:block}
.dropdown-item{display:flex; align-items:center; gap:10px; padding:8px 12px; color:var(--text-2); font-family:inherit; font-size:13px; cursor:pointer; border-radius:3px; background:transparent; border:none; width:100%; text-align:left; letter-spacing:.5px; transition:all .1s;}
.dropdown-item svg{width:15px;height:15px;color:var(--accent);flex-shrink:0}
.dropdown-item:hover{background:var(--surface-3);color:var(--accent)}
.dropdown-item .shortcut{margin-left:auto; font-size:10px; color:var(--text-3); border:1px solid var(--border-2); padding:1px 5px; border-radius:2px;}
.dropdown-item.danger{color:var(--danger)}
.dropdown-item.danger svg{color:var(--danger)}
.dropdown-item.danger:hover{background:rgba(255,68,68,.1);color:var(--danger)}
.dropdown-sep{height:1px;background:var(--border);margin:4px 0}
.help-overlay{position:fixed; inset:0; background:rgba(0,0,0,.8); z-index:2100; display:none; align-items:center; justify-content:center;}
.help-overlay.open{display:flex}
.help-box{background:var(--surface); border:1px solid var(--accent-2); border-radius:6px; padding:24px 28px; max-width:520px; width:90%; box-shadow:0 0 30px var(--accent-glow); max-height:90vh; overflow-y:auto;}
.help-box h2{color:var(--accent); font-size:20px; letter-spacing:2px; margin-bottom:18px; text-shadow:0 0 6px var(--accent-glow); display:flex; align-items:center; gap:10px;}
.help-box h2 svg{width:22px;height:22px}
.help-row{display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px solid var(--border); font-size:14px;}
.help-row:last-child{border-bottom:none}
.help-row .lbl{color:var(--text-2)}
.help-row kbd{background:var(--surface-2); border:1px solid var(--border-2); border-bottom-width:2px; padding:2px 8px; border-radius:3px; color:var(--accent); font-family:inherit; font-size:12px; letter-spacing:1px;}
.toast{position:fixed; bottom:24px; left:50%; transform:translate(-50%,80px); background:var(--surface); border:1px solid var(--accent); color:var(--accent); padding:10px 18px; border-radius:4px; font-size:14px; letter-spacing:1px; box-shadow:0 0 20px var(--accent-glow); z-index:3000; opacity:0; transition:all .3s; pointer-events:none; display:flex; align-items:center; gap:8px;}
.toast svg{width:16px;height:16px}
.toast.show{transform:translate(-50%,0);opacity:1}

/* ──────────────────────────────────────────────────────────────
   14. NEW FEATURES CSS
   ────────────────────────────────────────────────────────────── */
body.focus-mode .sidebar,
body.focus-mode .topbar,
body.focus-mode .study-secondary,
body.focus-mode .stats-bar,
body.focus-mode .pomodoro { display:none!important; }
body.focus-mode .main { margin-left:0!important; }
body.focus-mode .content { padding:40px max(20px, 8vw); }
body.focus-mode .point-desc,
body.focus-mode .point-tags,
body.focus-mode .point-actions { opacity:0.35; transition:opacity .3s; }
body.focus-mode .point:hover .point-desc,
body.focus-mode .point:hover .point-tags,
body.focus-mode .point:hover .point-actions { opacity:1; }
body.focus-mode .step { border-color:transparent; margin-bottom:40px; }
body.focus-mode .step-header { background:transparent; }

.pm-breadcrumbs {display:flex; align-items:center; gap:6px; font-size:11px; color:var(--text-3); letter-spacing:1px; margin-top:2px;}
.pm-breadcrumbs .sep { opacity:0.5; }
.pm-breadcrumbs .crumb { cursor:pointer; color:var(--accent-2); }
.pm-breadcrumbs .crumb:hover { color:var(--accent); }

.prereq-row {display:flex; flex-wrap:wrap; gap:5px; align-items:center; margin-top:6px; font-size:11px;}
.prereq-chip {padding:2px 8px; border-radius:3px; background:var(--accent-dim); border:1px solid var(--accent-2); color:var(--accent); cursor:pointer; transition:all .15s;}
.prereq-chip:hover { background:var(--accent); color:#000; }
.prereq-chip.done { background:#0a3a10; border-color:#2a8a2a; color:#7dff7d; }

.quiz-overlay {position:fixed; inset:0; background:rgba(0,0,0,0.97); z-index:5100; display:none; align-items:center; justify-content:center; padding:40px;}
.quiz-overlay.open { display:flex; }
.quiz-card {width:100%; max-width:800px; background:var(--surface); border:1px solid var(--accent-2); border-radius:10px; padding:40px; position:relative; box-shadow:0 0 60px var(--accent-glow);}
.quiz-close {position:absolute; top:12px; right:12px; background:transparent; border:1px solid var(--border-2); color:var(--text-3); cursor:pointer; padding:6px 10px; border-radius:4px; display:flex; align-items:center; gap:6px;}
.quiz-close svg{width:14px;height:14px}
.quiz-close:hover { color:var(--danger); border-color:var(--danger); }
.quiz-progress {font-size:12px; color:var(--text-3); letter-spacing:2px; margin-bottom:20px; display:flex; justify-content:space-between;}
.quiz-question {font-size:24px; color:var(--accent); margin-bottom:30px; letter-spacing:1px; line-height:1.4;}
.quiz-answer {font-size:16px; color:var(--text); line-height:1.7; padding:20px; background:var(--surface-2); border-left:3px solid var(--accent-dim); border-radius:4px; white-space:pre-wrap; max-height:400px; overflow-y:auto; margin-bottom:20px; display:none;}
.quiz-answer.show { display:block; }
.quiz-actions { display:flex; gap:10px; flex-wrap:wrap; }
.quiz-btn {flex:1; min-width:120px; padding:14px 20px; font-family:inherit; font-size:16px; letter-spacing:1px; border-radius:5px; cursor:pointer; border:2px solid; background:transparent; transition:all .15s; display:flex; align-items:center; justify-content:center; gap:8px;}
.quiz-btn svg{width:16px;height:16px}
.quiz-btn.show { color:var(--accent); border-color:var(--accent); }
.quiz-btn.show:hover { background:var(--accent); color:#000; }
.quiz-btn.correct { color:#7dff7d; border-color:#7dff7d; }
.quiz-btn.correct:hover { background:#7dff7d; color:#000; }
.quiz-btn.wrong { color:var(--danger); border-color:var(--danger); }
.quiz-btn.wrong:hover { background:var(--danger); color:#000; }
.quiz-btn.skip { color:var(--text-3); border-color:var(--border-2); }
.quiz-btn.skip:hover { color:var(--text-2); }
.quiz-stats {margin-top:20px; padding-top:20px; border-top:1px solid var(--border); font-size:13px; color:var(--text-3); display:flex; gap:20px; flex-wrap:wrap;}
.quiz-stats > span { display:flex; align-items:center; gap:6px; }
.quiz-stats svg{width:14px;height:14px}

.ach-overlay {position:fixed; inset:0; background:rgba(0,0,0,0.9); z-index:5200; display:none; align-items:center; justify-content:center; padding:24px;}
.ach-overlay.open { display:flex; }
.ach-box {width:100%; max-width:980px; max-height:90vh; background:var(--surface); border:1px solid var(--accent-2); border-radius:8px; padding:24px; overflow-y:auto; box-shadow:0 0 40px var(--accent-glow);}
.ach-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }
.ach-header h2 { color:var(--accent); font-size:22px; letter-spacing:2px; display:flex; align-items:center; gap:10px; }
.ach-header h2 svg { width:22px; height:22px; }
.ach-header .hint { color:var(--text-3); font-size:12px; letter-spacing:1px; margin-top:4px; }
.ach-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(220px, 1fr)); gap:12px; }
.ach-item {padding:14px; background:var(--surface-2); border:1px solid var(--border-2); border-radius:6px; display:flex; gap:14px; align-items:center; opacity:0.42; transition:all .3s; position:relative;}
.ach-item.unlocked {opacity:1; border-color:var(--accent); box-shadow:0 0 14px var(--accent-glow), inset 0 0 20px rgba(0,255,68,.04);}
.ach-item.unlocked::before {content:""; position:absolute; left:0; top:0; bottom:0; width:3px; background:var(--accent); border-radius:6px 0 0 6px;}
.ach-icon {width:42px; height:42px; flex-shrink:0; display:flex; align-items:center; justify-content:center; border-radius:50%; background:var(--surface-4); border:1px solid var(--border-2); color:var(--text-3);}
.ach-icon svg { width:22px; height:22px; }
.ach-item.unlocked .ach-icon {color:var(--accent); border-color:var(--accent); background:rgba(0,255,68,.08); box-shadow:0 0 10px var(--accent-glow);}
.ach-info { flex:1; min-width:0; }
.ach-name {font-size:14px; color:var(--text); margin-bottom:3px; letter-spacing:1px; font-weight:600;}
.ach-item.unlocked .ach-name { color:var(--accent); }
.ach-desc { font-size:11px; color:var(--text-3); line-height:1.4; }

.report-overlay {position:fixed; inset:0; background:rgba(0,0,0,0.92); z-index:5300; display:none; align-items:center; justify-content:center; padding:24px;}
.report-overlay.open { display:flex; }
.report-box {width:100%; max-width:640px; background:var(--surface); border:1px solid var(--accent-2); border-radius:8px; padding:28px; box-shadow:0 0 40px var(--accent-glow); max-height:90vh; overflow-y:auto;}
.report-box h2 { color:var(--accent); margin-bottom:6px; letter-spacing:2px; display:flex; align-items:center; gap:10px; }
.report-box h2 svg { width:20px; height:20px; }
.report-box .sub { color:var(--text-3); font-size:12px; margin-bottom:20px; letter-spacing:1px; }
.report-stats {display:grid; grid-template-columns:repeat(2, 1fr); gap:12px; margin-bottom:20px;}
.report-stat {padding:12px; background:var(--surface-2); border:1px solid var(--border-2); border-radius:5px;}
.report-stat .val { color:var(--accent); font-size:24px; }
.report-stat .lbl { color:var(--text-3); font-size:11px; letter-spacing:1px; }

.calendar-widget {margin-top:12px; padding:10px; background:var(--surface-2); border:1px solid var(--border); border-radius:4px;}
.calendar-label {font-size:10px; color:var(--text-3); letter-spacing:1.5px; margin-bottom:8px; display:flex; justify-content:space-between;}
.calendar-grid {display:grid; grid-template-columns:repeat(30, 1fr); gap:2px;}
.calendar-cell {aspect-ratio:1; border-radius:2px; background:var(--surface-4); transition:all .15s;}
.calendar-cell.l1 { background:#0a3a0a; }
.calendar-cell.l2 { background:#0f5a0f; }
.calendar-cell.l3 { background:#16991c; }
.calendar-cell.l4 { background:var(--accent); box-shadow:0 0 4px var(--accent-glow); }
.calendar-cell.today { outline:1px solid var(--accent); outline-offset:1px; }

.goal-widget {margin-top:10px; padding:10px; background:var(--surface-2); border:1px solid var(--border); border-radius:4px;}
.goal-row {display:flex; justify-content:space-between; font-size:11px; color:var(--text-3); letter-spacing:1px; margin-bottom:5px;}
.goal-bar {height:6px; background:var(--surface-4); border-radius:3px; overflow:hidden;}
.goal-fill {height:100%; background:linear-gradient(90deg, var(--accent-2), var(--accent)); transition:width .5s; box-shadow:0 0 6px var(--accent-glow);}
.goal-fill.done { background:#7dff7d; }

.formula-of-day {padding:6px 12px; background:var(--surface); border:1px solid var(--border-2); border-radius:4px; font-size:12px; color:var(--text-2); max-width:380px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-left:auto;}
.formula-of-day .lbl { color:var(--accent); font-size:10px; letter-spacing:1px; margin-right:6px; }
.formula-of-day .txt { color:var(--text-2); cursor:pointer; }
.formula-of-day .txt:hover { color:var(--accent); }
@media (max-width:1100px) { .formula-of-day { display:none; } }

.continue-btn {position:fixed; bottom:20px; left:20px; background:var(--surface); border:1px solid var(--accent-2); color:var(--accent); padding:10px 16px; border-radius:6px; font-family:inherit; font-size:13px; cursor:pointer; box-shadow:0 0 20px var(--accent-glow); z-index:490; letter-spacing:.5px; display:none; max-width:340px; text-align:left;}
.continue-btn.show { display:flex; align-items:center; gap:10px; }
.continue-btn svg { width:16px; height:16px; flex-shrink:0; }
.continue-btn:hover { background:var(--surface-3); }
.continue-btn .lbl { color:var(--text-3); font-size:10px; letter-spacing:1.5px; display:block; }
.continue-btn .pt { color:var(--accent); display:block; margin-top:2px; }
@media (max-width:600px) { .continue-btn { bottom:70px; left:12px; padding:8px 12px; font-size:11px; max-width:240px; } }

.recent-panel {position:absolute; top:calc(100% + 6px); right:0; background:var(--surface); border:1px solid var(--accent-2); border-radius:5px; padding:6px; min-width:300px; max-height:400px; overflow-y:auto; box-shadow:0 4px 20px rgba(0,0,0,0.6); display:none; z-index:300;}
.recent-panel.open { display:block; }
.recent-item {padding:8px 10px; border-radius:3px; cursor:pointer; display:flex; gap:10px; align-items:center; font-size:12px; color:var(--text-2); transition:background .1s;}
.recent-item svg { width:12px; height:12px; color:var(--text-3); flex-shrink:0; }
.recent-item:hover { background:var(--surface-3); color:var(--accent); }
.recent-item:hover svg { color:var(--accent); }
.recent-item .pn { color:var(--accent-2); font-size:11px; min-width:32px; letter-spacing:1px; }
.recent-empty { padding:16px; text-align:center; color:var(--text-3); font-size:12px; letter-spacing:1px; }

.sheet-overlay {position:fixed; inset:0; background:rgba(0,0,0,0.95); z-index:5250; display:none; align-items:center; justify-content:center; padding:20px;}
.sheet-overlay.open { display:flex; }
.sheet-box {width:100%; max-width:900px; max-height:90vh; background:var(--surface); border:1px solid var(--accent-2); border-radius:8px; padding:24px; overflow-y:auto; box-shadow:0 0 40px var(--accent-glow);}
.sheet-header {display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; padding-bottom:12px; border-bottom:1px solid var(--border);}
.sheet-header h2 { color:var(--accent); font-size:20px; letter-spacing:2px; display:flex; align-items:center; gap:10px; }
.sheet-header h2 svg { width:20px; height:20px; }
.sheet-controls { display:flex; gap:8px; }
.sheet-section { margin-bottom:24px; }
.sheet-section h3 {color:var(--accent-2); font-size:14px; letter-spacing:1.5px; margin-bottom:10px; padding-bottom:6px; border-bottom:1px dashed var(--border-2);}
.sheet-formula {padding:8px 12px; margin-bottom:4px; background:var(--surface-2); border-left:2px solid var(--accent-dim); font-family:'JetBrains Mono', monospace; font-size:13px; color:var(--text); line-height:1.6; white-space:pre-wrap;}
.sheet-formula .source { color:var(--text-3); font-size:10px; margin-left:8px; cursor:pointer; }
.sheet-formula .source:hover { color:var(--accent); }
@media print {
  body * { visibility:hidden; }
  .sheet-overlay, .sheet-overlay *, .sheet-box, .sheet-box * { visibility:visible; }
  .sheet-overlay { position:absolute; inset:0; background:#fff; }
  .sheet-box { color:#000; background:#fff; border:none; box-shadow:none; }
  .sheet-controls, .pm-btn { display:none!important; }
  .sheet-formula { background:#f5f5f5; color:#000; }
}

.plog-overlay {position:fixed; inset:0; background:rgba(0,0,0,0.9); z-index:5220; display:none; align-items:center; justify-content:center; padding:24px;}
.plog-overlay.open { display:flex; }
.plog-box {width:100%; max-width:850px; max-height:90vh; background:var(--surface); border:1px solid var(--accent-2); border-radius:8px; padding:24px; overflow-y:auto; box-shadow:0 0 40px var(--accent-glow);}
.plog-form {display:grid; grid-template-columns:1fr 1fr auto; gap:8px; margin-bottom:20px; padding:14px; background:var(--surface-2); border-radius:5px;}
.plog-form input, .plog-form select {background:var(--surface); border:1px solid var(--border-2); color:var(--text); font-family:inherit; font-size:13px; padding:6px 10px; border-radius:3px; outline:none;}
.plog-form input:focus, .plog-form select:focus { border-color:var(--accent); }
.plog-entry {display:flex; gap:12px; padding:10px 14px; background:var(--surface-2); border:1px solid var(--border-2); border-radius:4px; margin-bottom:6px; font-size:13px; align-items:center;}
.plog-entry .status {padding:3px 8px; border-radius:3px; font-size:11px; letter-spacing:1px; display:flex; align-items:center; gap:5px;}
.plog-entry .status svg { width:12px; height:12px; }
.plog-entry .status.solved { background:#0a3a0a; color:#7dff7d; }
.plog-entry .status.partial { background:#3a3a0a; color:var(--warn); }
.plog-entry .status.failed { background:#3a0a0a; color:var(--danger); }
.plog-entry .info { flex:1; min-width:0; }
.plog-entry .del {background:transparent; border:1px solid var(--border-2); color:var(--text-3); cursor:pointer; padding:4px; border-radius:3px; display:flex;}
.plog-entry .del svg { width:12px; height:12px; }
.plog-entry .del:hover { color:var(--danger); border-color:var(--danger); }

