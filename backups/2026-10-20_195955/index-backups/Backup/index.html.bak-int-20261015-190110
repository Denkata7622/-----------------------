    tasks:[
      { label:"ОИ 2017/11 кл, Зад 2 (Ортоцентрични конфигурации)", pdf:"Задачи_Минали_Години/Областен/OLI-2-Областен кръг-2017-11 кл-probs", page:1, difficulty:5, requires_also:["1.2","1.5","1.8"] },
