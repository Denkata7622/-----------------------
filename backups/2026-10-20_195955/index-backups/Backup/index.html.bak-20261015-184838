      { label:"ОИ 2019/10 кл, Зад 1 (Радикално с параметър)", pdf:"Задачи_Минали_Години/Областен/OLI-2-Областен кръг-2019-10 кл-probs", page:1, difficulty:3, requires_also:["5.11","5.4"] },
