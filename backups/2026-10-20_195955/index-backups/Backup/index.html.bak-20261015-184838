      { label:"ОИ 2024/11 кл, Зад 4 (Двойно броене + AM-GM)", pdf:"Задачи_Минали_Години/Областен/OLI-2-Областен кръг-2024-11 кл-probs", page:1, difficulty:3, requires_also:["6.1"] },
