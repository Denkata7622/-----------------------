      { label:"ОИ 2024/10 кл, Зад 1 (АП и ГП)", pdf:"Задачи_Минали_Години/Областен/OLI-2-Областен кръг-2024-10 кл-probs", page:1, difficulty:2, requires_also:["7.6","5.4"] },
      { label:"ОИ 2024/11 кл, Зад 1 (Реципрочни уравнения)", pdf:"Задачи_Минали_Години/Областен/OLI-2-Областен кръг-2024-11 кл-probs", page:1, difficulty:3, requires_also:["5.12","5.3"] },
