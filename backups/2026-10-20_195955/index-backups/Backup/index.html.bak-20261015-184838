.milestones-list { display: flex; flex-direction: column; gap: 6px; }
.ms-item { display: flex; align-items: center; gap: 12px; padding: 10px 14px; background: var(--surface-2); border: 1px solid var(--border-2); border-radius: 5px; font-size: 13px; opacity: .55; transition: all .15s; }
.ms-item.done { opacity: 1; border-color: var(--accent); background: linear-gradient(90deg, var(--surface-2), rgba(0,255,68,.05)); }
.ms-check { color: var(--text-3); display: flex; }
.ms-item.done .ms-check { color: var(--accent); }
.ms-check svg { width: 16px; height: 16px; }
.ms-icon { color: var(--text-3); display: flex; }
.ms-item.done .ms-icon { color: var(--accent); }
.ms-icon svg { width: 16px; height: 16px; }
.ms-name { flex: 1; color: var(--text-2); letter-spacing: 1px; }
.ms-item.done .ms-name { color: var(--accent); }
.ms-days { color: var(--text-3); font-size: 11px; letter-spacing: 1px; }
.prog-goal-hero { display: flex; justify-content: center; padding: 20px 0 30px; }
.pgh-ring { width: 180px; height: 180px; border-radius: 50%; background: conic-gradient(var(--accent) var(--pct, 0%), var(--surface-4) 0); display: flex; align-items: center; justify-content: center; position: relative; box-shadow: 0 0 30px var(--accent-glow); }
.pgh-ring::before { content: ""; position: absolute; inset: 12px; border-radius: 50%; background: var(--surface); }
.pgh-inner { position: relative; z-index: 1; text-align: center; }
.pgh-pct { color: var(--accent); font-size: 38px; line-height: 1; text-shadow: 0 0 12px var(--accent-glow); }
.pgh-min { color: var(--text-2); font-size: 14px; margin-top: 4px; }
.pgh-lbl { color: var(--text-3); font-size: 9px; letter-spacing: 2px; margin-top: 2px; }
.bars14 { display: grid; grid-template-columns: repeat(14, 1fr); gap: 4px; padding: 14px; background: var(--surface-2); border: 1px solid var(--border-2); border-radius: 5px; height: 160px; }
.bar-col { display: flex; flex-direction: column; gap: 4px; }
.bar-track { flex: 1; background: var(--surface-4); border-radius: 3px; overflow: hidden; position: relative; display: flex; align-items: flex-end; }
.bar-fill { width: 100%; background: linear-gradient(180deg, var(--accent-2), var(--accent)); border-radius: 3px; box-shadow: 0 0 6px var(--accent-glow); transition: height .3s; }
.bar-fill.goal { background: linear-gradient(180deg, #4dff4d, #00ff44); box-shadow: 0 0 10px var(--accent-glow); }
.bar-day { color: var(--text-3); font-size: 10px; text-align: center; letter-spacing: .5px; }
.goal-setter { display: flex; align-items: center; gap: 10px; padding: 14px; background: var(--surface-2); border: 1px solid var(--border-2); border-radius: 5px; }
.goal-setter input { width: 100px; padding: 8px 12px; background: var(--surface); border: 1px solid var(--border-2); color: var(--accent); font-family: 'JetBrains Mono', monospace; font-size: 20px; text-align: center; border-radius: 4px; outline: none; letter-spacing: 1px; }
.goal-setter input:focus { border-color: var(--accent); box-shadow: 0 0 8px var(--accent-glow); }
.gs-lbl { flex: 1; color: var(--text-3); font-size: 11px; letter-spacing: 2px; }
@media (max-width: 600px) {
  .prog-stats-row { grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .ps-val { font-size: 17px; }
  .psh-num { font-size: 56px; }
  .pgh-ring { width: 140px; height: 140px; }
  .bars14 { height: 120px; padding: 8px; gap: 2px; }
}

/* ═══════════════════════════════════════════════════════════════
   PDF FOCUS TOOLBAR (v6.2)
   ═══════════════════════════════════════════════════════════════ */
.pdf-side-tools {
  position: fixed;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  display: none;
  flex-direction: column;
  gap: 4px;
  padding: 6px;
  background: rgba(0,0,0,.82);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid var(--accent-2);
  border-radius: 12px;
  box-shadow: 0 0 30px var(--accent-glow), 0 6px 16px rgba(0,0,0,.5);
  z-index: 5200;
  opacity: 0.42;
  transition: opacity .25s, transform .25s;
  pointer-events: none;
}
#pointModal.pdf-focus .pdf-side-tools { display: flex; pointer-events: auto; }
.pdf-side-tools:hover { opacity: 1; transform: translateY(-50%) scale(1.02); }
.pdf-side-tools button {
  width: 40px; height: 40px;
  background: transparent; border: 1px solid transparent;
  color: var(--text-2); cursor: pointer; border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  transition: all .15s; font-family: inherit;
}
.pdf-side-tools button:hover { background: var(--accent); color: #000; border-color: var(--accent); transform: scale(1.08); box-shadow: 0 0 12px var(--accent-glow); }
.pdf-side-tools button:active { transform: scale(0.95); }
.pdf-side-tools button svg { width: 18px; height: 18px; }
.pst-sep { height: 1px; background: var(--border-2); margin: 3px 6px; }
.pdf-pomo {
  position: fixed; bottom: 18px; left: 18px;
  display: none; align-items: center; gap: 8px;
  padding: 8px 14px;
  background: rgba(0,0,0,.82);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid var(--accent-2);
  border-radius: 10px;
  color: var(--accent); font-size: 18px; letter-spacing: 1.5px;
  cursor: pointer; z-index: 5200;
  box-shadow: 0 0 20px var(--accent-glow), 0 4px 12px rgba(0,0,0,.5);
  opacity: 0.5;
  transition: opacity .2s, transform .15s;
  font-family: 'JetBrains Mono', monospace;
  user-select: none;
}
#pointModal.pdf-focus .pdf-pomo { display: flex; }
.pdf-pomo:hover { opacity: 1; transform: scale(1.06); }
.pdf-pomo svg { width: 16px; height: 16px; }
.pdf-pomo.running { border-color: var(--accent); animation: pulse-live 2s ease-in-out infinite; }
@media (max-width: 700px) {
  .pdf-side-tools { left: 8px; padding: 4px; gap: 2px; }
  .pdf-side-tools button { width: 34px; height: 34px; }
  .pdf-side-tools button svg { width: 15px; height: 15px; }
  .pdf-pomo { bottom: 10px; left: 10px; font-size: 15px; padding: 6px 10px; }
}

/* ═══ DEEP DIVE MODAL ═══ */
.deepdive-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.97);
  backdrop-filter: blur(10px);
  z-index: 5550;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 16px;
}
.deepdive-overlay.open { display: flex; }
.deepdive-box {
  width: 100%; max-width: 900px;
  height: 100%; max-height: calc(100vh - 32px);
  background: var(--surface);
  border: 1px solid var(--accent-2);
  border-radius: 10px;
  box-shadow: 0 0 60px var(--accent-glow);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}
.deepdive-header {
  padding: 16px 24px;
  background: var(--surface-2);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: flex-start;
  gap: 16px;
}
.deepdive-title-area { flex: 1; min-width: 0; }
.deepdive-id { font-size: 11px; letter-spacing: 2px; color: var(--text-3); margin-bottom: 4px; }
.deepdive-title { font-size: 22px; color: var(--accent); letter-spacing: 1px; margin: 0 0 6px 0; text-shadow: 0 0 8px var(--accent-glow); }
.deepdive-meta { font-size: 11px; color: var(--text-3); letter-spacing: 1px; display: flex; gap: 12px; flex-wrap: wrap; }
.deepdive-meta .tag { padding: 2px 8px; background: var(--surface-3); border-radius: 3px; border: 1px solid var(--border-2); }
.deepdive-actions { display: flex; gap: 6px; flex-shrink: 0; }
.deepdive-progress { height: 2px; background: var(--surface-4); position: relative; }
.deepdive-progress-fill { height: 100%; width: 0%; background: var(--accent); box-shadow: 0 0 8px var(--accent-glow); transition: width .1s; }
.deepdive-body {
  flex: 1; overflow-y: auto;
  padding: 32px 48px 80px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 15px; line-height: 1.75;
  color: var(--text); scroll-behavior: smooth;
}
.deepdive-body::-webkit-scrollbar { width: 10px; }
.deepdive-body::-webkit-scrollbar-thumb { background: var(--border-2); border-radius: 5px; }
.deepdive-body h2 {
  color: var(--accent); font-size: 20px; letter-spacing: 1.5px;
  margin: 36px 0 14px; padding-bottom: 8px;
  border-bottom: 1px solid var(--border-2);
  text-shadow: 0 0 6px var(--accent-glow);
}
.deepdive-body h2:first-child { margin-top: 0; }
.deepdive-body h3 { color: var(--accent-2); font-size: 16px; letter-spacing: 1px; margin: 24px 0 10px; }
.deepdive-body p { margin-bottom: 14px; }
.deepdive-body ul, .deepdive-body ol { margin: 12px 0 18px 24px; }
.deepdive-body li { margin-bottom: 6px; }
.deepdive-body strong { color: var(--accent); }
.deepdive-body em { color: var(--text-2); }
.deepdive-body code { background: var(--surface-3); border: 1px solid var(--border-2); padding: 1px 6px; border-radius: 3px; font-size: 13px; color: var(--warn); }
.deepdive-body pre { background: var(--surface-2); border-left: 3px solid var(--accent-dim); padding: 12px 16px; border-radius: 4px; overflow-x: auto; margin: 14px 0; }
.deepdive-body blockquote { border-left: 3px solid var(--accent); padding: 8px 16px; margin: 14px 0; color: var(--text-2); background: var(--surface-2); border-radius: 0 4px 4px 0; }
.deepdive-body table { width: 100%; border-collapse: collapse; margin: 16px 0; }
.deepdive-body th, .deepdive-body td { border: 1px solid var(--border-2); padding: 8px 12px; text-align: left; }
.deepdive-body th { background: var(--surface-3); color: var(--accent); }
@media (max-width: 700px) {
  .deepdive-body { padding: 20px 20px 60px; font-size: 14px; }
  .deepdive-header { padding: 12px 16px; }
  .deepdive-title { font-size: 18px; }
}

/* ═══ UNIFIED SCROLLBARS ═══ */
* {
  scrollbar-width: thin;
  scrollbar-color: var(--border-2) var(--surface);
}
*::-webkit-scrollbar { width: 10px; height: 10px; }
*::-webkit-scrollbar-track { background: var(--surface); }
*::-webkit-scrollbar-thumb {
  background: var(--border-2);
  border-radius: 5px;
  border: 2px solid var(--surface);
}
*::-webkit-scrollbar-thumb:hover { background: var(--accent-2); }
*::-webkit-scrollbar-corner { background: var(--surface); }
</style>
</head>

<body>

<div class="app" id="appRoot">
  <!-- ═══ SIDEBAR ═══ -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <span class="lbl">STEPS</span>
      <button class="collapse-btn" onclick="UI.toggleSidebar()" title="Hide">
        <i data-lucide="chevrons-left"></i>
      </button>
    </div>
    <div class="sidebar-stats">
      <!-- Streak — непокътнат, НЕ е clickable -->
      <div class="streak-row">
        <span class="fire"><i data-lucide="flame"></i></span>
        <span class="streak-num" id="streakNum">0</span>
        <span class="streak-label">DAY STREAK</span>
      </div>

      <!-- Daily Goal — clickable -->
      <div class="goal-widget clickable" id="goalWidget" onclick="StatsModal.open('goal')" title="Клик за детайли">
        <div class="goal-row">
          <span>DAILY GOAL</span>
          <span id="goalLabel">0 / 120 MIN</span>
          <span class="click-hint"><i data-lucide="chevron-right"></i></span>
        </div>
        <div class="goal-bar"><div class="goal-fill" id="goalFill" style="width:0%"></div></div>
      </div>

      <!-- Calendar (green squares) — clickable -->
      <div class="calendar-widget clickable" id="calendarWidget" onclick="StatsModal.open('streak')" title="Клик за детайли">
        <div class="calendar-label">
          <span>LAST 30 DAYS</span>
          <span id="calTotal">0h</span>
          <span class="click-hint"><i data-lucide="chevron-right"></i></span>
        </div>
        <div class="calendar-grid" id="calendarGrid"></div>
      </div>
    </div>
    <div class="sidebar-nav" id="sidebarNav"></div>
  </aside>

  <!-- ═══ MAIN ═══ -->
  <main class="main">
    <!-- TOPBAR -->
    <div class="topbar">
      <button class="menu-toggle" onclick="UI.toggleSidebar()">
        <i data-lucide="menu"></i>
      </button>

      <div class="brand">
        <i data-lucide="terminal"></i>
        <span>PREP TERMINAL</span>
      </div>

      <nav class="main-tabs">
        <button class="main-tab active" data-tab="study" onclick="Tabs.switch('study')">
          <i data-lucide="book-open"></i><span>STUDY</span>
        </button>
        <button class="main-tab" data-tab="plan" onclick="Tabs.switch('plan')">
          <i data-lucide="map"></i><span>PLAN</span>
        </button>
        <button class="main-tab" data-tab="library" onclick="Tabs.switch('library')">
          <i data-lucide="library"></i><span>LIBRARY</span>
        </button>
      </nav>

      <div class="search-wrap" id="searchWrap">
        <span class="icon"><i data-lucide="search"></i></span>
        <input type="text" id="searchInput" placeholder="Search topics, theorems, notes..." autocomplete="off">
        <span class="kbd-hint" id="kbdHint">/</span>
        <div class="search-history" id="searchHistory"></div>
      </div>

      <div class="topbar-actions">
        <div class="icon-group">
          <button class="icon-btn" onclick="Quiz.open()" title="Quiz (Q)">
            <i data-lucide="target"></i>
          </button>
          <button class="icon-btn" onclick="Scratchpad.open()" title="Scratchpad (S)">
            <i data-lucide="pen-tool"></i>
          </button>
          <button class="icon-btn" onclick="ExamSim.open()" title="Exam Simulator (X)">
            <i data-lucide="timer"></i>
          </button>
          <button class="icon-btn" onclick="SpacedRep.open()" title="Spaced Repetition (V)">
            <i data-lucide="brain"></i>
          </button>
          <button class="icon-btn" onclick="Focus.toggle()" title="Focus mode (F)">
            <i data-lucide="eye"></i>
          </button>
          <div class="dropdown">
            <button class="icon-btn" onclick="Recent.toggle();event.stopPropagation()" title="Recent (H)">
              <i data-lucide="history"></i>
            </button>
            <div class="recent-panel" id="recentPanel" onclick="event.stopPropagation()"></div>
          </div>
          <button class="icon-btn" onclick="Random.jump()" title="Random point (R)">
            <i data-lucide="dices"></i>
          </button>
        </div>

        <div class="dropdown">
          <button class="icon-btn" id="toolsBtn" onclick="UI.toggleDropdown('toolsDropdown', event)" title="Tools">
            <i data-lucide="hammer"></i>
          </button>
          <div class="dropdown-menu" id="toolsDropdown">
            <button class="dropdown-item" onclick="Achievements.open();UI.closeMenus()">
              <i data-lucide="trophy"></i> Achievements
            </button>
            <button class="dropdown-item" onclick="Formulas.open();UI.closeMenus()">
              <i data-lucide="ruler"></i> Formula Sheet
            </button>
            <button class="dropdown-item" onclick="ProblemLog.open();UI.closeMenus()">
              <i data-lucide="notebook-pen"></i> Problem Log
            </button>
            <button class="dropdown-item" onclick="Report.open();UI.closeMenus()">
              <i data-lucide="bar-chart-3"></i> Weekly Report
            </button>
          </div>
        </div>

        <button class="icon-btn" id="undoBtn" onclick="History.undo()" title="Undo (Ctrl+Z)" style="display:none;position:relative">
          <i data-lucide="undo-2"></i>
          <span class="undo-count" style="position:absolute;top:-4px;right:-4px;background:var(--accent);color:#000;font-size:9px;min-width:14px;height:14px;border-radius:7px;display:flex;align-items:center;justify-content:center;padding:0 3px;font-family:inherit;">0</span>
        </button>
        <div class="dropdown">
          <button class="icon-btn" id="settingsBtn" onclick="UI.toggleDropdown('settingsDropdown', event)" title="Settings">
            <i data-lucide="settings"></i>
          </button>
          <div class="dropdown-menu" id="settingsDropdown">
            <button class="dropdown-item" onclick="event.stopPropagation();Theme.cycle()">
              <i data-lucide="palette"></i> Theme
              <span class="shortcut" id="themeLabel">GREEN</span>
            </button>
            <button class="dropdown-item" onclick="FontSize.cycle();UI.closeMenus()">
              <i data-lucide="type"></i> Font size
              <span class="shortcut" id="fontLabel">NORMAL</span>
            </button>
            <button class="dropdown-item" onclick="UI.toggleScanlines();UI.closeMenus()">
              <i data-lucide="scan-line"></i> Scanlines
              <span class="shortcut" id="scanLabel">OFF</span>
            </button>
            <button class="dropdown-item" onclick="event.stopPropagation();Pomodoro.openSettings()">
              <i data-lucide="timer"></i> Pomodoro timing
              <span class="shortcut" id="pomoLabel">25/5/15</span>
            </button>
            <div class="dropdown-sep"></div>
            <button class="dropdown-item" onclick="Content.expandAll();UI.closeMenus()">
              <i data-lucide="chevrons-down"></i> Expand all
            </button>
            <button class="dropdown-item" onclick="Content.collapseAll();UI.closeMenus()">
              <i data-lucide="chevrons-up"></i> Collapse all
            </button>
            <div class="dropdown-sep"></div>
            <button class="dropdown-item" onclick="ExportNotes.run();UI.closeMenus()">
              <i data-lucide="file-down"></i> Export notes (.md)
            </button>
            <button class="dropdown-item" onclick="Store.exportJSON();UI.closeMenus()">
              <i data-lucide="download"></i> Export JSON
            </button>
            <button class="dropdown-item" onclick="document.getElementById('importFile').click();UI.closeMenus()">
              <i data-lucide="upload"></i> Import JSON
            </button>
            <input type="file" id="importFile" accept=".json" style="display:none" onchange="Store.importJSON(event)">
            <div class="dropdown-sep"></div>
            <button class="dropdown-item" onclick="Palette.open();UI.closeMenus()">
              <i data-lucide="command"></i> Command Palette
              <span class="shortcut">⌘K</span>
            </button>
            <button class="dropdown-item" onclick="Help.open();UI.closeMenus()">
              <i data-lucide="help-circle"></i> Shortcuts
              <span class="shortcut">?</span>
            </button>
            <div class="dropdown-sep"></div>
            <button class="dropdown-item danger" onclick="Store.resetAll();UI.closeMenus()">
              <i data-lucide="trash-2"></i> Reset all
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- SECONDARY BAR (only on Study) -->
    <div class="study-secondary">
      <div class="filter-chips" id="filters">
      <button class="chip active" data-filter="all">ALL <span class="chip-count" data-count="all">0</span></button>
      <button class="chip" data-filter="todo">TO LEARN <span class="chip-count" data-count="todo">0</span></button>
      <button class="chip" data-filter="done">DONE <span class="chip-count" data-count="done">0</span></button>
      <button class="chip" data-filter="fav">STARRED <span class="chip-count" data-count="fav">0</span></button>
      <button class="chip" data-filter="easy">EASY <span class="chip-count" data-count="easy">0</span></button>
      <button class="chip" data-filter="med">MED <span class="chip-count" data-count="med">0</span></button>
      <button class="chip" data-filter="hard">HARD <span class="chip-count" data-count="hard">0</span></button>
    </div>
      <div class="formula-of-day" id="formulaOfDay">
        <span class="lbl">FORMULA:</span>
        <span class="txt" id="fodText" onclick="FormulaOfDay.jump()">—</span>
      </div>
    </div>

    <!-- STUDY VIEW -->
    <div class="content-view" id="view-study">
      <div class="stats-bar">
        <div class="stat"><span class="v" id="statDone">0</span><span class="l">DONE</span></div>
        <div class="stat"><span class="v" id="statTotal">0</span><span class="l">TOTAL</span></div>
        <div class="stat"><span class="v" id="statPercent">0%</span><span class="l">PROGRESS</span></div>
        <div class="stat"><span class="v" id="statPomos">0</span><span class="l">POMODOROS</span></div>
        <div class="progress-wrap"><div class="progress-fill" id="progressFill" style="width:0%"></div></div>
      </div>
      <!-- ═══ TODAY HERO ═══ -->
      <div class="today-hero" id="todayHero">
        <div class="hero-block">
          <div class="hero-icon" id="heroSessionIcon"><i data-lucide="timer"></i></div>
          <div class="hero-info">
            <span class="hero-val" id="heroTodayTime">0м</span>
            <span class="hero-lbl">ДНЕС</span>
          </div>
        </div>
        <div class="hero-quick">
          <button class="q-btn" onclick="Pomodoro.toggle()" title="Pomodoro (T)">
            <i data-lucide="timer"></i>
            <span class="tooltip">Pomodoro</span>
          </button>
          <button class="q-btn" onclick="Quiz.open()" title="Quiz (Q)">
            <i data-lucide="target"></i>
            <span class="tooltip">Quiz</span>
          </button>
          <button class="q-btn" onclick="Random.jump()" title="Random (R)">
            <i data-lucide="dices"></i>
            <span class="tooltip">Random</span>
          </button>
          <button class="q-btn" onclick="Focus.toggle()" title="Focus (F)">
            <i data-lucide="eye"></i>
            <span class="tooltip">Focus</span>
          </button>
        </div>
      </div>
      <div class="content" id="content">
        <div id="stepsContainer"></div>
      </div>
    </div>

    <!-- PLAN VIEW -->
    <div class="content-view hidden" id="view-plan">
      <div class="plan-view" id="planContent"></div>
    </div>

    <!-- LIBRARY VIEW -->
    <div class="content-view hidden" id="view-library">
      <div class="library-view" id="libraryContent"></div>
    </div>
  </main>
</div>

<!-- ═══ POMODORO ═══ -->
<div class="pomodoro" id="pomodoro">
  <div class="pomo-ring"><i data-lucide="timer" style="position:relative;z-index:1;width:14px;height:14px;color:var(--accent)"></i></div>
  <div>
    <div class="time" id="pomoTime">25:00</div>
    <div class="mode" id="pomoMode">FOCUS</div>
  </div>
  <button class="pomo-btn play" id="pomoPlay" onclick="Pomodoro.toggle()" title="Start/Pause (T)">
    <i data-lucide="play"></i>
  </button>
  <button class="pomo-btn" onclick="Pomodoro.reset()" title="Reset">
    <i data-lucide="rotate-ccw"></i>
  </button>
  <div class="pomo-count">
    <div id="pomoDone">0</div>
    <div style="font-size:9px;letter-spacing:1.5px;">SESSIONS</div>
  </div>
