.video-modal-overlay.open{display:flex}
.video-modal{width:100%;max-width:1100px;background:var(--surface);border:1px solid var(--accent-2);border-radius:8px;box-shadow:0 0 60px var(--accent-glow);overflow:hidden;display:flex;flex-direction:column;}
.video-modal-header{padding:12px 18px;background:var(--surface-2);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:12px;}
.video-modal-title{color:var(--accent);font-size:16px;letter-spacing:1px;display:flex;align-items:center;gap:8px}
