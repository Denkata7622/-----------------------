/* ═══════════════════════════════════════════════════════════════
   MODULE: MATH RENDER (KaTeX)
   ═══════════════════════════════════════════════════════════════ */
const MathRender = {
  ready: false,
  init() {
    if (window.renderMathInElement) { this.ready = true; return; }
    let n = 0;
    const t = setInterval(() => {
      if (window.renderMathInElement) { this.ready = true; clearInterval(t); }
      else if (++n > 40) clearInterval(t);
    }, 100);
  },
  apply(root) {
    if (!window.renderMathInElement) return;
    const sel = '.point-desc, .explanation, .pm-desc, .pm-explanation, .sheet-formula, .quiz-question, .quiz-answer, .lib-card .desc, .rep-item .title';
    const nodes = root ? root.querySelectorAll(sel) : document.querySelectorAll(sel);
    nodes.forEach(el => {
      if (el.dataset.mathDone === '1') return;
      try {
        if (!el.querySelector('.katex')) {
          el.dataset.mathDone = '1';
          window.renderMathInElement(el, {
            delimiters: [
              {left:'$$',right:'$$',display:true},
              {left:'$',right:'$',display:false},
              {left:'\\(',right:'\\)',display:false},
              {left:'\\[',right:'\\]',display:true},
            ],
            throwOnError: false,
            ignoredClasses: ['katex'],
          });
        }
      } catch(e) {}
    });
  },
};

