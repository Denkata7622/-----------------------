      { label:"ОИ 2021/10 кл, Зад 1 (Параметрична система)", pdf:"Задачи_Минали_Години/Областен/OLI-2-Областен кръг-2021-10 кл-probs", page:1, difficulty:4, requires_also:["5.4","7.5"] },
      { label:"ОИ 2021/11 кл, Зад 1 (Показателно с параметър)", pdf:"Задачи_Минали_Години/Областен/OLI-2-Областен кръг-2021-11 кл-probs", page:1, difficulty:3, requires_also:["5.4","7.5"] },
      { label:"ОИ 2023/10 кл, Зад 1 (Ирационално уравнение)", pdf:"Задачи_Минали_Години/Областен/OLI-2-Областен кръг-2023-10 кл-probs", page:1, difficulty:2, requires_also:["5.11","7.5"] },
