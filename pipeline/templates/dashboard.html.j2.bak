<!DOCTYPE html>
<html lang="bg">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pipeline · Control</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2322c55e' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M22 12h-4l-3 9L9 3l-3 9H2'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/lucide@0.454.0/dist/umd/lucide.min.js" defer></script>
<style>
:root {
  --bg: #0a0b0e;
  --surface: #0f1115;
  --surface-2: #15181f;
  --surface-3: #1a1e26;
  --border: #1e222c;
  --border-2: #282d38;
  --text: #e8eaed;
  --text-2: #a8adb8;
  --text-3: #6e7480;
  --text-4: #4a505c;
  --accent: #22c55e;
  --accent-soft: rgba(34, 197, 94, 0.12);
  --accent-line: rgba(34, 197, 94, 0.3);
  --danger: #ef4444;
  --danger-soft: rgba(239, 68, 68, 0.12);
  --warn: #f59e0b;
  --warn-soft: rgba(245, 158, 11, 0.12);
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { color-scheme: dark; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Inter', -apple-system, sans-serif;
  font-size: 13px;
  line-height: 1.4;
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}
button { font-family: inherit; }
a { color: inherit; }

/* ─── HEADER ─── */
.hdr {
  height: 48px;
  padding: 0 20px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 14px;
  position: sticky;
  top: 0;
  z-index: 30;
}
.hdr-brand {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
  font-size: 13px;
  letter-spacing: 0.2px;
}
.hdr-brand svg { width: 16px; height: 16px; color: var(--accent); stroke-width: 2.5; }
.hdr-right { margin-left: auto; display: flex; align-items: center; gap: 12px; }

.status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 9px;
  background: var(--surface-2);
  border: 1px solid var(--border-2);
  border-radius: 5px;
  font-size: 11px;
  font-weight: 500;
  color: var(--text-2);
  letter-spacing: 0.3px;
}
.status .dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--text-4);
}
.status.running { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }
.status.running .dot { background: var(--accent); box-shadow: 0 0 6px rgba(34,197,94,0.6); animation: pulse 2s ease-in-out infinite; }
.status.error { color: var(--danger); border-color: rgba(239,68,68,0.3); background: var(--danger-soft); }
.status.error .dot { background: var(--danger); }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.5} }

.hdr-link {
  color: var(--text-3);
  font-size: 11.5px;
  text-decoration: none;
  padding: 5px 10px;
  border-radius: 4px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  transition: all 0.12s;
}
.hdr-link:hover { color: var(--text); background: var(--surface-2); }
.hdr-link svg { width: 12px; height: 12px; }

/* ─── LAYOUT ─── */
.main {
  max-width: 1320px;
  margin: 0 auto;
  padding: 20px 20px 60px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* ─── KPI ─── */
.kpis {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}
.kpi {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 14px 16px;
  min-width: 0;
}
.kpi-h {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  font-weight: 600;
  color: var(--text-3);
  text-transform: uppercase;
  letter-spacing: 0.7px;
  margin-bottom: 8px;
}
.kpi-h svg { width: 11px; height: 11px; stroke-width: 2.5; }
.kpi-v {
  font-family: 'JetBrains Mono', monospace;
  font-size: 24px;
  font-weight: 500;
  line-height: 1.1;
  color: var(--text);
}
.kpi-v.accent { color: var(--accent); }
.kpi-v.warn { color: var(--warn); }
.kpi-v.danger { color: var(--danger); }
.kpi-s {
  font-size: 11px;
  color: var(--text-3);
  margin-top: 4px;
  font-family: 'JetBrains Mono', monospace;
}

/* ─── SECTION ─── */
.section {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
}
.sec-h {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border-bottom: 1px solid var(--border);
  min-height: 40px;
}
.sec-h > svg { width: 13px; height: 13px; color: var(--text-3); }
.sec-t {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-2);
  text-transform: uppercase;
  letter-spacing: 0.7px;
}
.sec-b {
  margin-left: auto;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px;
  color: var(--text-3);
  padding: 2px 7px;
  background: var(--surface-2);
  border-radius: 4px;
  font-weight: 500;
}
.sec-body { padding: 12px 14px; }

/* ─── ORCHESTRATOR ─── */
.orch-row {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.orch-meta {
  margin-left: auto;
  display: flex;
  gap: 16px;
  font-size: 11px;
  color: var(--text-3);
  font-family: 'JetBrains Mono', monospace;
}
.orch-meta strong { color: var(--text-2); font-weight: 500; }
.orch-sep { color: var(--border-2); }

/* ─── BUTTONS ─── */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 32px;
  padding: 0 12px;
  font-size: 12px;
  font-weight: 500;
  color: var(--text-2);
  background: var(--surface-2);
  border: 1px solid var(--border-2);
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.12s;
  white-space: nowrap;
  text-decoration: none;
  line-height: 1;
}
.btn > svg { width: 13px; height: 13px; flex-shrink: 0; }
.btn:hover:not(:disabled) { background: var(--surface-3); color: var(--text); border-color: var(--border-2); }
.btn:active:not(:disabled) { transform: translateY(1px); }
.btn:disabled { opacity: 0.4; cursor: not-allowed; }
.btn.primary { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }
.btn.primary:hover:not(:disabled) { background: var(--accent); color: #052e16; border-color: var(--accent); }
.btn.danger { color: var(--danger); border-color: rgba(239,68,68,0.3); background: var(--danger-soft); }
.btn.danger:hover:not(:disabled) { background: var(--danger); color: #fff; border-color: var(--danger); }
.btn.icon-only { padding: 0; width: 32px; justify-content: center; }
.btn.loading { pointer-events: none; opacity: 0.7; }
.btn.loading > svg { animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ─── INPUT ─── */
.input {
  height: 32px;
  padding: 0 10px;
  font-size: 11.5px;
  font-family: 'JetBrains Mono', monospace;
  color: var(--text);
  background: var(--surface-2);
  border: 1px solid var(--border-2);
  border-radius: 5px;
  outline: none;
  transition: all 0.12s;
  width: 80px;
}
.input:focus { border-color: var(--accent-line); }
.input::placeholder { color: var(--text-4); }

/* ─── GRID LAYOUTS ─── */
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.grid-2 > .section { min-width: 0; }

/* ─── TOOL GRID ─── */
.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 6px;
}
.tool-grid > .btn { justify-content: flex-start; height: 34px; }

/* ─── COSTS TABLE ─── */
.ct {
  width: 100%;
  border-collapse: collapse;
  font-size: 11.5px;
}
.ct thead th {
  text-align: left;
  padding: 7px 10px;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.7px;
  color: var(--text-3);
  border-bottom: 1px solid var(--border);
}
.ct thead th:not(:first-child) { text-align: right; }
.ct tbody td {
  padding: 7px 10px;
  border-bottom: 1px solid var(--border);
  color: var(--text-2);
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
}
.ct tbody td:not(:first-child) { text-align: right; }
.ct tbody td.model { color: var(--text); }
.ct tbody tr:last-child td { border-bottom: none; }
.ct tbody tr:hover { background: var(--surface-2); }
.ct .empty { text-align: center; padding: 24px; color: var(--text-4); font-family: 'Inter', sans-serif; font-size: 11px; }

/* ─── SCORE DIST ─── */
.dist-row { display: flex; align-items: center; gap: 8px; margin-bottom: 5px; font-size: 11px; }
.dist-row:last-child { margin-bottom: 0; }
.dist-l { width: 32px; font-family: 'JetBrains Mono', monospace; color: var(--text-3); font-size: 10.5px; }
.dist-bar { flex: 1; height: 14px; background: var(--surface-2); border-radius: 3px; overflow: hidden; }
.dist-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 3px;
  transition: width 0.3s ease;
}
.dist-c { width: 30px; text-align: right; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--text-3); }

/* ─── QUEUE ─── */
.q-list {
  max-height: 280px;
  overflow-y: auto;
  border-radius: 4px;
}
.q-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 7px 10px;
  font-size: 11.5px;
  border-radius: 4px;
  transition: background 0.1s;
}
.q-row:hover { background: var(--surface-2); }
.q-id {
  font-family: 'JetBrains Mono', monospace;
  color: var(--accent);
  font-size: 10.5px;
  font-weight: 500;
  min-width: 34px;
}
.q-title { flex: 1; color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.q-link {
  color: var(--text-4);
  text-decoration: none;
  padding: 3px;
  border-radius: 3px;
  display: inline-flex;
  transition: all 0.12s;
}
.q-link:hover { color: var(--accent); background: var(--accent-soft); }
.q-link svg { width: 12px; height: 12px; }
.q-empty { padding: 24px; text-align: center; color: var(--text-4); font-size: 11.5px; }

/* ─── LOG ─── */
.log {
  max-height: 340px;
  overflow-y: auto;
  padding: 10px 12px;
  background: #060708;
  border: 1px solid var(--border);
  border-radius: 4px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px;
  line-height: 1.6;
}
.log-row { display: flex; gap: 8px; white-space: pre-wrap; word-break: break-all; }
.log-t { color: var(--text-4); flex-shrink: 0; }
.log-lv { flex-shrink: 0; min-width: 54px; font-weight: 500; }
.log-lv.INFO { color: var(--accent); }
.log-lv.WARNING { color: var(--warn); }
.log-lv.ERROR { color: var(--danger); }
.log-lv.DEBUG { color: var(--text-4); }
.log-m { color: var(--text-2); }
.log-empty { text-align: center; color: var(--text-4); padding: 24px; font-size: 11px; }

/* ─── SCROLLBAR ─── */
* { scrollbar-width: thin; scrollbar-color: var(--border-2) transparent; }
*::-webkit-scrollbar { width: 8px; height: 8px; }
*::-webkit-scrollbar-track { background: transparent; }
*::-webkit-scrollbar-thumb { background: var(--border-2); border-radius: 4px; }
*::-webkit-scrollbar-thumb:hover { background: var(--text-4); }

/* ─── TOAST ─── */
.toast {
  position: fixed;
  bottom: 20px;
  right: 20px;
  min-width: 280px;
  max-width: 460px;
  padding: 12px 14px;
  background: var(--surface);
  border: 1px solid var(--border-2);
  border-left: 3px solid var(--accent);
  border-radius: 6px;
  box-shadow: 0 12px 32px rgba(0,0,0,0.6);
  font-size: 12px;
  color: var(--text);
  display: flex;
  gap: 10px;
  align-items: flex-start;
  opacity: 0;
  transform: translateY(10px);
  pointer-events: none;
  transition: all 0.25s ease;
  z-index: 100;
}
.toast.show { opacity: 1; transform: translateY(0); pointer-events: auto; }
.toast.error { border-left-color: var(--danger); }
.toast svg { width: 15px; height: 15px; flex-shrink: 0; margin-top: 1px; }
.toast.error svg { color: var(--danger); }
.toast:not(.error) svg { color: var(--accent); }
.toast-body { flex: 1; min-width: 0; }
.toast-title { font-weight: 600; font-size: 12px; margin-bottom: 3px; }
.toast-text {
  font-size: 10.5px;
  color: var(--text-3);
  font-family: 'JetBrains Mono', monospace;
  white-space: pre-wrap;
  max-height: 100px;
  overflow-y: auto;
  word-break: break-all;
}

/* ─── RESPONSIVE ─── */
@media (max-width: 900px) {
  .grid-2 { grid-template-columns: 1fr; }
  .kpis { grid-template-columns: repeat(2, 1fr); }
  .orch-meta { width: 100%; margin-left: 0; margin-top: 8px; }
}
@media (max-width: 600px) {
  .main { padding: 12px; }
  .hdr { padding: 0 12px; }
  .tool-grid { grid-template-columns: 1fr; }
  .kpi-v { font-size: 20px; }
}
</style>
</head>
<body>

<!-- HEADER -->
<header class="hdr">
  <div class="hdr-brand">
    <i data-lucide="activity"></i>
    <span>PIPELINE</span>
  </div>
  <div class="hdr-right">
    <div class="status" id="status">
      <span class="dot"></span>
      <span id="statusText">Connecting</span>
    </div>
    <a class="hdr-link" href="/" target="_blank">
      <i data-lucide="arrow-up-right"></i> Site
    </a>
  </div>
</header>

<main class="main">

  <!-- KPIs -->
  <div class="kpis">
    <div class="kpi">
      <div class="kpi-h"><i data-lucide="check-circle-2"></i>Done</div>
      <div class="kpi-v" id="kDone">—</div>
      <div class="kpi-s" id="kDoneSub">of —</div>
    </div>
    <div class="kpi">
      <div class="kpi-h"><i data-lucide="clock"></i>Pending</div>
      <div class="kpi-v warn" id="kPending">—</div>
      <div class="kpi-s" id="kPendingSub">in queue</div>
    </div>
    <div class="kpi">
      <div class="kpi-h"><i data-lucide="trending-up"></i>Avg Score</div>
      <div class="kpi-v accent" id="kScore">—</div>
      <div class="kpi-s" id="kScoreSub">—</div>
    </div>
    <div class="kpi">
      <div class="kpi-h"><i data-lucide="circle-dollar-sign"></i>Spent Today</div>
      <div class="kpi-v" id="kSpent">—</div>
      <div class="kpi-s" id="kSpentSub">of $3.00</div>
    </div>
  </div>

  <!-- ORCHESTRATOR -->
  <section class="section">
    <div class="sec-h">
      <i data-lucide="cpu"></i>
      <span class="sec-t">Orchestrator</span>
      <span class="sec-b" id="orchState">IDLE</span>
    </div>
    <div class="sec-body">
      <div class="orch-row">
        <button class="btn primary" id="btnStart" onclick="onStart(this)">
          <i data-lucide="play"></i> Start
        </button>
        <button class="btn danger" id="btnStop" onclick="onStop(this)" disabled>
          <i data-lucide="square"></i> Stop
        </button>
        <button class="btn" id="btnOnce" onclick="onOnce(this)">
          <i data-lucide="zap"></i> Run Once
        </button>
        <span class="orch-sep">|</span>
        <input type="text" class="input" id="pointInput" placeholder="2.1" title="Point ID">
        <button class="btn" id="btnVerify" onclick="onPointTool(this, 'verify')">
          <i data-lucide="shield-check"></i> Verify
        </button>
        <button class="btn" id="btnRecover" onclick="onPointTool(this, 'recover')">
          <i data-lucide="rotate-ccw"></i> Recover
        </button>
        <div class="orch-meta">
          <span>PID <strong id="mPid">—</strong></span>
          <span>Up <strong id="mUptime">—</strong></span>
        </div>
      </div>
    </div>
  </section>

  <!-- TOOLS + CHUNKER -->
  <div class="grid-2">
    <section class="section">
      <div class="sec-h">
        <i data-lucide="wrench"></i>
        <span class="sec-t">Pipeline Tools</span>
      </div>
      <div class="sec-body">
        <div class="tool-grid">
          <button class="btn" onclick="onTool(this, 'scan-queue')"><i data-lucide="search"></i> Scan Queue</button>
          <button class="btn" onclick="onTool(this, 'pipeline-stats')"><i data-lucide="bar-chart-3"></i> Stats</button>
          <button class="btn" onclick="onTool(this, 'pipeline-report')"><i data-lucide="file-text"></i> Report</button>
          <button class="btn" onclick="onTool(this, 'rebuild-index')"><i data-lucide="refresh-cw"></i> Rebuild</button>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="sec-h">
        <i data-lucide="database"></i>
        <span class="sec-t">Chunker</span>
      </div>
      <div class="sec-body">
        <div class="tool-grid">
          <button class="btn" onclick="onTool(this, 'chunker-audit')"><i data-lucide="scan-line"></i> Audit</button>
          <button class="btn" onclick="onTool(this, 'chunker-merge')"><i data-lucide="git-merge"></i> Merge</button>
          <button class="btn" onclick="onTool(this, 'chunker-aggregate')"><i data-lucide="layers"></i> Aggregate</button>
          <button class="btn" onclick="onChunkerExtract(this)"><i data-lucide="download"></i> Extract</button>
          <button class="btn" onclick="onChunkerClassify(this)"><i data-lucide="brain-circuit"></i> Classify</button>
          <button class="btn" onclick="onFullRefresh(this)"><i data-lucide="refresh-ccw"></i> Full Refresh</button>
        </div>
      </div>
    </section>
  </div>

  <!-- COSTS + SCORES -->
  <div class="grid-2">
    <section class="section">
      <div class="sec-h">
        <i data-lucide="receipt"></i>
        <span class="sec-t">Costs by Model</span>
        <span class="sec-b" id="costsBadge">—</span>
      </div>
      <table class="ct">
        <thead>
          <tr><th>Model</th><th>Calls</th><th>Tokens</th><th>Cost</th></tr>
        </thead>
        <tbody id="costsBody">
          <tr><td colspan="4" class="empty">No data</td></tr>
        </tbody>
      </table>
    </section>

    <section class="section">
      <div class="sec-h">
        <i data-lucide="bar-chart-2"></i>
        <span class="sec-t">Score Distribution</span>
        <span class="sec-b" id="distBadge">—</span>
      </div>
      <div class="sec-body" id="distBody">
        <div style="text-align:center;color:var(--text-4);font-size:11px;padding:16px 0;">No scores</div>
      </div>
    </section>
  </div>

  <!-- QUEUE + LOG -->
  <div class="grid-2">
    <section class="section">
      <div class="sec-h">
        <i data-lucide="list"></i>
        <span class="sec-t">Pending Queue</span>
        <span class="sec-b" id="queueBadge">—</span>
      </div>
      <div class="sec-body">
        <div class="q-list" id="queueList">
          <div class="q-empty">Loading…</div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="sec-h">
        <i data-lucide="terminal"></i>
        <span class="sec-t">Live Log</span>
        <span class="sec-b" id="logBadge">—</span>
      </div>
      <div class="sec-body">
        <div class="log" id="logScroll">
          <div class="log-empty">Loading…</div>
        </div>
      </div>
    </section>
  </div>

</main>

<!-- TOAST -->
<div class="toast" id="toast">
  <i data-lucide="check-circle-2"></i>
  <div class="toast-body">
    <div class="toast-title" id="toastTitle"></div>
    <div class="toast-text" id="toastText"></div>
  </div>
</div>

<script>
// ═══════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════
const $ = id => document.getElementById(id);

function icons() {
  if (!window.lucide || !window.lucide.createIcons) return;
  try { window.lucide.createIcons(); } catch (e) {}
}

function esc(s) {
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function money(n) { return '$' + (Number(n) || 0).toFixed(4); }
function bigNum(n) {
  n = Number(n) || 0;
  if (n >= 1e6) return (n/1e6).toFixed(2) + 'M';
  if (n >= 1e3) return (n/1e3).toFixed(1) + 'K';
  return String(n);
}
function uptime(s) {
  const h = Math.floor(s/3600), m = Math.floor((s%3600)/60), sec = s%60;
  if (h) return `${h}h ${m}m`;
  if (m) return `${m}m ${sec}s`;
  return `${sec}s`;
}

// ═══════════════════════════════════════════════════════════════
// TOAST
// ═══════════════════════════════════════════════════════════════
let _toastTimer = null;
function toast(title, text = '', isError = false, duration = 5000) {
  const el = $('toast');
  $('toastTitle').textContent = title;
  $('toastText').textContent = text || '';
  el.classList.toggle('error', isError);
  el.querySelector('svg')?.remove();
  const icon = document.createElement('i');
  icon.setAttribute('data-lucide', isError ? 'alert-circle' : 'check-circle-2');
  el.insertBefore(icon, el.firstChild);
  icons();
  el.classList.add('show');
  clearTimeout(_toastTimer);
  _toastTimer = setTimeout(() => el.classList.remove('show'), duration);
}

// ═══════════════════════════════════════════════════════════════
// BUTTON LOADING WRAPPER
// ═══════════════════════════════════════════════════════════════
async function withLoading(btn, label, fn) {
  if (!btn) { await fn(); return; }
  const orig = btn.innerHTML;
  btn.classList.add('loading');
  btn.disabled = true;
  btn.innerHTML = `<i data-lucide="loader-2"></i> ${label}`;
  icons();
  try { await fn(); }
  finally {
    btn.classList.remove('loading');
    btn.disabled = false;
    btn.innerHTML = orig;
    icons();
  }
}

// ═══════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════
let _running = false;
let _uptimeBase = null;

// ═══════════════════════════════════════════════════════════════
// REFRESHERS
// ═══════════════════════════════════════════════════════════════
async function fetchState() {
  try {
    const [s, q, t] = await Promise.all([
      fetch('/api/state').then(r => r.json()),
      fetch('/api/queue').then(r => r.json()),
      fetch('/api/costs/today').then(r => r.json()),
    ]);

    // KPIs
    $('kDone').textContent = s.stats.done;
    $('kDoneSub').textContent = `of ${q.total} · ${Math.round(s.stats.done / Math.max(1, q.total) * 100)}%`;
    $('kPending').textContent = q.pending.length;
    $('kPendingSub').textContent = 'in queue';
    $('kScore').textContent = s.stats.scores.avg || '—';
    $('kScoreSub').textContent = s.stats.scores.max ? `${s.stats.scores.min}–${s.stats.scores.max}` : 'no data';
    $('kSpent').textContent = money(t.total);
    const pct = t.total / 3;
    $('kSpent').className = 'kpi-v' + (pct >= 0.9 ? ' danger' : pct >= 0.75 ? ' warn' : '');
    $('kSpentSub').textContent = `of $3.00 · ${t.calls} calls`;

    // Distribution
    const dist = s.stats.scores.distribution || {};
    const keys = Object.keys(dist).map(Number).sort((a, b) => b - a);
    if (!keys.length) {
      $('distBody').innerHTML = '<div style="text-align:center;color:var(--text-4);font-size:11px;padding:16px 0;">No scores</div>';
      $('distBadge').textContent = '—';
    } else {
      const max = Math.max(...Object.values(dist));
      const tot = Object.values(dist).reduce((a, b) => a + b, 0);
      $('distBody').innerHTML = keys.map(sc => {
        const c = dist[sc];
        const w = Math.round(c / max * 100);
        return `<div class="dist-row">
          <span class="dist-l">${sc}/10</span>
          <div class="dist-bar"><div class="dist-fill" style="width:${w}%"></div></div>
          <span class="dist-c">${c}</span>
        </div>`;
      }).join('');
      $('distBadge').textContent = `${tot} articles`;
    }

    // Queue
    $('queueBadge').textContent = `${q.pending.length}/${q.total}`;
    const ql = $('queueList');
    if (!q.pending.length) {
      ql.innerHTML = '<div class="q-empty">Queue is empty</div>';
    } else {
      ql.innerHTML = q.pending.slice(0, 60).map(p =>
        `<div class="q-row">
          <span class="q-id">${esc(p.id)}</span>
          <span class="q-title">${esc(p.title || '')}</span>
          <a class="q-link" href="/article/${esc(p.id)}" target="_blank" title="Open"><i data-lucide="arrow-up-right"></i></a>
        </div>`
      ).join('');
      icons();
    }
  } catch (e) { console.error('fetchState', e); }
}

async function fetchCosts() {
  try {
    const d = await fetch('/api/costs/by-model').then(r => r.json());
    const entries = Object.entries(d).sort((a, b) => b[1].cost - a[1].cost);
    const tb = $('costsBody');
    if (!entries.length) {
      tb.innerHTML = '<tr><td colspan="4" class="empty">No data</td></tr>';
      $('costsBadge').textContent = '—';
      return;
    }
    tb.innerHTML = entries.map(([m, s]) =>
      `<tr>
        <td class="model">${esc(m.split('/').pop())}</td>
        <td>${s.calls}</td>
        <td>${bigNum(s.tokens)}</td>
        <td>${money(s.cost)}</td>
      </tr>`
    ).join('');
    $('costsBadge').textContent = money(entries.reduce((a, [, s]) => a + s.cost, 0));
  } catch (e) { console.error('fetchCosts', e); }
}

async function fetchOrch() {
  try {
    const s = await fetch('/api/orchestrator/status').then(r => r.json());
    _running = s.running;
    const st = $('status');
    st.classList.remove('running', 'error');
    if (s.running) {
      st.classList.add('running');
      $('statusText').textContent = 'Running';
      $('orchState').textContent = 'ACTIVE';
      $('btnStart').disabled = true;
      $('btnStop').disabled = false;
      $('mPid').textContent = s.pid;
      $('mUptime').textContent = uptime(s.uptime_sec || 0);
      _uptimeBase = Date.now() - (s.uptime_sec || 0) * 1000;
    } else {
      $('statusText').textContent = 'Idle';
      $('orchState').textContent = s.exit_code !== undefined ? `EXIT ${s.exit_code}` : 'IDLE';
      $('btnStart').disabled = false;
      $('btnStop').disabled = true;
      $('mPid').textContent = '—';
      $('mUptime').textContent = '—';
      _uptimeBase = null;
    }
  } catch (e) {
    $('status').classList.add('error');
    $('statusText').textContent = 'Offline';
  }
}

async function fetchLog() {
  try {
    const d = await fetch('/api/logs/tail?lines=60').then(r => r.json());
    if (!d.lines?.length) {
      $('logScroll').innerHTML = '<div class="log-empty">No entries</div>';
      $('logBadge').textContent = '—';
      return;
    }
    $('logBadge').textContent = `${d.total}`;
    const html = d.lines.map(line => {
      const m = line.match(/^(\d{4}-\d{2}-\d{2})\s+(\d{2}:\d{2}:\d{2}),\d+\s+\[(\w+)\]\s*(.*)$/s);
      if (!m) return `<div class="log-row"><span class="log-m">${esc(line)}</span></div>`;
      const [, , time, lvl, msg] = m;
      return `<div class="log-row"><span class="log-t">${time}</span><span class="log-lv ${lvl}">${lvl}</span><span class="log-m">${esc(msg)}</span></div>`;
    }).join('');
    const scroll = $('logScroll');
    const atBottom = scroll.scrollHeight - scroll.scrollTop - scroll.clientHeight < 60;
    scroll.innerHTML = html;
    if (atBottom) scroll.scrollTop = scroll.scrollHeight;
  } catch (e) { console.error('fetchLog', e); }
}

setInterval(() => {
  if (_running && _uptimeBase) {
    $('mUptime').textContent = uptime(Math.floor((Date.now() - _uptimeBase) / 1000));
  }
}, 1000);

// ═══════════════════════════════════════════════════════════════
// ACTIONS
// ═══════════════════════════════════════════════════════════════
async function onStart(btn) {
  if (_running) return;
  if (!confirm('Start pipeline in 24/7 mode?\n\nUses daily budget ($3).')) return;
  await withLoading(btn, 'Starting', async () => {
    try {
      const r = await fetch('/api/orchestrator/start', { method: 'POST' });
      const d = await r.json();
      if (r.ok) { toast('Started', `PID ${d.pid}`); await fetchOrch(); }
      else toast('Start failed', d.error || 'Unknown', true);
    } catch (e) { toast('Network error', e.message, true); }
  });
}

async function onStop(btn) {
  if (!_running) return;
  if (!confirm('Stop pipeline?\n\nCurrent article will finish first.')) return;
  await withLoading(btn, 'Stopping', async () => {
    try {
      const r = await fetch('/api/orchestrator/stop', { method: 'POST' });
      if (r.ok) { toast('Stopped'); await fetchOrch(); }
      else { const d = await r.json(); toast('Stop failed', d.error || 'Unknown', true); }
    } catch (e) { toast('Network error', e.message, true); }
  });
}

async function onOnce(btn) {
  const id = prompt('Process one point?\n\nLeave empty for next in queue, or enter ID (e.g. 2.1):', '');
  if (id === null) return;
  await withLoading(btn, 'Running', async () => {
    try {
      const r = await fetch('/api/orchestrator/once', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ point_id: id.trim() || null }),
      });
      const d = await r.json();
      if (d.status === 'completed') toast('Run Once · OK', (d.stdout || '').slice(-400));
      else toast('Run Once · Failed', (d.stderr || d.stdout || '').slice(-400), true);
      await Promise.all([fetchState(), fetchCosts(), fetchLog()]);
    } catch (e) { toast('Network error', e.message, true); }
  });
}

async function onTool(btn, name) {
  await withLoading(btn, 'Running', async () => {
    try {
      const r = await fetch(`/api/tools/${name}`, { method: 'POST' });
      const d = await r.json();
      if (d.status === 'completed') toast(`${name} · OK`, (d.stdout || '').slice(-400));
      else if (d.status === 'skipped') toast(`${name} · Skipped`, d.reason || '', false);
      else toast(`${name} · Failed`, (d.stderr || d.stdout || d.error || '').slice(-400), true);
      await fetchLog();
    } catch (e) { toast('Network error', e.message, true); }
  });
}

async function onPointTool(btn, action) {
  const id = $('pointInput').value.trim();
  if (!id) { toast('Missing ID', 'Type a point ID (e.g. 2.1)', true); $('pointInput').focus(); return; }
  const isV = action === 'verify';
  if (!confirm(`${action.toUpperCase()} ${id}${isV ? ' (~$0.08)' : ''}?`)) return;
  await withLoading(btn, action === 'verify' ? 'Verifying' : 'Recovering', async () => {
    try {
      const r = await fetch(`/api/tools/${action}/${encodeURIComponent(id)}`, { method: 'POST' });
      const d = await r.json();
      if (d.status === 'completed') toast(`${action} ${id} · OK`, (d.stdout || '').slice(-400));
      else toast(`${action} ${id} · Failed`, (d.stderr || d.stdout || d.error || '').slice(-400), true);
      await fetchLog();
    } catch (e) { toast('Network error', e.message, true); }
  });
}

async function onChunkerExtract(btn) {
  const pdf = prompt('PDF pattern\n\nEmpty = all\n"NOM_2015" = one\n"BMO,NOM" = several\n\n:', '');
  if (pdf === null) return;
  const lim = prompt('Limit (max PDFs, empty = none):', '');
  if (lim === null) return;
  const force = confirm('Force extract? (OK = force even if done, Cancel = skip done)');
  if (!confirm(`EXTRACT uses API credits.\n\nPattern: ${pdf || 'all'}\nLimit: ${lim || 'none'}\nForce: ${force ? 'yes' : 'no'}\n\nContinue?`)) return;
  await withLoading(btn, 'Extracting', async () => {
    try {
      const r = await fetch('/api/tools/chunker-extract', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pdf: pdf.trim() || null, limit: lim ? parseInt(lim) : null, force }),
      });
      const d = await r.json();
      if (d.status === 'completed') toast('Extract · OK', (d.stdout || '').slice(-400));
      else toast('Extract · Failed', (d.stderr || d.stdout || d.error || '').slice(-400), true);
      await fetchLog();
    } catch (e) { toast('Network error', e.message, true); }
  });
}

async function onChunkerClassify(btn) {
  const pdf = prompt('PDF pattern (empty = all):', '');
  if (pdf === null) return;
  const force = confirm('Force reclassify? (OK = force, Cancel = skip done)');
  if (!confirm(`CLASSIFY uses API credits.\n\nPattern: ${pdf || 'all'}\nForce: ${force ? 'yes' : 'no'}\n\nContinue?`)) return;
  await withLoading(btn, 'Classifying', async () => {
    try {
      const r = await fetch('/api/tools/chunker-classify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pdf: pdf.trim() || null, force }),
      });
      const d = await r.json();
      if (d.status === 'completed') toast('Classify · OK', (d.stdout || '').slice(-400));
      else toast('Classify · Failed', (d.stderr || d.stdout || d.error || '').slice(-400), true);
      await fetchLog();
    } catch (e) { toast('Network error', e.message, true); }
  });
}

async function onFullRefresh(btn) {
  if (!confirm('FULL REFRESH:\n\n1. merge\n2. classify (API cost)\n3. aggregate\n\nNo extract.\n\nContinue?')) return;
  await withLoading(btn, 'Refreshing', async () => {
    try {
      const r = await fetch('/api/tools/full-refresh', { method: 'POST' });
      const d = await r.json();
      const sum = (d.steps || []).map(s => `${s.name}: ${s.status}`).join('\n');
      toast(`Full Refresh · ${d.status}`, sum, d.status !== 'completed');
      await Promise.all([fetchState(), fetchLog()]);
    } catch (e) { toast('Network error', e.message, true); }
  });
}

// ═══════════════════════════════════════════════════════════════
// BOOT
// ═══════════════════════════════════════════════════════════════
function boot() {
  if (!window.lucide) { setTimeout(boot, 100); return; }
  icons();
  fetchState();
  fetchCosts();
  fetchOrch();
  fetchLog();
  setInterval(() => { fetchState(); fetchCosts(); fetchOrch(); }, 5000);
  setInterval(fetchLog, 4000);
}
document.addEventListener('DOMContentLoaded', boot);
</script>

</body>
</html>