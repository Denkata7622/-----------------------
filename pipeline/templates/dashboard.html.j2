<!-- TOAST -->
<div class="toast" id="toast">
  <i data-lucide="check-circle-2"></i>
  <div class="toast-content">
    <div class="toast-title" id="toastTitle"></div>
    <div class="toast-text" id="toastText"></div>
  </div>
</div>

<script>
// ═══════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════
const $ = id => document.getElementById(id);

function icons() {
  if (window.lucide?.createIcons) {
    try { window.lucide.createIcons(); } catch (e) {}
  }
}
function esc(s) {
  return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function money(n) { return '$' + (Number(n) || 0).toFixed(4); }
function moneyShort(n) {
  n = Number(n) || 0;
  if (n === 0) return '$0';
  if (n < 0.01) return '<$0.01';
  if (n < 1) return '$' + n.toFixed(3);
  return '$' + n.toFixed(2);
}
function bigNum(n) {
  n = Number(n) || 0;
  if (n >= 1e6) return (n/1e6).toFixed(2) + 'M';
  if (n >= 1e3) return (n/1e3).toFixed(1) + 'K';
  return String(n);
}
function uptime(s) {
  const h = Math.floor(s/3600), m = Math.floor((s%3600)/60), sec = s%60;
  if (h) return `${h}h ${m}m`;
  if (m) return `${m}m ${sec}s`;
  return `${sec}s`;
}
function timeAgo(ts) {
  if (!ts) return '—';
  const d = Date.now() - ts * 1000;
  if (d < 60000) return Math.floor(d/1000) + 's';
  if (d < 3600000) return Math.floor(d/60000) + 'm';
  if (d < 86400000) return Math.floor(d/3600000) + 'h';
  return Math.floor(d/86400000) + 'd';
}

// Универсален helper: приема ISO низ, Unix секунди или Unix милисекунди → 'YYYY-MM-DD'
function tsDay(ts) {
  if (!ts) return '';
  if (typeof ts === 'string') {
    if (/^\d{4}-\d{2}-\d{2}/.test(ts)) return ts.slice(0, 10);
    const n = Number(ts);
    if (!isNaN(n)) ts = n;
    else return '';
  }
  if (typeof ts === 'number') {
    // Unix epoch: ако е < 10^11, вероятно секунди; иначе милисекунди
    const ms = ts < 1e11 ? ts * 1000 : ts;
    try { return new Date(ms).toISOString().slice(0, 10); } catch (e) { return ''; }
  }
  return '';
}

// ─── TOAST ───
let _toastTimer = null;
function toast(title, text = '', isError = false, duration = 5000) {
  const el = $('toast');
  $('toastTitle').textContent = title;
  $('toastText').textContent = text || '';
  el.classList.toggle('error', isError);
  el.querySelector('svg')?.remove();
  const icon = document.createElement('i');
  icon.setAttribute('data-lucide', isError ? 'alert-circle' : 'check-circle-2');
  el.insertBefore(icon, el.firstChild);
  icons();
  el.classList.add('show');
  clearTimeout(_toastTimer);
  _toastTimer = setTimeout(() => el.classList.remove('show'), duration);
}

// ─── BUTTON LOADING ───
async function withLoading(el, label, fn) {
  const btn = el?.closest?.('.btn') || (el?.tagName === 'BUTTON' ? el : null);
  if (!btn) { await fn(); return; }
  const orig = btn.innerHTML;
  btn.classList.add('loading');
  btn.disabled = true;
  btn.innerHTML = `<i data-lucide="loader-2"></i> ${label}`;
  icons();
  try { await fn(); }
  finally {
    btn.classList.remove('loading');
    btn.disabled = false;
    btn.innerHTML = orig;
    icons();
  }
}

// ═══════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════
const S = {
  running: false,
  uptimeBase: null,
  articles: [],
  costs: [],
  providerCosts: [],
  queue: { pending: [], total: 0 },
  state: null,
  log: [],
  // articles tab
  artSearch: '',
  artVerdict: 'all',
  artSort: { key: 'ts', desc: true },
  // log tab
  logSearch: '',
  logLevel: 'all',
  logFollow: true,
};

// ═══════════════════════════════════════════════════════════════
// TAB SWITCHING
// ═══════════════════════════════════════════════════════════════
document.querySelectorAll('.tab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    tab.classList.add('active');
    $('tab-' + tab.dataset.tab).classList.add('active');
    // Refresh data for the tab
    if (tab.dataset.tab === 'articles') renderArticlesTab();
    if (tab.dataset.tab === 'costs') renderCostsTab();
    if (tab.dataset.tab === 'logs') renderLogsTab();
    icons();
  });
});

// ═══════════════════════════════════════════════════════════════
// FETCHERS
// ═══════════════════════════════════════════════════════════════
async function fetchAll() {
  await Promise.all([fetchState(), fetchQueue(), fetchCostsAll(), fetchOrch()]);
  renderOverview();
  if (document.querySelector('.tab[data-tab="articles"]').classList.contains('active')) renderArticlesTab();
  if (document.querySelector('.tab[data-tab="costs"]').classList.contains('active')) renderCostsTab();
}

async function fetchState() {
  try {
    S.state = await fetch('/api/state').then(r => r.json());
  } catch (e) { console.error('state', e); }
}

async function fetchQueue() {
  try {
    S.queue = await fetch('/api/queue').then(r => r.json());
  } catch (e) { console.error('queue', e); }
}

async function fetchCostsAll() {
  try {
    S.costs = await fetch('/api/costs/all').then(r => r.json());
  } catch (e) {
    // Fallback to recent
    try {
      S.costs = await fetch('/api/costs/recent?n=500').then(r => r.json());
    } catch (e2) { S.costs = []; }
  }
}

async function fetchOrch() {
  try {
    const d = await fetch('/api/orchestrator/status').then(r => r.json());
    S.running = d.running;
    const st = $('status');
    st.classList.remove('running', 'error');
    if (d.running) {
      st.classList.add('running');
      $('statusText').textContent = 'Running';
      $('btnStart').disabled = true;
      $('btnStop').disabled = false;
      $('mPid').textContent = d.pid;
      $('mUptime').textContent = uptime(d.uptime_sec || 0);
      S.uptimeBase = Date.now() - (d.uptime_sec || 0) * 1000;
    } else {
      $('statusText').textContent = 'Idle';
      $('btnStart').disabled = false;
      $('btnStop').disabled = true;
      $('mPid').textContent = '—';
      $('mUptime').textContent = '—';
      S.uptimeBase = null;
    }
  } catch (e) {
    $('status').classList.add('error');
    $('statusText').textContent = 'Offline';
  }
}

async function fetchArticles() {
  try {
    S.articles = await fetch('/api/articles').then(r => r.json());
  } catch (e) { console.error('articles', e); }
}

async function fetchLog() {
  try {
    const d = await fetch('/api/logs/tail?lines=200').then(r => r.json());
    S.log = d.lines || [];
  } catch (e) { S.log = []; }
}

// ═══════════════════════════════════════════════════════════════
// OVERVIEW RENDER
// ═══════════════════════════════════════════════════════════════
function renderOverview() {
  if (!S.state) return;
  const st = S.state.stats || {};
  const todayKey = new Date().toISOString().slice(0, 10);

  // ── Primary source: combined.json (историческо + live ledger) ──
  const providerCombined = (S.providerCosts && !Array.isArray(S.providerCosts)) ? S.providerCosts : null;
  const liveToday = providerCombined ? (providerCombined.by_day || {})[todayKey] : null;

  // ── Fallback: /api/costs/all (pipeline state.json) — стар източник ──
  const legacyToday = S.costs.filter(c => tsDay(c.ts) === todayKey);
  const legacySpent = legacyToday.reduce((a, c) => a + (c.cost || 0), 0);

  // ── Решение: ако live има данни → ползвай тях; иначе fallback ──
  const todaySpent = (liveToday && liveToday.cost > 0) ? liveToday.cost : legacySpent;
  const todayCalls = (liveToday && liveToday.calls > 0) ? liveToday.calls : legacyToday.length;

  $('kDone').textContent = st.done || 0;
  $('kDoneSub').textContent = `of ${S.queue.total || 0} · ${Math.round((st.done || 0) / Math.max(1, S.queue.total || 1) * 100)}%`;
  $('kPending').textContent = S.queue.pending?.length || 0;
  $('kPendingSub').textContent = 'in queue';
  $('kErrors').textContent = st.error || 0;
  $('kErrorsSub').textContent = st.error ? 'needs attention' : 'all clear';
  $('kScore').textContent = st.scores?.avg || '—';
  $('kScoreSub').textContent = st.scores?.max ? `${st.scores.min}–${st.scores.max} range` : 'no scores';
  $('kSpent').textContent = money(todaySpent);
  const pct = todaySpent / 3;
  $('kSpent').className = 'kpi-v' + (pct >= 0.9 ? ' danger' : pct >= 0.75 ? ' warn' : '');

  // Sub-line: разбивка (live → reasoning/cached, legacy → calls)
  const parts = [`of $3.00`, `${todayCalls} calls`];
  if (liveToday) {
    if (liveToday.reasoning_tokens) parts.push(`${bigNum(liveToday.reasoning_tokens)} reasoning`);
    if (liveToday.cached_tokens)    parts.push(`${bigNum(liveToday.cached_tokens)} cached`);
    const src = (legacySpent > 0 && Math.abs(legacySpent - todaySpent) > 0.005)
      ? ' (live)' : '';
    $('kSpentSub').textContent = parts.join(' · ') + src;
  } else {
    $('kSpentSub').textContent = parts.join(' · ') + (legacySpent > 0 ? '' : ' · ledger stale');
  }

  // Score distribution
  const dist = st.scores?.distribution || {};
  const keys = Object.keys(dist).map(Number).sort((a, b) => b - a);
  if (!keys.length) {
    $('distBody').innerHTML = '<div class="empty"><i data-lucide="bar-chart-2"></i>No scores yet</div>';
    $('distBadge').textContent = '—';
  } else {
    const max = Math.max(...Object.values(dist));
    const tot = Object.values(dist).reduce((a, b) => a + b, 0);
    $('distBody').innerHTML = keys.map(sc => {
      const c = dist[sc];
      const w = Math.round(c / max * 100);
      const cls = sc >= 8 ? 'hi' : sc >= 6 ? 'mid' : sc >= 4 ? 'lo' : 'bad';
      return `<div class="dist-item">
        <span class="dist-label">${sc}/10</span>
        <div class="dist-track"><div class="dist-fill ${cls}" style="width:${w}%"></div></div>
        <span class="dist-count">${c}</span>
      </div>`;
    }).join('');
    $('distBadge').textContent = `${tot} total`;
  }

  // Recent articles (from articles list, but fetchArticles is called separately)
  if (!S.articles || !S.articles.length) {
    fetchArticles().then(() => renderRecentArticles());
  } else {
    renderRecentArticles();
  }

  // Queue preview
  $('queueBadge').textContent = `${S.queue.pending?.length || 0}/${S.queue.total || 0}`;
  if (!S.queue.pending?.length) {
    $('queueTable').querySelector('tbody').innerHTML = '<tr><td colspan="3" class="empty"><i data-lucide="list"></i>Queue empty</td></tr>';
  } else {
    $('queueTable').querySelector('tbody').innerHTML = S.queue.pending.slice(0, 10).map(p =>
      `<tr>
        <td class="mono">${esc(p.id)}</td>
        <td class="text">${esc((p.title || '').slice(0, 50))}</td>
        <td style="text-align:right"><a class="row-action" href="/article/${esc(p.id)}" target="_blank"><i data-lucide="arrow-up-right"></i></a></td>
      </tr>`
    ).join('');
  }

  // Tab badge
  $('tabArticlesBadge').textContent = st.done || 0;
  icons();
}

function renderRecentArticles() {
  const recent = [...S.articles]
    .filter(a => a.status === 'done')
    .sort((a, b) => (b.ts || 0) - (a.ts || 0))
    .slice(0, 10);
  $('recentBadge').textContent = `${S.articles.filter(a => a.status === 'done').length} total`;
  if (!recent.length) {
    $('recentTable').querySelector('tbody').innerHTML = '<tr><td colspan="5" class="empty"><i data-lucide="file-text"></i>No articles yet</td></tr>';
  } else {
    $('recentTable').querySelector('tbody').innerHTML = recent.map(a => {
      const sc = a.score;
      const cls = sc == null ? 's0' : sc >= 8 ? 's8' : sc >= 6 ? 's6' : sc >= 4 ? 's4' : 's0';
      return `<tr>
        <td class="mono">${esc(a.id)}</td>
        <td class="text">${esc((a.title || '').slice(0, 50))}</td>
        <td><span class="score-pill ${cls}">${sc ?? '—'}</span></td>
        <td class="mono">${a.word_count || '—'}</td>
        <td style="text-align:right"><a class="row-action" href="/article/${esc(a.id)}" target="_blank"><i data-lucide="arrow-up-right"></i></a></td>
      </tr>`;
    }).join('');
  }
}

// ═══════════════════════════════════════════════════════════════
// ARTICLES TAB RENDER
// ═══════════════════════════════════════════════════════════════
function renderArticlesTab() {
  if (!S.articles.length) {
    fetchArticles().then(renderArticlesTab);
    return;
  }
  const q = S.artSearch.toLowerCase().trim();
  const filter = S.artVerdict;

  const counts = {
    all: S.articles.length,
    approve: S.articles.filter(a => a.verdict === 'approve').length,
    revise: S.articles.filter(a => a.verdict === 'revise').length,
    reject: S.articles.filter(a => a.verdict === 'reject').length,
    error: S.articles.filter(a => a.status === 'error').length,
  };
  Object.entries(counts).forEach(([k, v]) => {
    const el = document.querySelector(`[data-count="${k}"]`);
    if (el) el.textContent = v;
  });

  let filtered = S.articles.filter(a => {
    if (filter === 'approve' && a.verdict !== 'approve') return false;
    if (filter === 'revise' && a.verdict !== 'revise') return false;
    if (filter === 'reject' && a.verdict !== 'reject') return false;
    if (filter === 'error' && a.status !== 'error') return false;
    if (q) {
      const hay = ((a.id || '') + ' ' + (a.title || '')).toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  });

  const { key, desc } = S.artSort;
  filtered.sort((a, b) => {
    let av = a[key], bv = b[key];
    if (key === 'ts') { av = av || 0; bv = bv || 0; }
    if (av == null) av = -Infinity;
    if (bv == null) bv = -Infinity;
    if (av < bv) return desc ? 1 : -1;
    if (av > bv) return desc ? -1 : 1;
    return 0;
  });

  // Sort indicators
  document.querySelectorAll('.sort-ind').forEach(el => el.textContent = '');
  const ind = document.querySelector(`[data-ind="${key}"]`);
  if (ind) ind.textContent = desc ? '↓' : '↑';

  $('artCount').textContent = `${filtered.length} of ${S.articles.length}`;

  const tb = $('artBody');
  if (!filtered.length) {
    tb.innerHTML = '<tr><td colspan="9" class="empty"><i data-lucide="file-text"></i>No matching articles</td></tr>';
    icons();
    return;
  }
  tb.innerHTML = filtered.map(a => {
    const sc = a.score;
    const scCls = sc == null ? 's0' : sc >= 8 ? 's8' : sc >= 6 ? 's6' : sc >= 4 ? 's4' : 's0';
    const v = a.verdict || a.status || '—';
    return `<tr data-id="${esc(a.id)}">
      <td class="mono">${esc(a.id)}</td>
      <td class="text" title="${esc(a.title || '')}">${esc((a.title || '').slice(0, 55))}</td>
      <td style="text-align:right"><span class="score-pill ${scCls}">${sc ?? '—'}</span></td>
      <td><span class="verdict-pill ${v === 'error' ? 'error' : v}">${v}</span></td>
      <td class="mono" style="text-align:right">${a.word_count || '—'}</td>
      <td class="mono" style="text-align:right">${a.attempts || '—'}</td>
      <td class="mono" style="text-align:right">${a.cost ? moneyShort(a.cost) : '—'}</td>
      <td class="mono" style="text-align:right">${timeAgo(a.ts)}</td>
      <td>
        <div class="row-actions">
          <a class="row-action primary" href="/article/${esc(a.id)}" target="_blank" title="Open"><i data-lucide="arrow-up-right"></i></a>
          <button class="row-action" title="Verify" onclick="quickVerify('${esc(a.id)}', this)"><i data-lucide="shield-check"></i></button>
          <button class="row-action danger" title="Reset" onclick="quickReset('${esc(a.id)}', this)"><i data-lucide="rotate-ccw"></i></button>
        </div>
      </td>
    </tr>`;
  }).join('');
  icons();
}

// ═══════════════════════════════════════════════════════════════
// PROVIDER TAB — fetch + render (combined.json от cost_aggregate.py)
// ═══════════════════════════════════════════════════════════════
async function fetchProviderCosts(force = false) {
  if (!force && S.providerCosts && !Array.isArray(S.providerCosts) && Object.keys(S.providerCosts).length) {
    return;
  }
  const tryUrls = ['/api/costs/combined', '/generated/costs/combined.json', '/combined.json'];
  for (const url of tryUrls) {
    try {
      const r = await fetch(url);
      if (!r.ok) continue;
      const d = await r.json();
      if (d && typeof d === 'object' && !Array.isArray(d)) {
        S.providerCosts = d;
        return;
      }
    } catch (e) { /* next url */ }
  }
  if (!S.providerCosts || Array.isArray(S.providerCosts)) {
    S.providerCosts = {};
  }
}

function renderProviderTab() {
  const data = (S.providerCosts && !Array.isArray(S.providerCosts)) ? S.providerCosts : {};
  const byModel = data.by_model || {};
  const byDay   = data.by_day   || {};
  const byRole  = data.by_role  || {};
  const totals  = data.totals   || {};
  const sources = data.sources  || {historical: 0, live: 0, combined: 0};

  const modelEntries = Object.entries(byModel);
  const dayEntries   = Object.entries(byDay).sort();
  const roleEntries  = Object.entries(byRole);
  const dayKeys      = dayEntries.map(e => e[0]);

  // ── KPIs ──
  $('pTotal').textContent = money(totals.cost || 0);
  $('pTotalSub').textContent = `${sources.historical || 0} hist · ${sources.live || 0} live`;
  $('pCalls').textContent = bigNum(totals.calls || 0);
  $('pCallsSub').textContent = `${modelEntries.length} models`;
  $('pRange').textContent = dayKeys.length ? `${dayKeys[0]} → ${dayKeys[dayKeys.length-1]}` : '—';
  $('pRangeSub').textContent = `${dayKeys.length} days`;
  $('pModels').textContent = modelEntries.length;
  $('pModelsSub').textContent = moneyShort(totals.cost || 0);
  $('pReasoningKpi').textContent = bigNum(totals.reasoning_tokens || 0);
  $('pReasoningSub').textContent = (totals.tokens || 0) > 0
    ? `${((totals.reasoning_tokens || 0) / totals.tokens * 100).toFixed(1)}% of tokens`
    : '—';

  // ── Cost split strip ──
  $('pCostPrompt').textContent = moneyShort(totals.cost_prompt || 0);
  $('pCostCompletion').textContent = moneyShort(totals.cost_completion || 0);
  $('pReasoning').textContent = bigNum(totals.reasoning_tokens || 0);
  $('pCached').textContent = bigNum(totals.cached_tokens || 0);

  // ── By model ──
  $('pByModelBadge').textContent = moneyShort(totals.cost || 0);
  document.querySelector('#pByModelTable tbody').innerHTML = modelEntries.map(([m, s]) =>
    `<tr><td class="mono">${esc(m)}</td>
      <td class="mono" style="text-align:right">${s.calls}</td>
      <td class="mono" style="text-align:right">${bigNum(s.tokens)}</td>
      <td class="mono" style="text-align:right;color:var(--accent)">${s.reasoning_tokens ? bigNum(s.reasoning_tokens) : '—'}</td>
      <td class="mono" style="text-align:right">${moneyShort(s.cost)}</td>
    </tr>`).join('') || '<tr><td colspan="5" class="empty">No data</td></tr>';

  // ── By day ──
  $('pByDayBadge').textContent = `${dayKeys.length} days`;
  document.querySelector('#pByDayTable tbody').innerHTML = [...dayEntries].reverse().map(([d, s]) =>
    `<tr><td class="mono">${esc(d)}</td>
      <td class="mono" style="text-align:right">${s.calls}</td>
      <td class="mono" style="text-align:right">${bigNum(s.tokens)}</td>
      <td class="mono" style="text-align:right;color:var(--accent)">${s.reasoning_tokens ? bigNum(s.reasoning_tokens) : '—'}</td>
      <td class="mono" style="text-align:right">${moneyShort(s.cost)}</td>
    </tr>`).join('') || '<tr><td colspan="5" class="empty">No data</td></tr>';

  // ── By role ──
  if ($('pByRoleTable')) {
    $('pByRoleBadge').textContent = roleEntries.length;
    document.querySelector('#pByRoleTable tbody').innerHTML = roleEntries.map(([r, s]) =>
      `<tr><td class="text">${esc(r)}</td>
        <td class="mono" style="text-align:right">${s.calls}</td>
        <td class="mono" style="text-align:right">${bigNum(s.tokens)}</td>
        <td class="mono" style="text-align:right;color:var(--accent)">${s.reasoning_tokens ? bigNum(s.reasoning_tokens) : '—'}</td>
        <td class="mono" style="text-align:right">${moneyShort(s.cost)}</td>
      </tr>`).join('') || '<tr><td colspan="5" class="empty">No data</td></tr>';
  }

  // ── Timeline ──
  const maxCost = Math.max(...dayEntries.map(e => e[1].cost), 0.001);
  $('pTimeline').innerHTML = dayEntries.map(([d, s]) => {
    const h = Math.max(2, Math.round((s.cost / maxCost) * 100));
    const rs = s.reasoning_tokens ? ` · ${bigNum(s.reasoning_tokens)} reasoning` : '';
    return `<div class="tl-bar" style="height:${h}%" title="${d}: ${money(s.cost)}${rs}"></div>`;
  }).join('');
  $('pTimelineLabels').innerHTML = dayEntries.map(e => `<span>${e[0].slice(5)}</span>`).join('');
  $('pTimelineBadge').textContent = `${dayKeys.length} days · ${moneyShort(totals.cost || 0)}`;
  icons();
}

// ═══════════════════════════════════════════════════════════════
// COSTS TAB RENDER
// ═══════════════════════════════════════════════════════════════
function renderCostsTab() {
  const now = new Date();
  const today = now.toISOString().slice(0, 10);
  const weekAgo = new Date(now.getTime() - 7 * 86400000).toISOString().slice(0, 10);

  // ── Източник 1: combined.json (preferred — granular, с reasoning) ──
  const combined = (S.providerCosts && !Array.isArray(S.providerCosts)) ? S.providerCosts : null;
  const cByDay   = combined ? (combined.by_day   || {}) : {};
  const cByModel = combined ? (combined.by_model || {}) : {};
  const cByRole  = combined ? (combined.by_role  || {}) : {};
  const cTotals  = combined ? (combined.totals   || {}) : {};

  // ── Източник 2: legacy state.json (per-article) — fallback ──
  const legacyByDay = {};
  S.costs.forEach(c => {
    const d = tsDay(c.ts);
    if (!d) return;
    if (!legacyByDay[d]) legacyByDay[d] = { calls: 0, tokens: 0, cost: 0 };
    legacyByDay[d].calls++;
    legacyByDay[d].tokens += c.tokens || 0;
    legacyByDay[d].cost   += c.cost   || 0;
  });

  const hasCombined = Object.keys(cByDay).length > 0;
  const hasLegacy   = Object.keys(legacyByDay).length > 0;

  if (!hasCombined && !hasLegacy) {
    $('cToday').textContent = '$0';
    $('cTodaySub').textContent = '0 calls · ledger stale';
    $('cWeek').textContent = '$0';
    $('cWeekSub').textContent = '0 calls';
    $('cAll').textContent = '$0';
    $('cAllSub').textContent = '0 calls';
    $('byModelTable').querySelector('tbody').innerHTML = '<tr><td colspan="4" class="empty">No data — run cost_aggregate.py</td></tr>';
    $('byRoleTable').querySelector('tbody').innerHTML = '<tr><td colspan="4" class="empty">No data</td></tr>';
    $('recentCallsBody').innerHTML = '<tr><td colspan="6" class="empty">No calls yet</td></tr>';
    return;
  }

  // Обединяваме by_day: ако денят го има в combined → ползваме него; иначе legacy
  const daySet = new Set([...Object.keys(cByDay), ...Object.keys(legacyByDay)]);
  const merged = {};
  daySet.forEach(d => {
    const c = cByDay[d] || null;
    const l = legacyByDay[d] || null;
    // Ако combined има по-голяма стойност (по-пълна) → ползваме нея; иначе legacy
    if (c && c.cost >= (l?.cost || 0)) {
      merged[d] = c;
    } else if (l) {
      merged[d] = l;
    }
  });

  // KPIs
  const todayEntry  = merged[today] || { calls: 0, tokens: 0, cost: 0 };
  const weekTotal   = Object.entries(merged)
    .filter(([d]) => d >= weekAgo)
    .reduce((a, [_, v]) => ({ calls: a.calls + v.calls, tokens: a.tokens + v.tokens, cost: a.cost + v.cost }),
            { calls: 0, tokens: 0, cost: 0 });
  const allTotal    = Object.values(merged).reduce(
    (a, v) => ({ calls: a.calls + v.calls, tokens: a.tokens + v.tokens, cost: a.cost + v.cost }),
    { calls: 0, tokens: 0, cost: 0 }
  );

  $('cToday').textContent = moneyShort(todayEntry.cost);
  $('cTodaySub').textContent = `${todayEntry.calls} calls${todayEntry.reasoning_tokens ? ` · ${bigNum(todayEntry.reasoning_tokens)} reasoning` : ''}`;
  $('cWeek').textContent = moneyShort(weekTotal.cost);
  $('cWeekSub').textContent = `${weekTotal.calls} calls`;
  $('cAll').textContent = moneyShort(allTotal.cost);
  $('cAllSub').textContent = `${allTotal.calls} calls${cTotals.reasoning_tokens ? ` · ${bigNum(cTotals.reasoning_tokens)} reasoning` : ''}`;

  // Timeline (14 дни)
  const days = {};
  for (let i = 13; i >= 0; i--) {
    const d = new Date(now.getTime() - i * 86400000);
    days[d.toISOString().slice(0, 10)] = 0;
  }
  Object.entries(merged).forEach(([d, v]) => {
    if (days[d] !== undefined) days[d] = v.cost;
  });
  const maxCost = Math.max(...Object.values(days), 0.001);
  $('timeline').innerHTML = Object.entries(days).map(([d, v]) => {
    const h = Math.max(2, Math.round((v / maxCost) * 100));
    const cls = v === 0 ? 'zero' : d === today ? 'today' : '';
    return `<div class="tl-bar ${cls}" style="height:${h}%" title="${d}: ${money(v)}"></div>`;
  }).join('');
  $('tlLabels').innerHTML = Object.keys(days).map(d => `<span>${d.split('-')[2]}</span>`).join('');
  $('timelineBadge').textContent = `${Object.keys(days).length} days`;

  // By model — обединяваме combined с legacy (групирано по модел)
  const modelAgg = {};
  Object.entries(cByModel).forEach(([m, s]) => {
    modelAgg[m] = { ...s };
  });
  S.costs.forEach(c => {
    const m = c.model || 'unknown';
    if (!modelAgg[m]) modelAgg[m] = { calls: 0, tokens: 0, cost: 0, reasoning_tokens: 0 };
    modelAgg[m].calls++;
    modelAgg[m].tokens += c.tokens || 0;
    modelAgg[m].cost   += c.cost   || 0;
  });
  const models = Object.entries(modelAgg).sort((a, b) => b[1].cost - a[1].cost);
  $('byModelBadge').textContent = moneyShort(allTotal.cost);
  $('byModelTable').querySelector('tbody').innerHTML = models.length
    ? models.map(([m, s]) =>
        `<tr>
          <td class="mono">${esc(m.split('/').pop())}</td>
          <td class="mono" style="text-align:right">${s.calls}</td>
          <td class="mono" style="text-align:right">${bigNum(s.tokens)}</td>
          <td class="mono" style="text-align:right">${moneyShort(s.cost)}</td>
        </tr>`
      ).join('')
    : '<tr><td colspan="4" class="empty">No data</td></tr>';

  // By role — само combined има role (legacy няма)
  const roles = Object.entries(cByRole).sort((a, b) => b[1].cost - a[1].cost);
  $('byRoleBadge').textContent = roles.length;
  $('byRoleTable').querySelector('tbody').innerHTML = roles.length
    ? roles.map(([r, s]) =>
        `<tr>
          <td class="text">${esc(r)}</td>
          <td class="mono" style="text-align:right">${s.calls}</td>
          <td class="mono" style="text-align:right">${bigNum(s.tokens)}</td>
          <td class="mono" style="text-align:right">${moneyShort(s.cost)}</td>
        </tr>`
      ).join('')
    : '<tr><td colspan="4" class="empty">No data — run cost_aggregate.py</td></tr>';

  // Recent calls — само legacy (per-article). Combined няма per-call records в current format.
  const recent = [...S.costs]
    .sort((a, b) => (b.ts || 0) - (a.ts || 0))
    .slice(0, 100);
  $('recentCallsBadge').textContent = `${recent.length}`;
  $('recentCallsBody').innerHTML = recent.length
    ? recent.map(c => {
        const d = tsDay(c.ts);
        const t = typeof c.ts === 'number'
          ? new Date(c.ts * 1000).toTimeString().slice(0, 8)
          : (c.ts || '').slice(11, 19);
        return `<tr>
          <td class="mono">${esc(t)}</td>
          <td class="mono">${esc(c.item || c.item_id || '—')}</td>
          <td class="text">${esc(c.role || '—')}</td>
          <td class="mono">${esc((c.model || '').split('/').pop())}</td>
          <td class="mono" style="text-align:right">${bigNum(c.tokens || 0)}</td>
          <td class="mono" style="text-align:right">${moneyShort(c.cost || 0)}</td>
        </tr>`;
      }).join('')
    : '<tr><td colspan="6" class="empty">No per-call records (state.json has aggregates only)</td></tr>';
}

// ═══════════════════════════════════════════════════════════════
// LOGS TAB RENDER
// ═══════════════════════════════════════════════════════════════
function renderLogsTab() {
  const q = S.logSearch.toLowerCase();
  const lv = S.logLevel;

  const filtered = S.log.filter(line => {
    if (lv !== 'all' && !line.includes(`[${lv}]`)) return false;
    if (q && !line.toLowerCase().includes(q)) return false;
    return true;
  });

  $('logCount').textContent = `${filtered.length} of ${S.log.length}`;

  const el = $('logFull');
  if (!filtered.length) {
    el.innerHTML = '<div class="empty" style="padding:20px">No matching log lines</div>';
    return;
  }

  const html = filtered.map(line => {
    const m = line.match(/^(\d{4}-\d{2}-\d{2})\s+(\d{2}:\d{2}:\d{2}),\d+\s+\[(\w+)\]\s*(.*)$/s);
    if (!m) return `<div class="log-row"><span class="log-m">${esc(line)}</span></div>`;
    const [, , time, level, msg] = m;
    return `<div class="log-row">
      <span class="log-t">${time}</span>
      <span class="log-lv ${level}">${level}</span>
      <span class="log-m">${esc(msg)}</span>
    </div>`;
  }).join('');

  const wasAtBottom = el.scrollHeight - el.scrollTop - el.clientHeight < 80;
  el.innerHTML = html;
  if (S.logFollow && wasAtBottom) el.scrollTop = el.scrollHeight;
}

// ═══════════════════════════════════════════════════════════════
// OVERVIEW: ACTIVITY LOG
// ═══════════════════════════════════════════════════════════════
function renderActivity() {
  const recent = S.log.slice(-30).reverse();
  if (!recent.length) {
    $('activityLog').innerHTML = '<div class="empty" style="padding:20px 0;font-size:11px">Waiting for log…</div>';
    return;
  }
  $('activityBadge').textContent = `${recent.length} entries`;
  $('activityLog').innerHTML = recent.map(line => {
    const m = line.match(/^(\d{4}-\d{2}-\d{2})\s+(\d{2}:\d{2}:\d{2}),\d+\s+\[(\w+)\]\s*(.*)$/s);
    if (!m) return `<div class="act-row"><span class="act-msg">${esc(line)}</span></div>`;
    const [, , time, level, msg] = m;
    return `<div class="act-row">
      <span class="act-time">${time}</span>
      <span class="act-lv ${level}">${level}</span>
      <span class="act-msg">${esc(msg)}</span>
    </div>`;
  }).join('');
}

// ═══════════════════════════════════════════════════════════════
// ACTIONS
// ═══════════════════════════════════════════════════════════════
async function onStart(btn) {
  if (S.running) return;
  if (!confirm('Start pipeline in 24/7 mode?\n\nUses daily budget ($3).')) return;
  await withLoading(btn, 'Starting', async () => {
    try {
      const r = await fetch('/api/orchestrator/start', { method: 'POST' });
      const d = await r.json();
      if (r.ok) { toast('Started', `PID ${d.pid}`); await fetchOrch(); }
      else toast('Start failed', d.error || 'Unknown', true);
    } catch (e) { toast('Network error', e.message, true); }
  });
}

async function onStop(btn) {
  if (!S.running) return;
  if (!confirm('Stop pipeline?\n\nCurrent article will finish first.')) return;
  await withLoading(btn, 'Stopping', async () => {
    try {
      const r = await fetch('/api/orchestrator/stop', { method: 'POST' });
      if (r.ok) { toast('Stopped'); await fetchOrch(); }
      else { const d = await r.json(); toast('Stop failed', d.error || 'Unknown', true); }
    } catch (e) { toast('Network error', e.message, true); }
  });
}

async function onOnce(btn) {
  const id = prompt('Process one point?\n\nEmpty = next in queue. Or type ID (e.g. 2.1):', '');
  if (id === null) return;
  await withLoading(btn, 'Running', async () => {
    try {
      const r = await fetch('/api/orchestrator/once', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ point_id: id.trim() || null }),
      });
      const d = await r.json();
      if (d.status === 'completed') toast('Run Once · OK', (d.stdout || '').slice(-400));
      else toast('Run Once · Failed', (d.stderr || d.stdout || '').slice(-400), true);
      await fetchAll(); await fetchLog(); renderActivity();
    } catch (e) { toast('Network error', e.message, true); }
  });
}

async function onPointTool(btn, action) {
  const id = $('pointInput').value.trim();
  if (!id) { toast('Missing ID', 'Type e.g. 2.1', true); $('pointInput').focus(); return; }
  await runPointAction(btn, action, id);
}

async function onPointToolFromTools(el, action) {
  const id = prompt(`Point ID for ${action.toUpperCase()}:`, '');
  if (!id) return;
  await runPointAction(el, action, id.trim());
}

async function runPointAction(el, action, id) {
  const isV = action === 'verify';
  if (!confirm(`${action.toUpperCase()} ${id}${isV ? ' (~$0.08)' : ''}?`)) return;
  await withLoading(el, isV ? 'Verifying' : 'Recovering', async () => {
    try {
      const r = await fetch(`/api/tools/${action}/${encodeURIComponent(id)}`, { method: 'POST' });
      const d = await r.json();
      if (d.status === 'completed') toast(`${action} ${id} · OK`, (d.stdout || '').slice(-400));
      else toast(`${action} ${id} · Failed`, (d.stderr || d.stdout || d.error || '').slice(-400), true);
      await fetchAll(); await fetchLog();
    } catch (e) { toast('Network error', e.message, true); }
  });
}

async function quickVerify(id, btn) {
  await runPointAction(btn, 'verify', id);
}

async function quickReset(id, btn) {
  if (!confirm(`Reset ${id}? It will be removed from state.json and re-generated next run.`)) return;
  try {
    const r = await fetch(`/api/orchestrator/reset/${encodeURIComponent(id)}`, { method: 'POST' });
    if (r.ok) {
      toast(`${id} reset`);
      await fetchAll();
    } else {
      toast('Reset failed', 'Not found in state', true);
    }
  } catch (e) { toast('Network error', e.message, true); }
}

async function onTool(el, name) {
  const resultContainer = $('toolResults');
  await withLoading(el, 'Running', async () => {
    try {
      const r = await fetch(`/api/tools/${name}`, { method: 'POST' });
      const d = await r.json();
      showToolResult(resultContainer, name, d);
      await fetchLog();
    } catch (e) {
      showToolResult(resultContainer, name, { status: 'error', error: e.message });
    }
  });
}

async function onChunkerExtract(el) {
  const pdf = prompt('PDF pattern\n\nEmpty = all\n"NOM_2015" = one\n"BMO,NOM" = several\n\n:', '');
  if (pdf === null) return;
  const lim = prompt('Limit (max PDFs, empty = none):', '');
  if (lim === null) return;
  const force = confirm('Force extract? OK = force even if done.');
  if (!confirm(`EXTRACT uses API credits.\n\nPattern: ${pdf || 'all'}\nLimit: ${lim || 'none'}\nForce: ${force ? 'yes' : 'no'}\n\nContinue?`)) return;
  await withLoading(el, 'Extracting', async () => {
    try {
      const r = await fetch('/api/tools/chunker-extract', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pdf: pdf.trim() || null, limit: lim ? parseInt(lim) : null, force }),
      });
      const d = await r.json();
      showToolResult($('toolResults'), 'chunker-extract', d);
      await fetchLog();
    } catch (e) {
      showToolResult($('toolResults'), 'chunker-extract', { status: 'error', error: e.message });
    }
  });
}

async function onChunkerClassify(el) {
  const pdf = prompt('PDF pattern (empty = all):', '');
  if (pdf === null) return;
  const force = confirm('Force reclassify? OK = force.');
  if (!confirm(`CLASSIFY uses API credits.\n\nPattern: ${pdf || 'all'}\nForce: ${force ? 'yes' : 'no'}\n\nContinue?`)) return;
  await withLoading(el, 'Classifying', async () => {
    try {
      const r = await fetch('/api/tools/chunker-classify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pdf: pdf.trim() || null, force }),
      });
      const d = await r.json();
      showToolResult($('toolResults'), 'chunker-classify', d);
      await fetchLog();
    } catch (e) {
      showToolResult($('toolResults'), 'chunker-classify', { status: 'error', error: e.message });
    }
  });
}

async function onFullRefresh(el) {
  if (!confirm('FULL REFRESH:\n\n1. merge\n2. classify (API cost)\n3. aggregate\n\nNo extract.\n\nContinue?')) return;
  await withLoading(el, 'Refreshing', async () => {
    try {
      const r = await fetch('/api/tools/full-refresh', { method: 'POST' });
      const d = await r.json();
      const ok = d.status === 'completed';
      const sum = (d.steps || []).map(s => `${s.name}: ${s.status}`).join('\n');
      showToolResult($('toolResults'), 'full-refresh', {
        status: ok ? 'completed' : 'failed',
        stdout: sum,
        returncode: ok ? 0 : 1,
      });
      await fetchAll(); await fetchLog();
    } catch (e) {
      showToolResult($('toolResults'), 'full-refresh', { status: 'error', error: e.message });
    }
  });
}

async function onRefreshCosts(el) {
  await withLoading(el, 'Refreshing', async () => {
    try {
      // 1. Опитай server endpoint
      const r = await fetch('/api/costs/refresh', { method: 'POST' });
      let d = null;
      if (r.ok) {
        d = await r.json().catch(() => null);
      }
      // 2. Ако няма endpoint → просто re-fetch combined.json
      if (!d || !r.ok) {
        await fetchProviderCosts(true);
        toast('Costs reloaded', 'combined.json re-fetched (no server refresh endpoint)');
      } else {
        toast('Costs refreshed', `${d.entries ?? '?'} entries · $${(d.total ?? 0).toFixed(4)}`);
      }
      // 3. Пре-рендерирай всички изгледи
      renderOverview();
      renderCostsTab();
      renderProviderTab();
    } catch (e) {
      toast('Refresh failed', e.message, true);
    }
  });
}

function showToolResult(container, name, data) {
  const ok = data.status === 'completed';
  const cls = ok ? 'status-ok' : 'status-err';
  const output = data.stdout || data.stderr || data.error || data.reason || '(no output)';
  const html = `
    <div class="tool-result" data-tool="${esc(name)}">
      <div class="tool-result-h">
        <i data-lucide="${ok ? 'check-circle-2' : 'alert-circle'}"></i>
        <span class="${cls}"><strong>${esc(name)}</strong> — ${esc(data.status)}</span>
        <button class="close-r" onclick="this.closest('.tool-result').remove()">
          <i data-lucide="x"></i>
        </button>
      </div>
      <div class="tool-result-b">${esc(output)}</div>
    </div>
  `;
  container.insertAdjacentHTML('afterbegin', html);
  icons();
  toast(`${name} · ${data.status}`, ok ? '' : output.slice(0, 200), !ok);
}

// ═══════════════════════════════════════════════════════════════
// EVENT WIRES
// ═══════════════════════════════════════════════════════════════
// Overview buttons
$('btnStart').addEventListener('click', e => onStart(e.currentTarget));
$('btnStop').addEventListener('click', e => onStop(e.currentTarget));
$('btnOnce').addEventListener('click', e => onOnce(e.currentTarget));
$('btnVerify').addEventListener('click', e => onPointTool(e.currentTarget, 'verify'));
$('btnRecover').addEventListener('click', e => onPointTool(e.currentTarget, 'recover'));

// Articles: search
$('artSearch').addEventListener('input', e => {
  S.artSearch = e.target.value;
  renderArticlesTab();
});

// Articles: chips
$('artChips').addEventListener('click', e => {
  const chip = e.target.closest('.chip');
  if (!chip) return;
  document.querySelectorAll('#artChips .chip').forEach(c => c.classList.remove('active'));
  chip.classList.add('active');
  S.artVerdict = chip.dataset.verdict;
  renderArticlesTab();
});

// Articles: sort headers
document.querySelectorAll('#artTable th.sortable').forEach(th => {
  th.addEventListener('click', () => {
    const k = th.dataset.sort;
    if (S.artSort.key === k) S.artSort.desc = !S.artSort.desc;
    else { S.artSort.key = k; S.artSort.desc = true; }
    renderArticlesTab();
  });
});

// Logs: search
$('logSearch').addEventListener('input', e => {
  S.logSearch = e.target.value;
  renderLogsTab();
});

// Logs: chips
$('logChips').addEventListener('click', e => {
  const chip = e.target.closest('.chip');
  if (!chip) return;
  document.querySelectorAll('#logChips .chip').forEach(c => c.classList.remove('active'));
  chip.classList.add('active');
  S.logLevel = chip.dataset.lv;
  renderLogsTab();
});

// Logs: follow
$('logFollow').addEventListener('change', e => {
  S.logFollow = e.target.checked;
  if (S.logFollow) {
    const el = $('logFull');
    el.scrollTop = el.scrollHeight;
  }
});

// ═══════════════════════════════════════════════════════════════
// POLLING
// ═══════════════════════════════════════════════════════════════
async function refreshLoop() {
  await Promise.all([
    fetchState(),
    fetchQueue(),
    fetchCostsAll(),
    fetchOrch(),
    fetchArticles(),
    fetchProviderCosts(true),   // ← force refresh за live reasoning stats
  ]);
  renderOverview();
  if (document.querySelector('.tab[data-tab="articles"]').classList.contains('active')) renderArticlesTab();
  if (document.querySelector('.tab[data-tab="costs"]').classList.contains('active')) renderCostsTab();
  if (document.querySelector('.tab[data-tab="provider"]').classList.contains('active')) renderProviderTab();
}

async function logLoop() {
  await fetchLog();
  renderActivity();
  if (document.querySelector('.tab[data-tab="logs"]').classList.contains('active')) renderLogsTab();
}

// Live uptime
setInterval(() => {
  if (S.running && S.uptimeBase) {
    $('mUptime').textContent = uptime(Math.floor((Date.now() - S.uptimeBase) / 1000));
  }
}, 1000);

// ═══════════════════════════════════════════════════════════════
// BOOT
// ═══════════════════════════════════════════════════════════════
function boot() {
  if (!window.lucide) { setTimeout(boot, 100); return; }
  icons();
  refreshLoop();
  logLoop();
  setInterval(refreshLoop, 5000);
  setInterval(logLoop, 3000);
  setInterval(icons, 2000);
}
document.addEventListener('DOMContentLoaded', boot);
</script>

</body>
</html>