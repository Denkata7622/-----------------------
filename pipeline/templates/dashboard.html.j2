<!DOCTYPE html>
<html lang="bg">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pipeline · Control Center</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2322c55e' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M22 12h-4l-3 9L9 3l-3 9H2'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/lucide@0.454.0/dist/umd/lucide.min.js" defer></script>
<style>
:root {
  --bg: #0a0b0e;
  --surface: #0f1115;
  --surface-2: #14171d;
  --surface-3: #1a1e26;
  --border: #1c2029;
  --border-2: #262b36;
  --border-3: #343a48;
  --text: #e8eaed;
  --text-2: #a8adb8;
  --text-3: #6e7480;
  --text-4: #4a505c;
  --accent: #22c55e;
  --accent-soft: rgba(34,197,94,0.10);
  --accent-line: rgba(34,197,94,0.28);
  --danger: #ef4444;
  --danger-soft: rgba(239,68,68,0.10);
  --danger-line: rgba(239,68,68,0.28);
  --warn: #f59e0b;
  --warn-soft: rgba(245,158,11,0.10);
  --warn-line: rgba(245,158,11,0.28);
  --info: #3b82f6;
  --info-soft: rgba(59,130,246,0.10);
  --info-line: rgba(59,130,246,0.28);
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { color-scheme: dark; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Inter', -apple-system, sans-serif;
  font-size: 13px;
  line-height: 1.45;
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}
button, input, select, textarea { font-family: inherit; }
button { cursor: pointer; }
a { color: inherit; text-decoration: none; }
.mono { font-family: 'JetBrains Mono', monospace; }
.grow { flex: 1; min-width: 0; }
.hide { display: none !important; }
.sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}

/* ─── HEADER ─── */
.hdr {
  height: 52px;
  padding: 0 20px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 20px;
  position: sticky;
  top: 0;
  z-index: 40;
}
.hdr-brand {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
  font-size: 13px;
  letter-spacing: 0.2px;
  flex-shrink: 0;
}
.hdr-brand svg { width: 16px; height: 16px; color: var(--accent); stroke-width: 2.5; }

.tabs {
  display: flex;
  gap: 2px;
  flex: 1;
  overflow-x: auto;
  scrollbar-width: none;
}
.tabs::-webkit-scrollbar { display: none; }
.tab {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  background: transparent;
  border: none;
  border-radius: 5px;
  font-size: 12px;
  font-weight: 500;
  color: var(--text-3);
  white-space: nowrap;
  transition: all 0.12s;
  position: relative;
}
.tab:hover { color: var(--text-2); background: var(--surface-2); }
.tab.active { color: var(--text); background: var(--surface-2); }
.tab.active::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 12px;
  right: 12px;
  height: 2px;
  background: var(--accent);
  border-radius: 2px;
}
.tab svg { width: 13px; height: 13px; opacity: 0.7; }
.tab.active svg { opacity: 1; color: var(--accent); }
.tab-badge {
  font-size: 10px;
  font-weight: 600;
  padding: 1px 5px;
  background: var(--surface-3);
  color: var(--text-3);
  border-radius: 3px;
  font-family: 'JetBrains Mono', monospace;
  margin-left: 2px;
}

.hdr-right {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}
.status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 9px;
  background: var(--surface-2);
  border: 1px solid var(--border-2);
  border-radius: 5px;
  font-size: 11px;
  font-weight: 500;
  color: var(--text-2);
}
.status .dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--text-4);
}
.status.running { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }
.status.running .dot { background: var(--accent); box-shadow: 0 0 6px rgba(34,197,94,0.5); animation: pulse 2s ease-in-out infinite; }
.status.error { color: var(--danger); border-color: var(--danger-line); background: var(--danger-soft); }
.status.error .dot { background: var(--danger); }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }

.hdr-link {
  color: var(--text-3);
  font-size: 11.5px;
  padding: 5px 10px;
  border-radius: 4px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  transition: all 0.12s;
}
.hdr-link:hover { color: var(--text); background: var(--surface-2); }
.hdr-link svg { width: 12px; height: 12px; }

/* ─── MAIN ─── */
.main {
  max-width: 1700px;
  margin: 0 auto;
  padding: 16px 20px 60px;
}
.tab-panel { display: none; }
.tab-panel.active { display: block; }

/* ─── KPI ROW ─── */
.kpis {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10px;
  margin-bottom: 12px;
}
.kpi {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 12px 14px;
}
.kpi-h {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.7px;
  color: var(--text-3);
  margin-bottom: 6px;
}
.kpi-h svg { width: 11px; height: 11px; stroke-width: 2.5; }
.kpi-v {
  font-family: 'JetBrains Mono', monospace;
  font-size: 22px;
  font-weight: 500;
  line-height: 1.1;
  color: var(--text);
}
.kpi-v.accent { color: var(--accent); }
.kpi-v.warn { color: var(--warn); }
.kpi-v.danger { color: var(--danger); }
.kpi-s {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px;
  color: var(--text-3);
  margin-top: 3px;
}

/* ─── CARD ─── */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.card-h {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border-bottom: 1px solid var(--border);
  min-height: 42px;
  flex-shrink: 0;
}
.card-h > svg { width: 13px; height: 13px; color: var(--text-3); }
.card-title {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.7px;
  color: var(--text-2);
}
.card-badge {
  margin-left: auto;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px;
  color: var(--text-3);
  padding: 2px 7px;
  background: var(--surface-2);
  border-radius: 4px;
  font-weight: 500;
}
.card-body { padding: 12px 14px; flex: 1; min-height: 0; overflow: auto; }
.card-body.flush { padding: 0; }

/* ─── BUTTON ─── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: 30px;
  padding: 0 11px;
  font-size: 11.5px;
  font-weight: 500;
  color: var(--text-2);
  background: var(--surface-2);
  border: 1px solid var(--border-2);
  border-radius: 5px;
  transition: all 0.12s;
  white-space: nowrap;
}
.btn > svg { width: 12px; height: 12px; flex-shrink: 0; }
.btn:hover:not(:disabled) { background: var(--surface-3); color: var(--text); border-color: var(--border-3); }
.btn:active:not(:disabled) { transform: translateY(1px); }
.btn:disabled { opacity: 0.4; cursor: not-allowed; }
.btn.primary { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }
.btn.primary:hover:not(:disabled) { background: var(--accent); color: #052e16; }
.btn.danger { color: var(--danger); border-color: var(--danger-line); background: var(--danger-soft); }
.btn.danger:hover:not(:disabled) { background: var(--danger); color: #fff; }
.btn.icon { padding: 0; width: 30px; }
.btn.loading { pointer-events: none; opacity: 0.6; }
.btn.loading > svg { animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ─── INPUT ─── */
.input {
  height: 30px;
  padding: 0 10px;
  font-size: 11.5px;
  color: var(--text);
  background: var(--surface-2);
  border: 1px solid var(--border-2);
  border-radius: 5px;
  outline: none;
  transition: border-color 0.12s;
  width: 100%;
}
.input.mono { font-family: 'JetBrains Mono', monospace; }
.input:focus { border-color: var(--accent-line); }
.input::placeholder { color: var(--text-4); }

/* ─── LAYOUT GRIDS ─── */
.grid {
  display: grid;
  gap: 12px;
}
.g2 { grid-template-columns: 1fr 1fr; }
.g3 { grid-template-columns: repeat(3, 1fr); }
.g1-2 { grid-template-columns: 1fr 2fr; }
.g2-1 { grid-template-columns: 2fr 1fr; }

/* ─── SCORE DIST ─── */
.dist-item {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 5px;
}
.dist-item:last-child { margin-bottom: 0; }
.dist-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px;
  color: var(--text-3);
  width: 34px;
}
.dist-track {
  flex: 1;
  height: 16px;
  background: var(--surface-2);
  border-radius: 3px;
  overflow: hidden;
}
.dist-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 3px;
  transition: width 0.3s ease;
}
.dist-fill.hi { background: #16a34a; }
.dist-fill.mid { background: var(--accent); }
.dist-fill.lo { background: var(--warn); }
.dist-fill.bad { background: var(--danger); }
.dist-count {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px;
  color: var(--text-3);
  width: 26px;
  text-align: right;
}

/* ─── ACTIVITY LOG (mini) ─── */
.activity {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px;
  line-height: 1.6;
  max-height: 260px;
  overflow-y: auto;
}
.act-row {
  display: flex;
  gap: 8px;
  padding: 1px 0;
  white-space: pre-wrap;
  word-break: break-all;
}
.act-time { color: var(--text-4); flex-shrink: 0; }
.act-lv { flex-shrink: 0; width: 50px; font-weight: 500; }
.act-lv.INFO { color: var(--accent); }
.act-lv.WARNING { color: var(--warn); }
.act-lv.ERROR { color: var(--danger); }
.act-lv.DEBUG { color: var(--text-4); }
.act-msg { color: var(--text-2); }

/* ─── TABLE ─── */
.tbl {
  width: 100%;
  border-collapse: collapse;
  font-size: 11.5px;
}
.tbl thead th {
  text-align: left;
  padding: 8px 10px;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.7px;
  color: var(--text-3);
  border-bottom: 1px solid var(--border);
  background: var(--surface-2);
  position: sticky;
  top: 0;
  z-index: 1;
  white-space: nowrap;
}
.tbl thead th.sortable { cursor: pointer; user-select: none; }
.tbl thead th.sortable:hover { color: var(--text-2); }
.tbl thead th .sort-ind { color: var(--accent); margin-left: 3px; font-size: 9px; }
.tbl tbody td {
  padding: 7px 10px;
  border-bottom: 1px solid var(--border);
  color: var(--text-2);
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  white-space: nowrap;
}
.tbl tbody td.text { font-family: 'Inter', sans-serif; font-size: 11.5px; }
.tbl tbody tr { transition: background 0.08s; }
.tbl tbody tr:hover { background: var(--surface-2); }
.tbl tbody tr:last-child td { border-bottom: none; }

.score-pill {
  display: inline-block;
  padding: 1px 7px;
  border-radius: 3px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px;
  font-weight: 600;
  min-width: 34px;
  text-align: center;
}
.score-pill.s10 { background: var(--accent-soft); color: var(--accent); border: 1px solid var(--accent-line); }
.score-pill.s8 { background: var(--accent-soft); color: var(--accent); border: 1px solid var(--accent-line); }
.score-pill.s6 { background: var(--warn-soft); color: var(--warn); border: 1px solid var(--warn-line); }
.score-pill.s4 { background: var(--danger-soft); color: var(--danger); border: 1px solid var(--danger-line); }
.score-pill.s0 { background: var(--surface-2); color: var(--text-3); border: 1px solid var(--border-2); }

.verdict-pill {
  display: inline-block;
  padding: 1px 7px;
  border-radius: 3px;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}
.verdict-pill.approve { background: var(--accent-soft); color: var(--accent); }
.verdict-pill.revise { background: var(--warn-soft); color: var(--warn); }
.verdict-pill.reject { background: var(--danger-soft); color: var(--danger); }
.verdict-pill.error { background: var(--danger-soft); color: var(--danger); }

.row-actions { display: flex; gap: 3px; justify-content: flex-end; }
.row-action {
  width: 22px;
  height: 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 3px;
  color: var(--text-4);
  transition: all 0.1s;
}
.row-action:hover { color: var(--text); background: var(--surface-2); border-color: var(--border-2); }
.row-action.primary:hover { color: var(--accent); border-color: var(--accent-line); }
.row-action.danger:hover { color: var(--danger); border-color: var(--danger-line); }
.row-action svg { width: 12px; height: 12px; }

/* ─── FILTER BAR ─── */
.filter-bar {
  display: flex;
  gap: 6px;
  margin-bottom: 12px;
  align-items: center;
  flex-wrap: wrap;
}
.filter-bar .input { width: 260px; }
.chips { display: flex; gap: 3px; }
.chip {
  height: 28px;
  padding: 0 10px;
  font-size: 11px;
  font-weight: 500;
  color: var(--text-3);
  background: var(--surface-2);
  border: 1px solid var(--border-2);
  border-radius: 14px;
  transition: all 0.12s;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}
.chip:hover { color: var(--text-2); border-color: var(--border-3); }
.chip.active { background: var(--accent-soft); color: var(--accent); border-color: var(--accent-line); }
.chip-count { font-family: 'JetBrains Mono', monospace; font-size: 10px; opacity: 0.8; }

/* ─── TIMELINE CHART ─── */
.timeline {
  display: flex;
  align-items: flex-end;
  gap: 3px;
  height: 120px;
  padding: 8px 4px;
  border-bottom: 1px solid var(--border);
}
.tl-bar {
  flex: 1;
  min-width: 4px;
  background: var(--accent);
  border-radius: 2px 2px 0 0;
  position: relative;
  transition: all 0.15s;
  opacity: 0.85;
  cursor: default;
}
.tl-bar:hover { opacity: 1; background: #16a34a; }
.tl-bar.today { background: var(--accent); box-shadow: 0 0 6px var(--accent-soft); opacity: 1; }
.tl-bar.zero { background: var(--surface-3); opacity: 0.5; }
.tl-labels {
  display: flex;
  gap: 3px;
  padding: 4px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px;
  color: var(--text-4);
}
.tl-labels > span { flex: 1; min-width: 4px; text-align: center; }

/* ─── LOG FULL ─── */
.log-full {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  line-height: 1.55;
  background: #060708;
  border-radius: 4px;
  padding: 10px 12px;
  max-height: calc(100vh - 260px);
  overflow: auto;
}
.log-row { display: flex; gap: 8px; white-space: pre-wrap; word-break: break-all; padding: 0; }
.log-row:hover { background: rgba(255,255,255,0.02); }
.log-t { color: var(--text-4); flex-shrink: 0; }
.log-lv { flex-shrink: 0; width: 54px; font-weight: 500; }
.log-lv.INFO { color: var(--accent); }
.log-lv.WARNING { color: var(--warn); }
.log-lv.ERROR { color: var(--danger); }
.log-lv.DEBUG { color: var(--text-4); }
.log-m { color: var(--text-2); flex: 1; min-width: 0; }

/* ─── TOOLS ─── */
.tools-groups {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 12px;
}
.tools-group {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
}
.tools-group-h {
  padding: 10px 14px;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.7px;
  color: var(--text-2);
}
.tools-group-h svg { width: 13px; height: 13px; color: var(--text-3); }
.tools-list { padding: 6px; }
.tool-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 8px 10px;
  border-radius: 5px;
  cursor: pointer;
  transition: background 0.1s;
}
.tool-item:hover { background: var(--surface-2); }
.tool-icon {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-2);
  border: 1px solid var(--border-2);
  border-radius: 5px;
  color: var(--text-2);
  flex-shrink: 0;
}
.tool-icon svg { width: 14px; height: 14px; }
.tool-item:hover .tool-icon { color: var(--accent); border-color: var(--accent-line); }
.tool-info { flex: 1; min-width: 0; }
.tool-name {
  font-size: 12px;
  font-weight: 500;
  color: var(--text);
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 2px;
}
.tool-desc { font-size: 11px; color: var(--text-3); line-height: 1.4; }
.tool-cost {
  font-size: 9.5px;
  font-weight: 600;
  padding: 1px 5px;
  border-radius: 3px;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}
.tool-cost.free { background: var(--accent-soft); color: var(--accent); }
.tool-cost.paid { background: var(--warn-soft); color: var(--warn); }

/* ─── TOOL RESULT PANEL ─── */
.tool-result {
  margin-top: 8px;
  background: var(--surface);
  border: 1px solid var(--border-2);
  border-radius: 6px;
  overflow: hidden;
}
.tool-result-h {
  padding: 8px 12px;
  background: var(--surface-2);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
}
.tool-result-h .status-ok { color: var(--accent); }
.tool-result-h .status-err { color: var(--danger); }
.tool-result-h .close-r {
  margin-left: auto;
  background: transparent;
  border: none;
  color: var(--text-3);
  padding: 3px;
  border-radius: 3px;
}
.tool-result-h .close-r:hover { color: var(--text); background: var(--surface-3); }
.tool-result-b {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px;
  line-height: 1.5;
  padding: 10px 12px;
  max-height: 400px;
  overflow: auto;
  white-space: pre-wrap;
  word-break: break-all;
  color: var(--text-2);
  background: #06070a;
}

/* ─── ORCHESTRATOR STRIP ─── */
.orch {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 10px 14px;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.orch-meta {
  margin-left: auto;
  display: flex;
  gap: 16px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px;
  color: var(--text-3);
}
.orch-meta strong { color: var(--text-2); font-weight: 500; }

/* ─── TOAST ─── */
.toast {
  position: fixed;
  bottom: 20px;
  right: 20px;
  min-width: 260px;
  max-width: 500px;
  padding: 11px 14px;
  background: var(--surface);
  border: 1px solid var(--border-2);
  border-left: 3px solid var(--accent);
  border-radius: 6px;
  box-shadow: 0 12px 32px rgba(0,0,0,0.6);
  display: flex;
  gap: 10px;
  align-items: flex-start;
  opacity: 0;
  transform: translateY(10px);
  pointer-events: none;
  transition: all 0.22s ease;
  z-index: 100;
}
.toast.show { opacity: 1; transform: translateY(0); pointer-events: auto; }
.toast.error { border-left-color: var(--danger); }
.toast svg { width: 15px; height: 15px; flex-shrink: 0; margin-top: 1px; }
.toast.error > svg { color: var(--danger); }
.toast:not(.error) > svg { color: var(--accent); }
.toast-content { flex: 1; min-width: 0; }
.toast-title { font-weight: 600; font-size: 12px; margin-bottom: 2px; }
.toast-text {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px;
  color: var(--text-3);
  white-space: pre-wrap;
  max-height: 100px;
  overflow-y: auto;
  word-break: break-all;
}

/* ─── SCROLLBARS ─── */
* { scrollbar-width: thin; scrollbar-color: var(--border-2) transparent; }
*::-webkit-scrollbar { width: 8px; height: 8px; }
*::-webkit-scrollbar-track { background: transparent; }
*::-webkit-scrollbar-thumb { background: var(--border-2); border-radius: 4px; }
*::-webkit-scrollbar-thumb:hover { background: var(--text-4); }

/* ─── EMPTY ─── */
.empty {
  padding: 32px 16px;
  text-align: center;
  color: var(--text-4);
  font-size: 12px;
}
.empty svg { width: 24px; height: 24px; margin-bottom: 8px; opacity: 0.4; display: block; margin-left: auto; margin-right: auto; }

/* ─── RESPONSIVE ─── */
@media (max-width: 1200px) {
  .g3 { grid-template-columns: 1fr 1fr; }
  .g1-2, .g2-1 { grid-template-columns: 1fr; }
}
@media (max-width: 900px) {
  .kpis { grid-template-columns: repeat(2, 1fr); }
  .g2 { grid-template-columns: 1fr; }
  .g3 { grid-template-columns: 1fr; }
  .tabs { font-size: 11px; }
  .tab { padding: 6px 10px; }
  .tab span.tab-label { display: none; }
  .tab svg { width: 15px; height: 15px; }
  .hdr { padding: 0 12px; gap: 10px; }
  .main { padding: 12px; }
  .orch-meta { width: 100%; margin-left: 0; margin-top: 6px; }
  .filter-bar .input { width: 100%; }
}
</style>
</head>
<body>

<!-- ═══ HEADER ═══ -->
<header class="hdr">
  <div class="hdr-brand">
    <i data-lucide="activity"></i>
    <span>PIPELINE</span>
  </div>

  <nav class="tabs" role="tablist">
    <button class="tab active" data-tab="overview" role="tab">
      <i data-lucide="layout-dashboard"></i>
      <span class="tab-label">Overview</span>
    </button>
    <button class="tab" data-tab="articles" role="tab">
      <i data-lucide="file-text"></i>
      <span class="tab-label">Articles</span>
      <span class="tab-badge" id="tabArticlesBadge">—</span>
    </button>
    <button class="tab" data-tab="costs" role="tab">
      <i data-lucide="dollar-sign"></i>
      <span class="tab-label">Costs</span>
    </button>
    <button class="tab" data-tab="provider" role="tab">
      <i data-lucide="cloud"></i>
      <span class="tab-label">Provider</span>
    </button>
    <button class="tab" data-tab="logs" role="tab">
      <i data-lucide="terminal"></i>
      <span class="tab-label">Logs</span>
    </button>
    <button class="tab" data-tab="tools" role="tab">
      <i data-lucide="wrench"></i>
      <span class="tab-label">Tools</span>
    </button>
  </nav>

  <div class="hdr-right">
    <div class="status" id="status">
      <span class="dot"></span>
      <span id="statusText">Connecting</span>
    </div>
    <a class="hdr-link" href="/" target="_blank">
      <i data-lucide="arrow-up-right"></i> Site
    </a>
  </div>
</header>

<!-- ═══ MAIN ═══ -->
<main class="main">

  <!-- ═══ TAB: OVERVIEW ═══ -->
  <section class="tab-panel active" id="tab-overview">

    <!-- Orchestrator strip -->
    <div class="orch">
      <button class="btn primary" id="btnStart" onclick="onStart(this)">
        <i data-lucide="play"></i> Start
      </button>
      <button class="btn danger" id="btnStop" onclick="onStop(this)" disabled>
        <i data-lucide="square"></i> Stop
      </button>
      <button class="btn" id="btnOnce" onclick="onOnce(this)">
        <i data-lucide="zap"></i> Run Once
      </button>
      <span style="width:1px;height:20px;background:var(--border-2);margin:0 4px;"></span>
      <input type="text" class="input mono" id="pointInput" placeholder="2.1" style="width:70px;">
      <button class="btn" id="btnVerify" onclick="onPointTool(this,'verify')">
        <i data-lucide="shield-check"></i> Verify
      </button>
      <button class="btn" id="btnRecover" onclick="onPointTool(this,'recover')">
        <i data-lucide="rotate-ccw"></i> Recover
      </button>
      <div class="orch-meta">
        <span>PID <strong id="mPid">—</strong></span>
        <span>UPTIME <strong id="mUptime">—</strong></span>
      </div>
    </div>

    <!-- KPIs -->
    <div class="kpis">
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="check-circle-2"></i>Done</div>
        <div class="kpi-v" id="kDone">—</div>
        <div class="kpi-s" id="kDoneSub">of —</div>
      </div>
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="clock"></i>Pending</div>
        <div class="kpi-v warn" id="kPending">—</div>
        <div class="kpi-s" id="kPendingSub">in queue</div>
      </div>
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="alert-triangle"></i>Errors</div>
        <div class="kpi-v danger" id="kErrors">—</div>
        <div class="kpi-s" id="kErrorsSub">needs attention</div>
      </div>
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="trending-up"></i>Avg Score</div>
        <div class="kpi-v accent" id="kScore">—</div>
        <div class="kpi-s" id="kScoreSub">—</div>
      </div>
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="circle-dollar-sign"></i>Spent Today</div>
        <div class="kpi-v" id="kSpent">—</div>
        <div class="kpi-s" id="kSpentSub">of $3.00</div>
      </div>
    </div>

    <!-- Row: score dist + activity -->
    <div class="grid g2" style="margin-bottom:12px">
      <div class="card">
        <div class="card-h">
          <i data-lucide="bar-chart-2"></i>
          <span class="card-title">Score Distribution</span>
          <span class="card-badge" id="distBadge">—</span>
        </div>
        <div class="card-body" id="distBody">
          <div class="empty"><i data-lucide="bar-chart-2"></i>No scores yet</div>
        </div>
      </div>

      <div class="card">
        <div class="card-h">
          <i data-lucide="radio"></i>
          <span class="card-title">Live Activity</span>
          <span class="card-badge" id="activityBadge">—</span>
        </div>
        <div class="card-body" style="padding:8px 12px">
          <div class="activity" id="activityLog">
            <div class="empty" style="padding:20px 0;font-size:11px">Waiting for log…</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Row: recent articles + queue preview -->
    <div class="grid g2">
      <div class="card">
        <div class="card-h">
          <i data-lucide="clock"></i>
          <span class="card-title">Recent Articles</span>
          <span class="card-badge" id="recentBadge">—</span>
        </div>
        <div class="card-body flush" style="max-height:280px;overflow:auto">
          <table class="tbl" id="recentTable">
            <thead>
              <tr><th>ID</th><th>Title</th><th>Score</th><th>Words</th><th></th></tr>
            </thead>
            <tbody><tr><td colspan="5" class="empty"><i data-lucide="file-text"></i>No articles yet</td></tr></tbody>
          </table>
        </div>
      </div>

      <div class="card">
        <div class="card-h">
          <i data-lucide="list"></i>
          <span class="card-title">Next in Queue</span>
          <span class="card-badge" id="queueBadge">—</span>
        </div>
        <div class="card-body flush" style="max-height:280px;overflow:auto">
          <table class="tbl" id="queueTable">
            <thead>
              <tr><th>ID</th><th>Title</th><th></th></tr>
            </thead>
            <tbody><tr><td colspan="3" class="empty"><i data-lucide="list"></i>Queue empty</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TAB: ARTICLES ═══ -->
  <section class="tab-panel" id="tab-articles">
    <div class="filter-bar">
      <div class="input-wrap" style="position:relative;flex:1;max-width:340px">
        <input type="text" class="input" id="artSearch" placeholder="Search by ID or title…">
      </div>
      <div class="chips" id="artChips">
        <button class="chip active" data-verdict="all">All <span class="chip-count" data-count="all">0</span></button>
        <button class="chip" data-verdict="approve">Approve <span class="chip-count" data-count="approve">0</span></button>
        <button class="chip" data-verdict="revise">Revise <span class="chip-count" data-count="revise">0</span></button>
        <button class="chip" data-verdict="reject">Reject <span class="chip-count" data-count="reject">0</span></button>
        <button class="chip" data-verdict="error">Error <span class="chip-count" data-count="error">0</span></button>
      </div>
      <span style="margin-left:auto;font-size:11px;color:var(--text-3);font-family:'JetBrains Mono',monospace;" id="artCount">—</span>
    </div>

    <div class="card">
      <div class="card-body flush" style="max-height:calc(100vh - 200px);overflow:auto">
        <table class="tbl" id="artTable">
          <thead>
            <tr>
              <th class="sortable" data-sort="id">ID <span class="sort-ind" data-ind="id"></span></th>
              <th>Title</th>
              <th class="sortable" data-sort="score" style="text-align:right">Score <span class="sort-ind" data-ind="score"></span></th>
              <th>Verdict</th>
              <th class="sortable" data-sort="word_count" style="text-align:right">Words <span class="sort-ind" data-ind="word_count"></span></th>
              <th class="sortable" data-sort="attempts" style="text-align:right">Att <span class="sort-ind" data-ind="attempts"></span></th>
              <th class="sortable" data-sort="cost" style="text-align:right">Cost <span class="sort-ind" data-ind="cost"></span></th>
              <th class="sortable" data-sort="ts" style="text-align:right">When <span class="sort-ind" data-ind="ts"></span></th>
              <th style="text-align:right">Actions</th>
            </tr>
          </thead>
          <tbody id="artBody">
            <tr><td colspan="9" class="empty"><i data-lucide="file-text"></i>Loading…</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ═══ TAB: COSTS ═══ -->
  <section class="tab-panel" id="tab-costs">

    <div class="kpis" style="grid-template-columns:repeat(3,1fr)">
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="sun"></i>Today</div>
        <div class="kpi-v" id="cToday">—</div>
        <div class="kpi-s" id="cTodaySub">— calls</div>
      </div>
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="calendar-days"></i>Last 7 Days</div>
        <div class="kpi-v" id="cWeek">—</div>
        <div class="kpi-s" id="cWeekSub">— calls</div>
      </div>
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="infinity"></i>All Time</div>
        <div class="kpi-v" id="cAll">—</div>
        <div class="kpi-s" id="cAllSub">— calls</div>
      </div>
    </div>

    <div class="card" style="margin-bottom:12px">
      <div class="card-h">
        <i data-lucide="chart-column"></i>
        <span class="card-title">Daily Spend</span>
        <span class="card-badge" id="timelineBadge">Last 14 days</span>
      </div>
      <div class="card-body">
        <div class="timeline" id="timeline"></div>
        <div class="tl-labels" id="tlLabels"></div>
      </div>
    </div>

    <div class="grid g2">
      <div class="card">
        <div class="card-h">
          <i data-lucide="cpu"></i>
          <span class="card-title">By Model</span>
          <span class="card-badge" id="byModelBadge">—</span>
        </div>
        <div class="card-body flush" style="max-height:320px;overflow:auto">
          <table class="tbl" id="byModelTable">
            <thead>
              <tr><th>Model</th><th style="text-align:right">Calls</th><th style="text-align:right">Tokens</th><th style="text-align:right">Cost</th></tr>
            </thead>
            <tbody><tr><td colspan="4" class="empty">No data</td></tr></tbody>
          </table>
        </div>
      </div>

      <div class="card">
        <div class="card-h">
          <i data-lucide="tag"></i>
          <span class="card-title">By Role</span>
          <span class="card-badge" id="byRoleBadge">—</span>
        </div>
        <div class="card-body flush" style="max-height:320px;overflow:auto">
          <table class="tbl" id="byRoleTable">
            <thead>
              <tr><th>Role</th><th style="text-align:right">Calls</th><th style="text-align:right">Tokens</th><th style="text-align:right">Cost</th></tr>
            </thead>
            <tbody><tr><td colspan="4" class="empty">No data</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="card" style="margin-top:12px">
      <div class="card-h">
        <i data-lucide="history"></i>
        <span class="card-title">Recent Calls</span>
        <span class="card-badge" id="recentCallsBadge">—</span>
      </div>
      <div class="card-body flush" style="max-height:400px;overflow:auto">
        <table class="tbl" id="recentCallsTable">
          <thead>
            <tr><th>Time</th><th>Item</th><th>Role</th><th>Model</th><th style="text-align:right">Tokens</th><th style="text-align:right">Cost</th></tr>
          </thead>
          <tbody id="recentCallsBody">
            <tr><td colspan="6" class="empty">No calls yet</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ═══ TAB: PROVIDER ═══ -->
  <section class="tab-panel" id="tab-provider">

    <div class="kpis" style="grid-template-columns:repeat(5,1fr)">
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="dollar-sign"></i>Total</div>
        <div class="kpi-v" id="pTotal">—</div>
        <div class="kpi-s" id="pTotalSub">—</div>
      </div>
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="activity"></i>Calls</div>
        <div class="kpi-v" id="pCalls">—</div>
        <div class="kpi-s" id="pCallsSub">—</div>
      </div>
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="calendar"></i>Range</div>
        <div class="kpi-v" id="pRange" style="font-size:13px">—</div>
        <div class="kpi-s" id="pRangeSub">—</div>
      </div>
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="cpu"></i>Models</div>
        <div class="kpi-v" id="pModels">—</div>
        <div class="kpi-s" id="pModelsSub">—</div>
      </div>
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="brain"></i>Reasoning</div>
        <div class="kpi-v accent" id="pReasoningKpi">—</div>
        <div class="kpi-s" id="pReasoningSub">—</div>
      </div>
    </div>

    <div class="orch" style="margin-bottom:12px;gap:10px">
      <i data-lucide="pie-chart" style="width:14px;height:14px;color:var(--text-3)"></i>
      <span style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.7px;color:var(--text-3)">Cost split</span>
      <span class="mono" style="font-size:10.5px;color:var(--text-4)">prompt</span>
      <span class="mono" style="font-size:12px;color:var(--text)"><strong id="pCostPrompt">—</strong></span>
      <span style="color:var(--text-4)">+</span>
      <span class="mono" style="font-size:10.5px;color:var(--text-4)">completion</span>
      <span class="mono" style="font-size:12px;color:var(--text)"><strong id="pCostCompletion">—</strong></span>
      <span style="width:1px;height:14px;background:var(--border-2);margin:0 4px"></span>
      <span class="mono" style="font-size:10.5px;color:var(--text-4)">reasoning</span>
      <span class="mono" style="font-size:12px;color:var(--accent)"><strong id="pReasoning">—</strong></span>
      <span class="mono" style="font-size:10.5px;color:var(--text-4)">tok</span>
      <span style="color:var(--text-4)">·</span>
      <span class="mono" style="font-size:10.5px;color:var(--text-4)">cached</span>
      <span class="mono" style="font-size:12px;color:var(--text-2)"><strong id="pCached">—</strong></span>
      <span class="mono" style="font-size:10.5px;color:var(--text-4)">tok</span>
    </div>

    <div class="card" style="margin-bottom:12px">
      <div class="card-h">
        <i data-lucide="chart-column"></i>
        <span class="card-title">Provider Daily Spend</span>
        <span class="card-badge" id="pTimelineBadge">—</span>
      </div>
      <div class="card-body">
        <div class="timeline" id="pTimeline"></div>
        <div class="tl-labels" id="pTimelineLabels"></div>
      </div>
    </div>

    <div class="grid g2">
      <div class="card">
        <div class="card-h">
          <i data-lucide="cpu"></i>
          <span class="card-title">By Model</span>
          <span class="card-badge" id="pByModelBadge">—</span>
        </div>
        <div class="card-body flush" style="max-height:420px;overflow:auto">
          <table class="tbl" id="pByModelTable">
            <thead><tr>
              <th>Model</th>
              <th style="text-align:right">Calls</th>
              <th style="text-align:right">Tokens</th>
              <th style="text-align:right">Reasoning</th>
              <th style="text-align:right">Cost</th>
            </tr></thead>
            <tbody><tr><td colspan="5" class="empty">Loading…</td></tr></tbody>
          </table>
        </div>
      </div>

      <div class="card">
        <div class="card-h">
          <i data-lucide="calendar-days"></i>
          <span class="card-title">By Day</span>
          <span class="card-badge" id="pByDayBadge">—</span>
        </div>
        <div class="card-body flush" style="max-height:420px;overflow:auto">
          <table class="tbl" id="pByDayTable">
            <thead><tr>
              <th>Day</th>
              <th style="text-align:right">Calls</th>
              <th style="text-align:right">Tokens</th>
              <th style="text-align:right">Reasoning</th>
              <th style="text-align:right">Cost</th>
            </tr></thead>
            <tbody><tr><td colspan="5" class="empty">Loading…</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="card" style="margin-top:12px">
      <div class="card-h">
        <i data-lucide="tag"></i>
        <span class="card-title">By Role (live pipeline)</span>
        <span class="card-badge" id="pByRoleBadge">—</span>
      </div>
      <div class="card-body flush" style="max-height:280px;overflow:auto">
        <table class="tbl" id="pByRoleTable">
          <thead><tr>
            <th>Role</th>
            <th style="text-align:right">Calls</th>
            <th style="text-align:right">Tokens</th>
            <th style="text-align:right">Reasoning</th>
            <th style="text-align:right">Cost</th>
          </tr></thead>
          <tbody><tr><td colspan="5" class="empty">Loading…</td></tr></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ═══ TAB: LOGS ═══ -->
  <section class="tab-panel" id="tab-logs">
    <div class="filter-bar">
      <div class="input-wrap" style="position:relative;flex:1;max-width:340px">
        <input type="text" class="input mono" id="logSearch" placeholder="Filter log…">
      </div>
      <div class="chips" id="logChips">
        <button class="chip active" data-lv="all">All</button>
        <button class="chip" data-lv="INFO">Info</button>
        <button class="chip" data-lv="WARNING">Warning</button>
        <button class="chip" data-lv="ERROR">Error</button>
        <button class="chip" data-lv="DEBUG">Debug</button>
      </div>
      <label style="display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text-3);cursor:pointer;">
        <input type="checkbox" id="logFollow" checked>
        Follow tail
      </label>
      <span style="margin-left:auto;font-size:11px;color:var(--text-3);font-family:'JetBrains Mono',monospace;" id="logCount">—</span>
    </div>

    <div class="card">
      <div class="card-body flush">
        <div class="log-full" id="logFull">
          <div class="empty" style="padding:20px">Loading…</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TAB: TOOLS ═══ -->
  <section class="tab-panel" id="tab-tools">
    <div id="toolResults"></div>

    <div class="tools-groups">

      <div class="tools-group">
        <div class="tools-group-h">
          <i data-lucide="git-branch"></i>
          <span>Pipeline</span>
        </div>
        <div class="tools-list">
          <div class="tool-item" onclick="onTool(this, 'scan-queue')">
            <div class="tool-icon"><i data-lucide="search"></i></div>
            <div class="tool-info">
              <div class="tool-name">Scan Queue <span class="tool-cost free">Free</span></div>
              <div class="tool-desc">Re-scan index.html → queue.jsonl. Finds new topics.</div>
            </div>
          </div>
          <div class="tool-item" onclick="onTool(this, 'pipeline-stats')">
            <div class="tool-icon"><i data-lucide="bar-chart-3"></i></div>
            <div class="tool-info">
              <div class="tool-name">Stats <span class="tool-cost free">Free</span></div>
              <div class="tool-desc">Full stats: queue, done, error, budget, cost.</div>
            </div>
          </div>
          <div class="tool-item" onclick="onTool(this, 'pipeline-report')">
